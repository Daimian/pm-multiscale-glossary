    <!-- https://w3id.org/emmo/domain/pm-multiscale#BondedMagnet -->


    <owl:Class rdf:about="https://w3id.org/emmo/domain/pm-multiscale#BondedMagnet">
        <rdfs:subClassOf rdf:resource="https://w3id.org/emmo/domain/magnetic-material#BulkMagnet"/>
        <rdfs:comment xml:lang="en">A bonded magnet is a composite permanent magnet form (powder in polymer/metallic binder) directly relevant to pm-multiscale simulation targets; it is a distinct subtype of magmo:BulkMagnet not currently represented as a named class in the ontology.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/domain/pm-multiscale"/>
        <rdfs:label>bonded magnet</rdfs:label>
        <skos:prefLabel xml:lang="en">bonded magnet</skos:prefLabel>
    </owl:Class>
    


