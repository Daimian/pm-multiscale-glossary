:Nanocrystallinemicrostructure rdf:type owl:Class ;
                               rdfs:subClassOf [ rdf:type owl:Restriction ;
                                                 owl:onProperty :hasScaleLevel ;
                                                 owl:hasValue :Mesoscopicscale
                                               ] .


###  https://w3id.org/emmo/domain/pm-multiscale#Nd2fe14b
:Nd2fe14b rdf:type owl:Class ;
          rdfs:subClassOf <http://org.semanticweb.owlapi/error#Error2> ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty :hasProperty ;
                            owl:someValuesFrom :MagnetocrystallineAnisotropyConstantK3
                          ] .


###  https://w3id.org/emmo/domain/pm-multiscale#NdFeB
:NdFeB rdf:type owl:Class ;
       rdfs:subClassOf :HardMagnet ,
                       [ rdf:type owl:Restriction ;
                         owl:onProperty :hasPart ;
                         owl:someValuesFrom <https://w3id.org/emmo/domain/magnetic-material#GrainBoundaryPhase>
                       ] ,
                       [ rdf:type owl:Restriction ;
                         owl:onProperty :hasProperty ;
                         owl:someValuesFrom :CurieTemperature
                       ] ;
       rdfs:comment "Neodymium-iron-boron (Nd2Fe14B) and its variants (with Dy, Tb substitution). Highest room-temperature BHmax (~400 kJ/m3) among all permanent magnets."@en ;
       rdfs:label "NdFeB" ;
       <http://www.w3.org/2004/02/skos/core#prefLabel> "NdFeB"@en .


###  https://w3id.org/emmo/domain/pm-multiscale#NoncollinearCalculation
:NoncollinearCalculation rdf:type owl:Class ;
                         rdfs:subClassOf <https://w3id.org/emmo#Computation> ;
                         rdfs:comment "Noncollinear calculation is a DFT computational configuration that allows arbitrary spin orientations, required for accurate magnetocrystalline anisotropy computation in permanent magnets; it is a sub-method of pm:DFTStep not currently represented as a distinct class, warranting a new subclass under emmo:Computation."@en ;
                         rdfs:isDefinedBy <https://w3id.org/emmo/domain/pm-multiscale> ;
                         rdfs:label "noncollinear calculation" ;
                         <http://www.w3.org/2004/02/skos/core#note> "What is a noncollinear calculation used for? — required for accurate computation of magnetic anisotropy energy"@en ;
                         <http://www.w3.org/2004/02/skos/core#prefLabel> "noncollinear calculation"@en .


###  https://w3id.org/emmo/domain/pm-multiscale#Noncollinearmagneticcalculation
:Noncollinearmagneticcalculation rdf:type owl:Class ;
                                 rdfs:subClassOf [ rdf:type owl:Restriction ;
                                                   owl:onProperty :hasScaleLevel ;
                                                   owl:hasValue :Electronicscale
                                                 ] .


###  https://w3id.org/emmo/domain/pm-multiscale#Noncollinearspincalculation
:Noncollinearspincalculation rdf:type owl:Class ;
                             rdfs:subClassOf [ rdf:type owl:Restriction ;
                                               owl:onProperty :hasScaleLevel ;
                                               owl:hasValue :Electronicscale
                                             ] .


###  https://w3id.org/emmo/domain/pm-multiscale#Onetofivephase
:Onetofivephase rdf:type owl:Class ;
                rdfs:subClassOf [ rdf:type owl:Restriction ;
                                  owl:onProperty :hasProperty ;
                                  owl:someValuesFrom <https://w3id.org/emmo/domain/magnetic-material#MagnetocrystallineAnisotropy>
                                ] .


###  https://w3id.org/emmo/domain/pm-multiscale#Orbitalmagnetization
:Orbitalmagnetization rdf:type owl:Class ;
                      rdfs:subClassOf [ rdf:type owl:Restriction ;
                                        owl:onProperty :hasScaleLevel ;
                                        owl:hasValue :Electronicscale
                                      ] .


###  https://w3id.org/emmo/domain/pm-multiscale#Organicsemiconductorlayer
:Organicsemiconductorlayer rdf:type owl:Class ;
                           rdfs:subClassOf <http://org.semanticweb.owlapi/error#Error3> .


###  https://w3id.org/emmo/domain/pm-multiscale#ParameterHandoff
:ParameterHandoff rdf:type owl:Class ;
                  rdfs:subClassOf [ rdf:type owl:Restriction ;
                                    owl:onProperty :transfersParameter ;
                                    owl:minCardinality "1"^^xsd:nonNegativeInteger
                                  ] ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty :fromStep ;
                                    owl:cardinality "1"^^xsd:nonNegativeInteger
                                  ] ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty :toStep ;
                                    owl:cardinality "1"^^xsd:nonNegativeInteger
                                  ] ;
                  rdfs:comment "The transfer of computed parameter values from an upstream simulation step to a downstream step. Example: DFT-computed exchange integrals (Jij) passed to spin dynamics as Heisenberg Hamiltonian input."@en ;
                  rdfs:label "ParameterHandoff" ;
                  <http://www.w3.org/2004/02/skos/core#prefLabel> "ParameterHandoff"@en .


###  https://w3id.org/emmo/domain/pm-multiscale#PermanentMagnetMaterial
:PermanentMagnetMaterial rdf:type owl:Class ;
                         rdfs:subClassOf <https://w3id.org/emmo/domain/magnetic-material#MagneticMaterial> ,
                                         [ rdf:type owl:Restriction ;
                                           owl:onProperty :hasProperty ;
                                           owl:someValuesFrom <https://w3id.org/emmo/domain/magnetic-material#AnisotropyField>
                                         ] ,
                                         [ rdf:type owl:Restriction ;
                                           owl:onProperty :hasProperty ;
                                           owl:someValuesFrom <https://w3id.org/emmo/domain/magnetic-material#CoercivityHc>
                                         ] ,
                                         [ rdf:type owl:Restriction ;
                                           owl:onProperty :hasProperty ;
                                           owl:someValuesFrom <https://w3id.org/emmo/domain/magnetic-material#ExchangeStiffnessConstant>
                                         ] ,
                                         [ rdf:type owl:Restriction ;
                                           owl:onProperty :hasProperty ;
                                           owl:someValuesFrom <https://w3id.org/emmo/domain/magnetic-material#MagnetocrystallineAnisotropyConstantK1>
                                         ] ,
                                         [ rdf:type owl:Restriction ;
                                           owl:onProperty :hasProperty ;
                                           owl:someValuesFrom <https://w3id.org/emmo/domain/magnetic-material#MaximumEnergyProduct>
                                         ] ,
                                         [ rdf:type owl:Restriction ;
                                           owl:onProperty :hasProperty ;
                                           owl:someValuesFrom <https://w3id.org/emmo/domain/magnetic-material#Remanence>
                                         ] ,
                                         [ rdf:type owl:Restriction ;
                                           owl:onProperty :hasProperty ;
                                           owl:someValuesFrom <https://w3id.org/emmo/domain/magnetic-material#SaturationMagnetization>
                                         ] ,
                                         [ rdf:type owl:Restriction ;
                                           owl:onProperty :hasProperty ;
                                           owl:someValuesFrom :CurieTemperature
                                         ] ;
                         owl:disjointWith :SoftMagnet ;
                         rdfs:comment "A magnetic material that retains magnetization after removal of an external field, characterized by high coercivity and remanence. Subclass of MagMO MagneticMaterial."@en ;
                         rdfs:label "PermanentMagnetMaterial" ;
                         <http://www.w3.org/2004/02/skos/core#altLabel> "exchange-coupled nanocomposite permanent magnet"@en ,
                                                                        "exchange-spring permanent magnet"@en ,
                                                                        "spring exchange magnet"@en ;
                         <http://www.w3.org/2004/02/skos/core#prefLabel> "PermanentMagnetMaterial"@en .


###  https://w3id.org/emmo/domain/pm-multiscale#Phase217
:Phase217 rdf:type owl:Class ;
          rdfs:subClassOf [ rdf:type owl:Restriction ;
                            owl:onProperty :hasProperty ;
                            owl:someValuesFrom <https://w3id.org/emmo/domain/magnetic-material#MagnetocrystallineAnisotropy>
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty :hasProperty ;
                            owl:someValuesFrom <https://w3id.org/emmo/domain/magnetic-material#SaturationMagnetization>
                          ] .


###  https://w3id.org/emmo/domain/pm-multiscale#PreisachModel
:PreisachModel rdf:type owl:Class ;
               rdfs:subClassOf <https://w3id.org/emmo#MaterialsModel> ;
               rdfs:comment "The Preisach model is a classical phenomenological hysteresis model based on bistable magnetic units with a distribution function, used to describe macroscopic hysteresis loops in permanent magnets; it is an emmo:MaterialsModel at the continuum/phenomenological level, and no existing pm: class represents hysteresis distribution models."@en ;
               rdfs:isDefinedBy <https://w3id.org/emmo/domain/pm-multiscale> ;
               rdfs:label "preisach model" ;
               <http://www.w3.org/2004/02/skos/core#note> "What is the Preisach model used for? — A classical model of hysteresis based on bistable magnetic units with a fixed distribution function"@en ;
               <http://www.w3.org/2004/02/skos/core#prefLabel> "preisach model"@en .


###  https://w3id.org/emmo/domain/pm-multiscale#PropertyDetermination
:PropertyDetermination rdf:type owl:Class ;
                       owl:equivalentClass [ rdf:type owl:Class ;
                                             owl:unionOf ( :ComputationalDetermination
                                                           :ExperimentalDetermination
                                                         )
                                           ] ;
                       rdfs:comment "How a property value was obtained: computationally (DFT, micromagnetics, ML) or experimentally (VSM, SQUID, PPMS)."@en ;
                       rdfs:label "PropertyDetermination" ;
                       <http://www.w3.org/2004/02/skos/core#prefLabel> "PropertyDetermination"@en .


###  https://w3id.org/emmo/domain/pm-multiscale#PropertyPrediction
:PropertyPrediction rdf:type owl:Class ;
                    rdfs:subClassOf [ rdf:type owl:Restriction ;
                                      owl:onProperty :fromInputProperty ;
                                      owl:minCardinality "1"^^xsd:nonNegativeInteger
                                    ] ,
                                    [ rdf:type owl:Restriction ;
                                      owl:onProperty :predictsProperty ;
                                      owl:minCardinality "1"^^xsd:nonNegativeInteger
                                    ] ;
                    rdfs:comment "A machine-learning prediction of extrinsic magnetic properties (Hc, Mr, BHmax) from intrinsic parameters (Ms, A, K1). Example: mammos-ai Random Forest models."@en ;
                    rdfs:label "PropertyPrediction" ;
                    <http://www.w3.org/2004/02/skos/core#prefLabel> "PropertyPrediction"@en .


###  https://w3id.org/emmo/domain/pm-multiscale#PropertySource
:PropertySource rdf:type owl:Class ;
                owl:equivalentClass [ rdf:type owl:Class ;
                                      owl:unionOf ( :FigureSource
                                                    :TableSource
                                                    :TextSource
                                                  )
                                    ] ;
                rdfs:comment "Where in a publication a property value is found: running text, a table cell, or extracted from a figure."@en ;
                rdfs:label "PropertySource" ;
                <http://www.w3.org/2004/02/skos/core#prefLabel> "PropertySource"@en .


###  https://w3id.org/emmo/domain/pm-multiscale#PropertySynonym
:PropertySynonym rdf:type owl:Class ;
                 rdfs:comment "An alternative name or symbol for a magnetic property used in the literature. Example: coercivity appears as Hc, Hci, iHc, jHc, or BHc."@en ;
                 rdfs:label "PropertySynonym" ;
                 <http://www.w3.org/2004/02/skos/core#prefLabel> "PropertySynonym"@en .


###  https://w3id.org/emmo/domain/pm-multiscale#RandomAnisotropyModel
:RandomAnisotropyModel rdf:type owl:Class ;
                       rdfs:subClassOf <https://w3id.org/emmo#ContinuumModel> ;
                       rdfs:comment "The random anisotropy model is a continuum-level theoretical framework describing how spatially disordered anisotropy axes are averaged by exchange interactions in nanocrystalline magnets; it fits emmo:ContinuumModel because it operates at the mesoscale/continuum level, and no existing pm: class captures this microstructural averaging model."@en ;
                       rdfs:isDefinedBy <https://w3id.org/emmo/domain/pm-multiscale> ;
                       rdfs:label "random anisotropy model" ;
                       <http://www.w3.org/2004/02/skos/core#prefLabel> "random anisotropy model"@en .


###  https://w3id.org/emmo/domain/pm-multiscale#Randomanisotropymodel
:Randomanisotropymodel rdf:type owl:Class ;
                       rdfs:subClassOf [ rdf:type owl:Restriction ;
                                         owl:onProperty :hasScaleLevel ;
                                         owl:hasValue :Mesoscopicscale
                                       ] .


###  https://w3id.org/emmo/domain/pm-multiscale#Rareearthsite
:Rareearthsite rdf:type owl:Class ;
               rdfs:subClassOf [ rdf:type owl:Restriction ;
                                 owl:onProperty :hasProperty ;
                                 owl:someValuesFrom :SingleIonAnisotropyEnergy
                               ] .


###  https://w3id.org/emmo/domain/pm-multiscale#RemanenceEnhancement
:RemanenceEnhancement rdf:type owl:Class ;
                      rdfs:subClassOf <https://w3id.org/emmo/domain/magnetic-material#Remanence> ;
                      rdfs:comment "Remanence enhancement is a distinct phenomenon (exchange-coupling-driven increase above Stoner-Wohlfarth limit) not captured by magmo:Remanence alone; a new subclass under magmo:Remanence is needed per the ontological gap criterion."@en ;
                      rdfs:isDefinedBy <https://w3id.org/emmo/domain/pm-multiscale> ;
                      rdfs:label "remanence enhancement" ;
                      <http://www.w3.org/2004/02/skos/core#prefLabel> "remanence enhancement"@en .


###  https://w3id.org/emmo/domain/pm-multiscale#ReportedPropertyValue
:ReportedPropertyValue rdf:type owl:Class ;
                       rdfs:subClassOf [ rdf:type owl:Restriction ;
                                         owl:onProperty :forMaterial ;
                                         owl:cardinality "1"^^xsd:nonNegativeInteger
                                       ] ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty :forProperty ;
                                         owl:cardinality "1"^^xsd:nonNegativeInteger
                                       ] ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty :reportedInPublication ;
                                         owl:cardinality "1"^^xsd:nonNegativeInteger
                                       ] ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty :numericValue ;
                                         owl:cardinality "1"^^xsd:nonNegativeInteger
                                       ] ;
                       rdfs:comment "A specific magnetic property value as reported in a paper, with its context: material, method, temperature, unit, and location in the paper."@en ;
                       rdfs:label "ReportedPropertyValue" ;
                       <http://www.w3.org/2004/02/skos/core#prefLabel> "ReportedPropertyValue"@en .


###  https://w3id.org/emmo/domain/pm-multiscale#ReproducibilityAssessment
:ReproducibilityAssessment rdf:type owl:Class ;
                           rdfs:subClassOf [ rdf:type owl:Restriction ;
                                             owl:onProperty :reproducibilityScore ;
                                             owl:cardinality "1"^^xsd:nonNegativeInteger
                                           ] ;
                           rdfs:comment "An evaluation of whether a paper reports sufficient parameters to reproduce its computational results. Score 0-1 based on completeness of inputs."@en ;
                           rdfs:label "ReproducibilityAssessment" ;
                           <http://www.w3.org/2004/02/skos/core#prefLabel> "ReproducibilityAssessment"@en .


###  https://w3id.org/emmo/domain/pm-multiscale#ResearchGroup
:ResearchGroup rdf:type owl:Class ;
               rdfs:comment "The research group or institution that performed the study. Enables tracking which groups produce comparable results."@en ;
               rdfs:label "ResearchGroup" ;
               <http://www.w3.org/2004/02/skos/core#prefLabel> "ResearchGroup"@en .


###  https://w3id.org/emmo/domain/pm-multiscale#ScaleBridgingAssumption
:ScaleBridgingAssumption rdf:type owl:Class ;
                         rdfs:comment "A physical assumption that justifies mapping parameters between scales. Example: mean-field approximation connecting DFT exchange integrals to the atomistic Heisenberg Hamiltonian."@en ;
                         rdfs:label "ScaleBridgingAssumption" ;
                         <http://www.w3.org/2004/02/skos/core#prefLabel> "ScaleBridgingAssumption"@en .


###  https://w3id.org/emmo/domain/pm-multiscale#ScaleLevel
:ScaleLevel rdf:type owl:Class ;
            rdfs:comment "The characteristic spatial and temporal scale at which a simulation operates: electronic (angstrom/femtosecond), atomistic (nanometer/picosecond), or mesoscopic (micrometer/nanosecond)."@en ;
            rdfs:label "ScaleLevel" ;
            <http://www.w3.org/2004/02/skos/core#prefLabel> "ScaleLevel"@en .


###  https://w3id.org/emmo/domain/pm-multiscale#ScientificPublication
:ScientificPublication rdf:type owl:Class ;
                       rdfs:subClassOf [ rdf:type owl:Restriction ;
                                         owl:onProperty :doi ;
                                         owl:cardinality "1"^^xsd:nonNegativeInteger
                                       ] ;
                       rdfs:comment "A published paper reporting computational or experimental results on magnetic materials. Identified by DOI."@en ;
                       rdfs:label "ScientificPublication" ;
                       <http://www.w3.org/2004/02/skos/core#prefLabel> "ScientificPublication"@en .


###  https://w3id.org/emmo/domain/pm-multiscale#Secondvariationalapproach
:Secondvariationalapproach rdf:type owl:Class ;
                           rdfs:subClassOf [ rdf:type owl:Restriction ;
                                             owl:onProperty :hasScaleLevel ;
                                             owl:hasValue :Electronicscale
                                           ] .


###  https://w3id.org/emmo/domain/pm-multiscale#Selfconsistentfieldcalculation
:Selfconsistentfieldcalculation rdf:type owl:Class ;
                                rdfs:subClassOf [ rdf:type owl:Restriction ;
                                                  owl:onProperty :hasScaleLevel ;
                                                  owl:hasValue :Electronicscale
                                                ] .


###  https://w3id.org/emmo/domain/pm-multiscale#SimulationApproximation
:SimulationApproximation rdf:type owl:Class ;
                         rdfs:comment "A simplification used in a paper's calculation: coherent rotation, single-domain approximation, neglect of thermal fluctuations, collinear spin assumption."@en ;
                         rdfs:label "SimulationApproximation" ;
                         <http://www.w3.org/2004/02/skos/core#altLabel> "coherent-potential approximation"@en ;
                         <http://www.w3.org/2004/02/skos/core#prefLabel> "SimulationApproximation"@en .


###  https://w3id.org/emmo/domain/pm-multiscale#SimulationConfiguration
:SimulationConfiguration rdf:type owl:Class ;
                         rdfs:comment "The complete set of computational settings for a simulation step: software version, numerical parameters, boundary conditions, and convergence criteria."@en ;
                         rdfs:label "SimulationConfiguration" ;
                         <http://www.w3.org/2004/02/skos/core#prefLabel> "SimulationConfiguration"@en .


###  https://w3id.org/emmo/domain/pm-multiscale#SimulationStep
:SimulationStep rdf:type owl:Class ;
                rdfs:subClassOf <https://w3id.org/emmo#EMMO_4299e344_a321_4ef2_a744_bacfcce80afc> ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty :hasScaleLevel ;
                                  owl:cardinality "1"^^xsd:nonNegativeInteger
                                ] ;
                rdfs:comment "A single computational step in a multi-scale workflow, operating at a specific scale. Examples: a VASP DFT run, an UppASD temperature sweep, an esys-escript hysteresis loop calculation."@en ;
                rdfs:label "SimulationStep" ;
                <http://www.w3.org/2004/02/skos/core#altLabel> "monte carlo step"@en ,
                                                               "monte carlo steps"@en ;
                <http://www.w3.org/2004/02/skos/core#prefLabel> "SimulationStep"@en .


###  https://w3id.org/emmo/domain/pm-multiscale#SingleIonAnisotropyEnergy
:SingleIonAnisotropyEnergy rdf:type owl:Class ;
                           rdfs:subClassOf <https://w3id.org/emmo/domain/magnetic-material#MagnetocrystallineAnisotropyEnergy> ;
                           rdfs:comment "Single-ion anisotropy energy is the site-resolved classical anisotropy energy at a rare-earth site computed from crystal-field and Stevens coefficients; it is a precursor to the macroscopic magmo:MagnetocrystallineAnisotropyEnergy but operates at the single-ion scale not currently represented, requiring a new subclass."@en ;
                           rdfs:isDefinedBy <https://w3id.org/emmo/domain/pm-multiscale> ;
                           rdfs:label "single-ion anisotropy energy" ;
                           <http://www.w3.org/2004/02/skos/core#prefLabel> "single-ion anisotropy energy"@en .


###  https://w3id.org/emmo/domain/pm-multiscale#Singleionanisotropyenergy
:Singleionanisotropyenergy rdf:type owl:Class ;
                           rdfs:subClassOf [ rdf:type owl:Restriction ;
                                             owl:onProperty :hasScaleLevel ;
                                             owl:hasValue :Atomisticscale
                                           ] .


###  https://w3id.org/emmo/domain/pm-multiscale#SoftMagnet
:SoftMagnet rdf:type owl:Class ;
            rdfs:subClassOf <https://w3id.org/emmo/domain/magnetic-material#MagneticMaterial> ;
            rdfs:comment "A magnetic material with low coercivity, easily magnetized and demagnetized. Used in transformers, inductors, and electromagnetic shielding. Disjoint with HardMagnet."@en ;
            rdfs:label "SoftMagnet" ;
            <http://www.w3.org/2004/02/skos/core#prefLabel> "SoftMagnet"@en .


###  https://w3id.org/emmo/domain/pm-multiscale#SolverAlgorithm
:SolverAlgorithm rdf:type owl:Class ;
                 rdfs:comment "The numerical algorithm used to solve governing equations: conjugate gradient, Runge-Kutta, implicit Euler, etc."@en ;
                 rdfs:label "SolverAlgorithm" ;
                 <http://www.w3.org/2004/02/skos/core#prefLabel> "SolverAlgorithm"@en .


###  https://w3id.org/emmo/domain/pm-multiscale#SpinDynamicsConfiguration
:SpinDynamicsConfiguration rdf:type owl:Class ;
                           rdfs:subClassOf :SimulationConfiguration ;
                           rdfs:comment "Configuration for atomistic spin dynamics: simulation temperature range, Gilbert damping parameter, time step, and number of Monte Carlo / Langevin dynamics steps."@en ;
                           rdfs:label "SpinDynamicsConfiguration" ;
                           <http://www.w3.org/2004/02/skos/core#altLabel> "damping parameter"@en ,
                                                                          "gilbert damping"@en ,
                                                                          "heisenberg spin hamiltonian"@en ,
                                                                          "heisenberg spin model"@en ,
                                                                          "spin hamiltonian"@en ,
                                                                          "spin heisenberg hamiltonian"@en ,
                                                                          "stochastic landau-lifshitz equation"@en ;
                           <http://www.w3.org/2004/02/skos/core#prefLabel> "SpinDynamicsConfiguration"@en .


###  https://w3id.org/emmo/domain/pm-multiscale#SpinDynamicsStep
:SpinDynamicsStep rdf:type owl:Class ;
                  rdfs:subClassOf :SimulationStep ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty :hasOutputParameter ;
                                    owl:someValuesFrom :CurieTemperature
                                  ] ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty :hasConfiguration ;
                                    owl:allValuesFrom :SpinDynamicsConfiguration
                                  ] ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty :hasScaleLevel ;
                                    owl:hasValue :AtomisticScale
                                  ] ;
                  rdfs:comment "An atomistic spin dynamics simulation (e.g., UppASD) that computes temperature-dependent magnetic properties: magnetization M(T), Curie temperature Tc, and temperature-dependent anisotropy K(T)."@en ;
                  rdfs:label "SpinDynamicsStep" ;
                  <http://www.w3.org/2004/02/skos/core#altLabel> "stochastic landau-lifshitz-gilbert"@en ;
                  <http://www.w3.org/2004/02/skos/core#prefLabel> "SpinDynamicsStep"@en .


###  https://w3id.org/emmo/domain/pm-multiscale#Spinhamiltonian
:Spinhamiltonian rdf:type owl:Class ;
                 rdfs:subClassOf [ rdf:type owl:Restriction ;
                                   owl:onProperty :hasScaleLevel ;
                                   owl:hasValue :Atomisticscale
                                 ] .


###  https://w3id.org/emmo/domain/pm-multiscale#Spinheisenberghamiltonian
:Spinheisenberghamiltonian rdf:type owl:Class ;
                           rdfs:subClassOf [ rdf:type owl:Restriction ;
                                             owl:onProperty :hasScaleLevel ;
                                             owl:hasValue :Atomisticscale
                                           ] .


###  https://w3id.org/emmo/domain/pm-multiscale#Spinmagnetization
:Spinmagnetization rdf:type owl:Class ;
                   rdfs:subClassOf [ rdf:type owl:Restriction ;
                                     owl:onProperty :hasScaleLevel ;
                                     owl:hasValue :Electronicscale
                                   ] .


###  https://w3id.org/emmo/domain/pm-multiscale#Spinwavestiffnessconstant
:Spinwavestiffnessconstant rdf:type owl:Class ;
                           rdfs:subClassOf [ rdf:type owl:Restriction ;
                                             owl:onProperty :hasScaleLevel ;
                                             owl:hasValue :Atomisticscale
                                           ] .


###  https://w3id.org/emmo/domain/pm-multiscale#Stabilizationenergy
:Stabilizationenergy rdf:type owl:Class ;
                     rdfs:subClassOf [ rdf:type owl:Restriction ;
                                       owl:onProperty :hasScaleLevel ;
                                       owl:hasValue :Atomisticscale
                                     ] .


###  https://w3id.org/emmo/domain/pm-multiscale#StepStatus
:StepStatus rdf:type owl:Class ;
            owl:equivalentClass [ rdf:type owl:Class ;
                                  owl:oneOf ( :Converged
                                              :Failed
                                              :Running
                                            )
                                ] ;
            rdfs:comment "The execution status of a simulation step: Converged (completed successfully), Failed (did not converge or crashed), or Running (in progress)."@en ;
            rdfs:label "StepStatus" ;
            <http://www.w3.org/2004/02/skos/core#prefLabel> "StepStatus"@en .


###  https://w3id.org/emmo/domain/pm-multiscale#StochasticLandauLifshitzGilbertEquation
:StochasticLandauLifshitzGilbertEquation rdf:type owl:Class ;
                                         rdfs:subClassOf <https://w3id.org/emmo#AtomisticModel> .


###  https://w3id.org/emmo/domain/pm-multiscale#Stochasticlandaulifshitzequation
:Stochasticlandaulifshitzequation rdf:type owl:Class ;
                                  rdfs:subClassOf [ rdf:type owl:Restriction ;
                                                    owl:onProperty :hasScaleLevel ;
                                                    owl:hasValue :Atomisticscale
                                                  ] .


###  https://w3id.org/emmo/domain/pm-multiscale#Stochasticlandaulifshitzgilbert
:Stochasticlandaulifshitzgilbert rdf:type owl:Class ;
                                 rdfs:subClassOf [ rdf:type owl:Restriction ;
                                                   owl:onProperty :hasScaleLevel ;
                                                   owl:hasValue :Atomisticscale
                                                 ] .


###  https://w3id.org/emmo/domain/pm-multiscale#Stochasticlandaulifshitzgilbertequation
:Stochasticlandaulifshitzgilbertequation rdf:type owl:Class ;
                                         rdfs:subClassOf [ rdf:type owl:Restriction ;
                                                           owl:onProperty :hasScaleLevel ;
                                                           owl:hasValue :Atomisticscale
                                                         ] ,
                                                         [ rdf:type owl:Restriction ;
                                                           owl:onProperty :hasScaleLevel ;
                                                           owl:hasValue :Mesoscopicscale
                                                         ] .


###  https://w3id.org/emmo/domain/pm-multiscale#Structuralrelaxation
:Structuralrelaxation rdf:type owl:Class ;
                      rdfs:subClassOf [ rdf:type owl:Restriction ;
                                        owl:onProperty :hasScaleLevel ;
                                        owl:hasValue :Electronicscale
                                      ] .


###  https://w3id.org/emmo/domain/pm-multiscale#Superparamagneticbehavior
:Superparamagneticbehavior rdf:type owl:Class ;
                           rdfs:subClassOf [ rdf:type owl:Restriction ;
                                             owl:onProperty :hasScaleLevel ;
                                             owl:hasValue :Mesoscopicscale
                                           ] .


###  https://w3id.org/emmo/domain/pm-multiscale#TableSource
:TableSource rdf:type owl:Class ;
             rdfs:subClassOf :PropertySource ;
             rdfs:comment "A property value extracted from a table in a publication."@en ;
             rdfs:label "TableSource" ;
             <http://www.w3.org/2004/02/skos/core#prefLabel> "TableSource"@en .


###  https://w3id.org/emmo/domain/pm-multiscale#TemperatureDependentProperty
:TemperatureDependentProperty rdf:type owl:Class ;
                              rdfs:subClassOf [ rdf:type owl:Restriction ;
                                                owl:onProperty :atTemperature ;
                                                owl:cardinality "1"^^xsd:nonNegativeInteger
                                              ] ;
                              rdfs:comment "A magnetic property value reported or computed at a specific temperature. Essential for comparing values across studies that use different measurement/simulation temperatures."@en ;
                              rdfs:label "TemperatureDependentProperty" ;
                              <http://www.w3.org/2004/02/skos/core#prefLabel> "TemperatureDependentProperty"@en .


###  https://w3id.org/emmo/domain/pm-multiscale#Tetrataenite
:Tetrataenite rdf:type owl:Class ;
              rdfs:subClassOf <https://w3id.org/emmo/domain/magnetic-material#CrystallineMagneticMaterial> ,
                              [ rdf:type owl:Restriction ;
                                owl:onProperty :hasProperty ;
                                owl:someValuesFrom <https://w3id.org/emmo/domain/magnetic-material#MagnetocrystallineAnisotropyConstantK1>
                              ] ;
              rdfs:comment "Tetrataenite (L1₀-ordered FeNi) is a distinct crystalline magnetic phase considered a gap permanent magnet candidate; it is not expressible by any existing class in the 3-tier ontology and requires a new class under magmo:CrystallineMagneticMaterial."@en ;
              rdfs:isDefinedBy <https://w3id.org/emmo/domain/pm-multiscale> ;
              rdfs:label "tetrataenite" ;
              <http://www.w3.org/2004/02/skos/core#note> "What is tetrataenite used for? — considered a candidate gap permanent magnet material"@en ;
              <http://www.w3.org/2004/02/skos/core#prefLabel> "tetrataenite"@en .


###  https://w3id.org/emmo/domain/pm-multiscale#TextSource
:TextSource rdf:type owl:Class ;
            rdfs:subClassOf :PropertySource ;
            rdfs:comment "A property value extracted from running text in a publication."@en ;
            rdfs:label "TextSource" ;
            <http://www.w3.org/2004/02/skos/core#prefLabel> "TextSource"@en .


###  https://w3id.org/emmo/domain/pm-multiscale#TheoreticalEnergyProductLimit
:TheoreticalEnergyProductLimit rdf:type owl:Class ;
                               rdfs:subClassOf <https://w3id.org/emmo/domain/magnetic-material#MaximumEnergyProduct> ;
                               rdfs:comment "Theoretical energy product limit is a derived upper-bound quantity distinct from the measured magmo:MaximumEnergyProduct; it requires a new subclass under magmo:MaximumEnergyProduct to represent the theoretically computed ceiling value assuming ideal microstructure."@en ;
                               rdfs:isDefinedBy <https://w3id.org/emmo/domain/pm-multiscale> ;
                               rdfs:label "theoretical energy product limit" ;
                               <http://www.w3.org/2004/02/skos/core#prefLabel> "theoretical energy product limit"@en .


###  https://w3id.org/emmo/domain/pm-multiscale#TwistGrainBoundary
:TwistGrainBoundary rdf:type owl:Class ;
                    rdfs:subClassOf <https://w3id.org/emmo/domain/magnetic-material#GrainBoundaryPhase> ;
                    rdfs:comment "A twist grain boundary (basal-plane boundary between c-axis aligned grains, weak pinning centre) is a rigid, sortal subtype of grain boundary not captured by any existing magmo: annotation on magmo:GrainBoundaryPhase; a new subclass is required to distinguish it from tilt and general grain boundaries."@en ;
                    rdfs:isDefinedBy <https://w3id.org/emmo/domain/pm-multiscale> ;
                    rdfs:label "twist grain boundary" ;
                    <http://www.w3.org/2004/02/skos/core#prefLabel> "twist grain boundary"@en .


###  https://w3id.org/emmo/domain/pm-multiscale#TwoSublatticeMeanFieldModel
:TwoSublatticeMeanFieldModel rdf:type owl:Class ;
                             rdfs:subClassOf <https://w3id.org/emmo#AtomisticModel> .


###  https://w3id.org/emmo/domain/pm-multiscale#Twosublatticemicromagneticmodel
:Twosublatticemicromagneticmodel rdf:type owl:Class ;
                                 rdfs:subClassOf [ rdf:type owl:Restriction ;
                                                   owl:onProperty :hasScaleLevel ;
                                                   owl:hasValue :Mesoscopicscale
                                                 ] .


###  https://w3id.org/emmo/domain/pm-multiscale#UniaxialCrystalStructure
:UniaxialCrystalStructure rdf:type owl:Class ;
                          rdfs:subClassOf <https://w3id.org/emmo/domain/magnetic-material#CrystalStructure> ;
                          rdfs:comment "A uniaxial crystal structure is a specialisation of magmo:CrystalStructure distinguished by hexagonal/tetragonal/rhombohedral symmetry and a unique easy-axis; no existing class in the 3-tier ontology captures this symmetry-plus-anisotropy combination, so a new subclass under magmo:CrystalStructure is required."@en ;
                          rdfs:isDefinedBy <https://w3id.org/emmo/domain/pm-multiscale> ;
                          rdfs:label "uniaxial crystal structure" ;
                          <http://www.w3.org/2004/02/skos/core#prefLabel> "uniaxial crystal structure"@en .


###  https://w3id.org/emmo/domain/pm-multiscale#ZeemanEnergyDensity
:ZeemanEnergyDensity rdf:type owl:Class ;
                     rdfs:subClassOf <https://w3id.org/emmo/domain/magnetic-material#MagnetocrystallineAnisotropyEnergy> ;
                     rdfs:comment "Zeeman energy density is a distinct micromagnetic energy density term (-μ₀Ms·H) not expressible by any existing magmo: class; magmo:MagnetocrystallineAnisotropyEnergy is the closest structural analogue as a volumetric magnetic energy density, satisfying the GAP criterion for a new subclass in M3_Material."@en ;
                     rdfs:isDefinedBy <https://w3id.org/emmo/domain/pm-multiscale> ;
                     rdfs:label "zeeman energy density" ;
                     <http://www.w3.org/2004/02/skos/core#prefLabel> "zeeman energy density"@en .


###  https://w3id.org/emmo/domain/pm-multiscale#FixedSpinMoment(fsm)Calculation
<https://w3id.org/emmo/domain/pm-multiscale#FixedSpinMoment(fsm)Calculation> rdf:type owl:Class ;
                                                                             rdfs:subClassOf <https://w3id.org/emmo#Computation> ;
                                                                             rdfs:comment "Fixed spin moment (FSM) calculation is a constrained DFT method in which the total magnetic moment is fixed to study magnetisation-dependent properties of permanent magnets; it is a sub-method of pm:DFTStep not currently represented as a distinct class, warranting a new subclass under emmo:Computation."@en ;
                                                                             rdfs:isDefinedBy <https://w3id.org/emmo/domain/pm-multiscale> ;
                                                                             rdfs:label "fixed spin moment (fsm) calculation" ;
                                                                             <http://www.w3.org/2004/02/skos/core#note> "What is fixed spin moment calculation used for? — to study the dependence of magnetic properties on magnetization magnitude"@en ;
                                                                             <http://www.w3.org/2004/02/skos/core#prefLabel> "fixed spin moment (fsm) calculation"@en .


