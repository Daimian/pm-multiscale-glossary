    <!-- https://w3id.org/emmo/domain/pm-multiscale#ColumnarGrains -->


    <owl:Class rdf:about="https://w3id.org/emmo/domain/pm-multiscale#ColumnarGrains">
        <rdfs:subClassOf rdf:resource="https://w3id.org/emmo/domain/magnetic-material#Grain"/>
        <rdfs:comment xml:lang="en">Columnar grains are a rigid, sortal morphological subtype of magmo:Grain (elongated, film-perpendicular orientation) not distinguished by any existing magmo: annotation; they require a new subclass under magmo:Grain to capture their pinning-site role in thin-film PM microstructure.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/domain/pm-multiscale"/>
        <rdfs:label>columnar grains</rdfs:label>
        <skos:prefLabel xml:lang="en">columnar grains</skos:prefLabel>
    </owl:Class>
    


    <!-- https://w3id.org/emmo/domain/pm-multiscale#ComputationalDetermination -->


    <owl:Class rdf:about="https://w3id.org/emmo/domain/pm-multiscale#ComputationalDetermination">
        <rdfs:subClassOf rdf:resource="https://w3id.org/emmo/domain/pm-multiscale#PropertyDetermination"/>
        <owl:disjointWith rdf:resource="https://w3id.org/emmo/domain/pm-multiscale#ExperimentalDetermination"/>
        <rdfs:comment xml:lang="en">A property value obtained through computational simulation: DFT, spin dynamics, micromagnetics, or machine-learning prediction.</rdfs:comment>
        <rdfs:label>ComputationalDetermination</rdfs:label>
        <skos:prefLabel xml:lang="en">ComputationalDetermination</skos:prefLabel>
    </owl:Class>
    


    <!-- https://w3id.org/emmo/domain/pm-multiscale#ConvergenceCriterion -->


    <owl:Class rdf:about="https://w3id.org/emmo/domain/pm-multiscale#ConvergenceCriterion">
        <rdfs:comment xml:lang="en">The threshold for declaring a simulation converged: energy difference, force residual, or magnetization change between iterations.</rdfs:comment>
        <rdfs:label>ConvergenceCriterion</rdfs:label>
        <skos:prefLabel xml:lang="en">ConvergenceCriterion</skos:prefLabel>
    </owl:Class>
    


    <!-- https://w3id.org/emmo/domain/pm-multiscale#CrystalFieldCoefficient -->


    <owl:Class rdf:about="https://w3id.org/emmo/domain/pm-multiscale#CrystalFieldCoefficient">
        <rdfs:subClassOf rdf:resource="https://w3id.org/emmo/domain/magnetic-material#MagnetocrystallineAnisotropy"/>
        <rdfs:comment xml:lang="en">Crystal field coefficient A_lm&lt;r^l&gt; is an atomic-scale parameter used to compute magnetocrystalline anisotropy via Stevens operators; it is a sub-concept of the anisotropy hierarchy but not expressible by any existing magmo: class, requiring a new subclass under magmo:MagnetocrystallineAnisotropy.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/domain/pm-multiscale"/>
        <rdfs:label>crystal field coefficient</rdfs:label>
        <skos:note xml:lang="en">What is the crystal field coefficient used to compute? — used to compute magnetocrystalline anisotropy via Stevens operator formalism</skos:note>
        <skos:prefLabel xml:lang="en">crystal field coefficient</skos:prefLabel>
    </owl:Class>
    


    <!-- https://w3id.org/emmo/domain/pm-multiscale#CrystalFieldTheory -->


