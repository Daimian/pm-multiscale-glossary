    <!-- https://w3id.org/emmo/domain/pm-multiscale#AllenCahnEquation -->


    <owl:Class rdf:about="https://w3id.org/emmo/domain/pm-multiscale#AllenCahnEquation">
        <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#ContinuumModel"/>
        <rdfs:comment xml:lang="en">The Allen-Cahn equation is a continuum PDE governing order-parameter evolution for phase-field modeling, used here for rotor pole shape optimization in permanent magnet motor design; it is a canonical emmo:ContinuumModel (phase-field), and no existing pm: class covers phase-field continuum equations.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/domain/pm-multiscale"/>
        <rdfs:label>allen-cahn equation</rdfs:label>
        <skos:note xml:lang="en">What is the Allen-Cahn equation used for? — used here for rotor pole shape optimization</skos:note>
        <skos:prefLabel xml:lang="en">allen-cahn equation</skos:prefLabel>
    </owl:Class>
    


