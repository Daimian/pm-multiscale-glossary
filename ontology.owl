                <owl:onProperty rdf:resource="https://w3id.org/emmo/domain/pm-multiscale#hasScaleLevel"/>
                <owl:hasValue rdf:resource="https://w3id.org/emmo/domain/pm-multiscale#Atomisticscale"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- https://w3id.org/emmo/domain/pm-multiscale#Stochasticlandaulifshitzgilbertequation -->


    <owl:Class rdf:about="https://w3id.org/emmo/domain/pm-multiscale#Stochasticlandaulifshitzgilbertequation">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/emmo/domain/pm-multiscale#hasScaleLevel"/>
                <owl:hasValue rdf:resource="https://w3id.org/emmo/domain/pm-multiscale#Atomisticscale"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/emmo/domain/pm-multiscale#hasScaleLevel"/>
                <owl:hasValue rdf:resource="https://w3id.org/emmo/domain/pm-multiscale#Mesoscopicscale"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- https://w3id.org/emmo/domain/pm-multiscale#Structuralrelaxation -->


    <owl:Class rdf:about="https://w3id.org/emmo/domain/pm-multiscale#Structuralrelaxation">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/emmo/domain/pm-multiscale#hasScaleLevel"/>
                <owl:hasValue rdf:resource="https://w3id.org/emmo/domain/pm-multiscale#Electronicscale"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- https://w3id.org/emmo/domain/pm-multiscale#Superparamagneticbehavior -->


    <owl:Class rdf:about="https://w3id.org/emmo/domain/pm-multiscale#Superparamagneticbehavior">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/emmo/domain/pm-multiscale#hasScaleLevel"/>
                <owl:hasValue rdf:resource="https://w3id.org/emmo/domain/pm-multiscale#Mesoscopicscale"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- https://w3id.org/emmo/domain/pm-multiscale#TableSource -->


    <owl:Class rdf:about="https://w3id.org/emmo/domain/pm-multiscale#TableSource">
        <rdfs:subClassOf rdf:resource="https://w3id.org/emmo/domain/pm-multiscale#PropertySource"/>
        <rdfs:comment xml:lang="en">A property value extracted from a table in a publication.</rdfs:comment>
        <rdfs:label>TableSource</rdfs:label>
        <skos:prefLabel xml:lang="en">TableSource</skos:prefLabel>
    </owl:Class>
    


    <!-- https://w3id.org/emmo/domain/pm-multiscale#TemperatureDependentProperty -->


    <owl:Class rdf:about="https://w3id.org/emmo/domain/pm-multiscale#TemperatureDependentProperty">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/emmo/domain/pm-multiscale#atTemperature"/>
                <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">A magnetic property value reported or computed at a specific temperature. Essential for comparing values across studies that use different measurement/simulation temperatures.</rdfs:comment>
        <rdfs:label>TemperatureDependentProperty</rdfs:label>
        <skos:prefLabel xml:lang="en">TemperatureDependentProperty</skos:prefLabel>
    </owl:Class>
    


    <!-- https://w3id.org/emmo/domain/pm-multiscale#Tetrataenite -->


    <owl:Class rdf:about="https://w3id.org/emmo/domain/pm-multiscale#Tetrataenite">
        <rdfs:subClassOf rdf:resource="https://w3id.org/emmo/domain/magnetic-material#CrystallineMagneticMaterial"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/emmo/domain/pm-multiscale#hasProperty"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/emmo/domain/magnetic-material#MagnetocrystallineAnisotropyConstantK1"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">Tetrataenite (L1₀-ordered FeNi) is a distinct crystalline magnetic phase considered a gap permanent magnet candidate; it is not expressible by any existing class in the 3-tier ontology and requires a new class under magmo:CrystallineMagneticMaterial.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/domain/pm-multiscale"/>
        <rdfs:label>tetrataenite</rdfs:label>
        <skos:note xml:lang="en">What is tetrataenite used for? — considered a candidate gap permanent magnet material</skos:note>
        <skos:prefLabel xml:lang="en">tetrataenite</skos:prefLabel>
    </owl:Class>
    


    <!-- https://w3id.org/emmo/domain/pm-multiscale#TextSource -->


    <owl:Class rdf:about="https://w3id.org/emmo/domain/pm-multiscale#TextSource">
        <rdfs:subClassOf rdf:resource="https://w3id.org/emmo/domain/pm-multiscale#PropertySource"/>
        <rdfs:comment xml:lang="en">A property value extracted from running text in a publication.</rdfs:comment>
        <rdfs:label>TextSource</rdfs:label>
        <skos:prefLabel xml:lang="en">TextSource</skos:prefLabel>
    </owl:Class>
    


    <!-- https://w3id.org/emmo/domain/pm-multiscale#TheoreticalEnergyProductLimit -->


    <owl:Class rdf:about="https://w3id.org/emmo/domain/pm-multiscale#TheoreticalEnergyProductLimit">
        <rdfs:subClassOf rdf:resource="https://w3id.org/emmo/domain/magnetic-material#MaximumEnergyProduct"/>
        <rdfs:comment xml:lang="en">Theoretical energy product limit is a derived upper-bound quantity distinct from the measured magmo:MaximumEnergyProduct; it requires a new subclass under magmo:MaximumEnergyProduct to represent the theoretically computed ceiling value assuming ideal microstructure.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/domain/pm-multiscale"/>
        <rdfs:label>theoretical energy product limit</rdfs:label>
        <skos:prefLabel xml:lang="en">theoretical energy product limit</skos:prefLabel>
    </owl:Class>
    


    <!-- https://w3id.org/emmo/domain/pm-multiscale#TwistGrainBoundary -->


    <owl:Class rdf:about="https://w3id.org/emmo/domain/pm-multiscale#TwistGrainBoundary">
        <rdfs:subClassOf rdf:resource="https://w3id.org/emmo/domain/magnetic-material#GrainBoundaryPhase"/>
        <rdfs:comment xml:lang="en">A twist grain boundary (basal-plane boundary between c-axis aligned grains, weak pinning centre) is a rigid, sortal subtype of grain boundary not captured by any existing magmo: annotation on magmo:GrainBoundaryPhase; a new subclass is required to distinguish it from tilt and general grain boundaries.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/domain/pm-multiscale"/>
        <rdfs:label>twist grain boundary</rdfs:label>
        <skos:prefLabel xml:lang="en">twist grain boundary</skos:prefLabel>
    </owl:Class>
    


    <!-- https://w3id.org/emmo/domain/pm-multiscale#TwoSublatticeMeanFieldModel -->


    <owl:Class rdf:about="https://w3id.org/emmo/domain/pm-multiscale#TwoSublatticeMeanFieldModel">
        <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#AtomisticModel"/>
    </owl:Class>
    


    <!-- https://w3id.org/emmo/domain/pm-multiscale#Twosublatticemicromagneticmodel -->


    <owl:Class rdf:about="https://w3id.org/emmo/domain/pm-multiscale#Twosublatticemicromagneticmodel">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/emmo/domain/pm-multiscale#hasScaleLevel"/>
                <owl:hasValue rdf:resource="https://w3id.org/emmo/domain/pm-multiscale#Mesoscopicscale"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- https://w3id.org/emmo/domain/pm-multiscale#UniaxialCrystalStructure -->


    <owl:Class rdf:about="https://w3id.org/emmo/domain/pm-multiscale#UniaxialCrystalStructure">
        <rdfs:subClassOf rdf:resource="https://w3id.org/emmo/domain/magnetic-material#CrystalStructure"/>
        <rdfs:comment xml:lang="en">A uniaxial crystal structure is a specialisation of magmo:CrystalStructure distinguished by hexagonal/tetragonal/rhombohedral symmetry and a unique easy-axis; no existing class in the 3-tier ontology captures this symmetry-plus-anisotropy combination, so a new subclass under magmo:CrystalStructure is required.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/domain/pm-multiscale"/>
        <rdfs:label>uniaxial crystal structure</rdfs:label>
        <skos:prefLabel xml:lang="en">uniaxial crystal structure</skos:prefLabel>
    </owl:Class>
    


    <!-- https://w3id.org/emmo/domain/pm-multiscale#ZeemanEnergyDensity -->


    <owl:Class rdf:about="https://w3id.org/emmo/domain/pm-multiscale#ZeemanEnergyDensity">
        <rdfs:subClassOf rdf:resource="https://w3id.org/emmo/domain/magnetic-material#MagnetocrystallineAnisotropyEnergy"/>
        <rdfs:comment xml:lang="en">Zeeman energy density is a distinct micromagnetic energy density term (-μ₀Ms·H) not expressible by any existing magmo: class; magmo:MagnetocrystallineAnisotropyEnergy is the closest structural analogue as a volumetric magnetic energy density, satisfying the GAP criterion for a new subclass in M3_Material.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/domain/pm-multiscale"/>
        <rdfs:label>zeeman energy density</rdfs:label>
        <skos:prefLabel xml:lang="en">zeeman energy density</skos:prefLabel>
    </owl:Class>
    


    <!-- https://w3id.org/emmo/domain/pm-multiscale#FixedSpinMoment(fsm)Calculation -->


    <owl:Class rdf:about="https://w3id.org/emmo/domain/pm-multiscale#FixedSpinMoment(fsm)Calculation">
        <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#Computation"/>
        <rdfs:comment xml:lang="en">Fixed spin moment (FSM) calculation is a constrained DFT method in which the total magnetic moment is fixed to study magnetisation-dependent properties of permanent magnets; it is a sub-method of pm:DFTStep not currently represented as a distinct class, warranting a new subclass under emmo:Computation.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/domain/pm-multiscale"/>
        <rdfs:label>fixed spin moment (fsm) calculation</rdfs:label>
        <skos:note xml:lang="en">What is fixed spin moment calculation used for? — to study the dependence of magnetic properties on magnetization magnitude</skos:note>
        <skos:prefLabel xml:lang="en">fixed spin moment (fsm) calculation</skos:prefLabel>
    </owl:Class>
    


