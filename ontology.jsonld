  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Magnetization reversal is a core micromagnetic process simulated in pm:MicromagneticsStep workflows but is not itself an existing class; a new subclass under pm:MicromagneticsStep captures the switching process per the gap criterion."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/emmo/domain/pm-multiscale"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "magnetization reversal"
