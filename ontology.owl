        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- https://w3id.org/emmo/domain/pm-multiscale#CrystallographicSite -->


    <owl:Class rdf:about="https://w3id.org/emmo/domain/pm-multiscale#CrystallographicSite">
        <rdfs:subClassOf rdf:resource="https://w3id.org/emmo/domain/magnetic-material#CrystalStructure"/>
        <rdfs:comment xml:lang="en">A crystallographic site (Wyckoff position) is a sub-structural element of magmo:CrystalStructure; no existing class in the 3-tier ontology represents individual Wyckoff positions, so a new subclass is needed under magmo:CrystalStructure.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/domain/pm-multiscale"/>
        <rdfs:label>crystallographic site</rdfs:label>
        <skos:prefLabel xml:lang="en">crystallographic site</skos:prefLabel>
    </owl:Class>
    


    <!-- https://w3id.org/emmo/domain/pm-multiscale#CurieBlochEquation -->


    <owl:Class rdf:about="https://w3id.org/emmo/domain/pm-multiscale#CurieBlochEquation">
        <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#MaterialLaw"/>
        <rdfs:comment xml:lang="en">The Curie-Bloch equation is a phenomenological law relating magnetization to temperature (M(T) ∝ (1−T/Tc)^β); it functions as an emmo:MaterialLaw used to fit experimental or simulated M(T) curves, and no existing pm: or magmo: class captures this temperature-scaling relation.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/domain/pm-multiscale"/>
        <rdfs:label>curie-bloch equation</rdfs:label>
        <skos:prefLabel xml:lang="en">curie-bloch equation</skos:prefLabel>
    </owl:Class>
    


    <!-- https://w3id.org/emmo/domain/pm-multiscale#CurieTemperature -->


    <owl:Class rdf:about="https://w3id.org/emmo/domain/pm-multiscale#CurieTemperature">
        <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#EMMO_909a0a36_2242_4a8c_a5e1_3fa6e9b42f10"/>
        <rdfs:comment xml:lang="en">The critical temperature above which a ferromagnet becomes paramagnetic, losing spontaneous magnetization. Nd2Fe14B: 585K, SmCo5: 1020K.</rdfs:comment>
        <rdfs:comment xml:lang="en">The critical temperature above which a ferromagnet becomes paramagnetic, losing spontaneous magnetization. Nd2Fe14B: 585K, SmCo5: 1020K. Not present in MagMO v1.0.0.</rdfs:comment>
        <rdfs:label>CurieTemperature</rdfs:label>
        <skos:prefLabel xml:lang="en">CurieTemperature</skos:prefLabel>
    </owl:Class>
    


    <!-- https://w3id.org/emmo/domain/pm-multiscale#DFTConfiguration -->


    <owl:Class rdf:about="https://w3id.org/emmo/domain/pm-multiscale#DFTConfiguration">
        <rdfs:subClassOf rdf:resource="https://w3id.org/emmo/domain/pm-multiscale#SimulationConfiguration"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/emmo/domain/pm-multiscale#hasExchangeCorrelationFunctional"/>
                <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">Configuration for a DFT calculation: exchange-correlation functional (PBE, LDA, GGA+U), basis set / plane-wave cutoff, k-point sampling, and spin-orbit coupling settings.</rdfs:comment>
        <rdfs:label>DFTConfiguration</rdfs:label>
        <skos:prefLabel xml:lang="en">DFTConfiguration</skos:prefLabel>
    </owl:Class>
    


    <!-- https://w3id.org/emmo/domain/pm-multiscale#DFTStep -->


    <owl:Class rdf:about="https://w3id.org/emmo/domain/pm-multiscale#DFTStep">
        <rdfs:subClassOf rdf:resource="https://w3id.org/emmo/domain/pm-multiscale#SimulationStep"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/emmo/domain/pm-multiscale#hasOutputParameter"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/emmo/domain/magnetic-material#MagnetocrystallineAnisotropyEnergy"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/emmo/domain/pm-multiscale#hasOutputParameter"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/emmo/domain/magnetic-material#SaturationMagnetization"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/emmo/domain/pm-multiscale#hasOutputParameter"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/emmo/domain/pm-multiscale#CurieTemperature"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/emmo/domain/pm-multiscale#hasConfiguration"/>
                <owl:allValuesFrom rdf:resource="https://w3id.org/emmo/domain/pm-multiscale#DFTConfiguration"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/emmo/domain/pm-multiscale#hasScaleLevel"/>
                <owl:hasValue rdf:resource="https://w3id.org/emmo/domain/pm-multiscale#ElectronicScale"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">A density functional theory calculation that computes ground-state electronic properties: spontaneous magnetization (Ms_0), magnetocrystalline anisotropy (K1), and exchange coupling constants (Jij) from first principles.</rdfs:comment>
        <rdfs:label>DFTStep</rdfs:label>
        <skos:altLabel xml:lang="en">fermi-dirac smearing</skos:altLabel>
        <skos:altLabel xml:lang="en">full-potential linear muffin-tin orbital method</skos:altLabel>
        <skos:altLabel xml:lang="en">full-potential linearized augmented plane wave (flapw) method</skos:altLabel>
        <skos:altLabel xml:lang="en">full-potential lmto method</skos:altLabel>
        <skos:altLabel xml:lang="en">kkr green&apos;s function method</skos:altLabel>
        <skos:altLabel xml:lang="en">noncollinear magnetic calculation</skos:altLabel>
        <skos:prefLabel xml:lang="en">DFTStep</skos:prefLabel>
    </owl:Class>
    


    <!-- https://w3id.org/emmo/domain/pm-multiscale#DataRepository -->


    <owl:Class rdf:about="https://w3id.org/emmo/domain/pm-multiscale#DataRepository">
        <rdfs:comment xml:lang="en">A data repository or database where material simulation data is stored and accessible via a persistent identifier.</rdfs:comment>
        <rdfs:label>DataRepository</rdfs:label>
        <skos:prefLabel xml:lang="en">DataRepository</skos:prefLabel>
    </owl:Class>
    


    <!-- https://w3id.org/emmo/domain/pm-multiscale#DipolarCouplingConstant -->


    <owl:Class rdf:about="https://w3id.org/emmo/domain/pm-multiscale#DipolarCouplingConstant">
        <rdfs:subClassOf rdf:resource="https://w3id.org/emmo/domain/magnetic-material#UniaxialAnisotropyConstant"/>
        <rdfs:comment xml:lang="en">Dipolar coupling constant (g_ab = M_a M_b v²) is a pairwise interaction prefactor not expressible by any existing magmo: constant class; it is a rigid Quantity analogous in role to magmo:UniaxialAnisotropyConstant but governing dipolar rather than anisotropy interactions.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/domain/pm-multiscale"/>
        <rdfs:label>dipolar coupling constant</rdfs:label>
        <skos:prefLabel xml:lang="en">dipolar coupling constant</skos:prefLabel>
    </owl:Class>
    


    <!-- https://w3id.org/emmo/domain/pm-multiscale#DipolarEnergy -->


    <owl:Class rdf:about="https://w3id.org/emmo/domain/pm-multiscale#DipolarEnergy">
        <rdfs:subClassOf rdf:resource="https://w3id.org/emmo/domain/magnetic-material#MagnetocrystallineAnisotropyEnergy"/>
        <rdfs:comment xml:lang="en">Dipolar energy is a distinct magnetic interaction energy (long-range dipole-dipole) not expressible as any existing magmo: energy class; it is a rigid Quantity under emmo:Energy and is essential for multi-scale micromagnetic simulations of permanent magnets.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/domain/pm-multiscale"/>
        <rdfs:label>dipolar energy</rdfs:label>
        <skos:prefLabel xml:lang="en">dipolar energy</skos:prefLabel>
    </owl:Class>
    


    <!-- https://w3id.org/emmo/domain/pm-multiscale#Dipolarenergy -->


    <owl:Class rdf:about="https://w3id.org/emmo/domain/pm-multiscale#Dipolarenergy">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/emmo/domain/pm-multiscale#hasScaleLevel"/>
                <owl:hasValue rdf:resource="https://w3id.org/emmo/domain/pm-multiscale#Mesoscopicscale"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- https://w3id.org/emmo/domain/pm-multiscale#DomainNucleation -->


    <owl:Class rdf:about="https://w3id.org/emmo/domain/pm-multiscale#DomainNucleation">
        <rdfs:subClassOf rdf:resource="https://w3id.org/emmo/domain/pm-multiscale#MicromagneticsStep"/>
        <owl:disjointWith rdf:resource="https://w3id.org/emmo/domain/pm-multiscale#DomainWallMotion"/>
    </owl:Class>
    


    <!-- https://w3id.org/emmo/domain/pm-multiscale#DomainWallDepinningField -->


    <owl:Class rdf:about="https://w3id.org/emmo/domain/pm-multiscale#DomainWallDepinningField">
        <rdfs:subClassOf rdf:resource="https://w3id.org/emmo/domain/magnetic-material#CoercivityHc"/>
        <rdfs:comment xml:lang="en">Domain wall depinning field is a distinct coercivity-mechanism quantity (the field required to unpin a domain wall from a defect) that is not captured by the general magmo:CoercivityHc class; it requires a new subclass to represent the pinning-limited coercivity contribution per the GAP criterion for missing mechanistic specificity.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/domain/pm-multiscale"/>
        <rdfs:label>domain wall depinning field</rdfs:label>
        <skos:prefLabel xml:lang="en">domain wall depinning field</skos:prefLabel>
    </owl:Class>
    


    <!-- https://w3id.org/emmo/domain/pm-multiscale#DomainWallEnergyDensity -->


    <owl:Class rdf:about="https://w3id.org/emmo/domain/pm-multiscale#DomainWallEnergyDensity">
        <rdfs:subClassOf rdf:resource="https://w3id.org/emmo/domain/magnetic-material#MagnetocrystallineAnisotropyEnergy"/>
        <rdfs:comment xml:lang="en">Domain wall energy density (J/m²) is a distinct surface energy density quantity not expressible by magmo:MagnetocrystallineAnisotropyEnergy (a volumetric energy); it is a rigid Quantity in multi-scale permanent magnet modelling requiring a new GAP class.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/domain/pm-multiscale"/>
        <rdfs:label>domain wall energy density</rdfs:label>
        <skos:note xml:lang="en">What does domain wall energy density drive? — drives domain wall pinning</skos:note>
        <skos:prefLabel xml:lang="en">domain wall energy density</skos:prefLabel>
    </owl:Class>
    


    <!-- https://w3id.org/emmo/domain/pm-multiscale#DomainWallMotion -->


    <owl:Class rdf:about="https://w3id.org/emmo/domain/pm-multiscale#DomainWallMotion">
        <rdfs:subClassOf rdf:resource="https://w3id.org/emmo/domain/pm-multiscale#MicromagneticsStep"/>
    </owl:Class>
    


    <!-- https://w3id.org/emmo/domain/pm-multiscale#DomainWallNucleationField -->


    <owl:Class rdf:about="https://w3id.org/emmo/domain/pm-multiscale#DomainWallNucleationField">
        <rdfs:subClassOf rdf:resource="https://w3id.org/emmo/domain/magnetic-material#CoercivityHc"/>
        <rdfs:comment xml:lang="en">Domain wall nucleation field is a distinct coercivity-mechanism quantity (the field required to nucleate a domain wall at a specific defect) that is not captured by the general magmo:CoercivityHc class; it requires a new subclass to represent the nucleation-limited coercivity contribution per the GAP criterion for missing mechanistic specificity.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/domain/pm-multiscale"/>
        <rdfs:label>domain wall nucleation field</rdfs:label>
        <skos:prefLabel xml:lang="en">domain wall nucleation field</skos:prefLabel>
    </owl:Class>
    


    <!-- https://w3id.org/emmo/domain/pm-multiscale#DomainWallPropagation -->


    <owl:Class rdf:about="https://w3id.org/emmo/domain/pm-multiscale#DomainWallPropagation">
        <rdfs:subClassOf rdf:resource="https://w3id.org/emmo/domain/pm-multiscale#MicromagneticsStep"/>
    </owl:Class>
    


    <!-- https://w3id.org/emmo/domain/pm-multiscale#Domainwalldepinningfield -->


    <owl:Class rdf:about="https://w3id.org/emmo/domain/pm-multiscale#Domainwalldepinningfield">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/emmo/domain/pm-multiscale#hasScaleLevel"/>
                <owl:hasValue rdf:resource="https://w3id.org/emmo/domain/pm-multiscale#Mesoscopicscale"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- https://w3id.org/emmo/domain/pm-multiscale#Domainwallnucleationfield -->


    <owl:Class rdf:about="https://w3id.org/emmo/domain/pm-multiscale#Domainwallnucleationfield">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/emmo/domain/pm-multiscale#hasScaleLevel"/>
                <owl:hasValue rdf:resource="https://w3id.org/emmo/domain/pm-multiscale#Mesoscopicscale"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- https://w3id.org/emmo/domain/pm-multiscale#Domainwallpinning -->


    <owl:Class rdf:about="https://w3id.org/emmo/domain/pm-multiscale#Domainwallpinning">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/emmo/domain/pm-multiscale#hasScaleLevel"/>
                <owl:hasValue rdf:resource="https://w3id.org/emmo/domain/pm-multiscale#Mesoscopicscale"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- https://w3id.org/emmo/domain/pm-multiscale#Domainwallpropagation -->


    <owl:Class rdf:about="https://w3id.org/emmo/domain/pm-multiscale#Domainwallpropagation">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/emmo/domain/pm-multiscale#hasScaleLevel"/>
                <owl:hasValue rdf:resource="https://w3id.org/emmo/domain/pm-multiscale#Mesoscopicscale"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- https://w3id.org/emmo/domain/pm-multiscale#Dorbitalresolvedmae -->


    <owl:Class rdf:about="https://w3id.org/emmo/domain/pm-multiscale#Dorbitalresolvedmae">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/emmo/domain/pm-multiscale#hasScaleLevel"/>
                <owl:hasValue rdf:resource="https://w3id.org/emmo/domain/pm-multiscale#Electronicscale"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- https://w3id.org/emmo/domain/pm-multiscale#DynamicalMeanFieldTheory -->


    <owl:Class rdf:about="https://w3id.org/emmo/domain/pm-multiscale#DynamicalMeanFieldTheory">
        <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#ElectronicModel"/>
    </owl:Class>
    


    <!-- https://w3id.org/emmo/domain/pm-multiscale#Dynamicalmeanfieldtheory -->


    <owl:Class rdf:about="https://w3id.org/emmo/domain/pm-multiscale#Dynamicalmeanfieldtheory">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/emmo/domain/pm-multiscale#hasScaleLevel"/>
                <owl:hasValue rdf:resource="https://w3id.org/emmo/domain/pm-multiscale#Electronicscale"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- https://w3id.org/emmo/domain/pm-multiscale#DzyaloshinskiiMoriyaInteraction -->


    <owl:Class rdf:about="https://w3id.org/emmo/domain/pm-multiscale#DzyaloshinskiiMoriyaInteraction">
        <rdfs:subClassOf rdf:resource="https://w3id.org/emmo/domain/magnetic-material#ExchangeStiffnessConstant"/>
        <rdfs:comment xml:lang="en">DMI is an antisymmetric exchange interaction relevant to spin textures and domain-wall energetics in permanent-magnet interfaces; no existing magmo: class represents antisymmetric exchange, so a new sibling/subclass near magmo:ExchangeStiffnessConstant is needed.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/domain/pm-multiscale"/>
        <rdfs:label>dzyaloshinskii-moriya interaction</rdfs:label>
        <skos:note xml:lang="en">What does the Dzyaloshinskii-Moriya interaction contribute to? — contributing a chiral term to the magnetic SANS cross section</skos:note>
        <skos:prefLabel xml:lang="en">dzyaloshinskii-moriya interaction</skos:prefLabel>
    </owl:Class>
    


    <!-- https://w3id.org/emmo/domain/pm-multiscale#EasyConeAnisotropy -->


    <owl:Class rdf:about="https://w3id.org/emmo/domain/pm-multiscale#EasyConeAnisotropy">
        <rdfs:subClassOf rdf:resource="https://w3id.org/emmo/domain/magnetic-material#UniaxialMagneticAnisotropy"/>
        <rdfs:comment xml:lang="en">Easy-cone anisotropy is a distinct anisotropy type (energy minimum on a cone, K1&lt;0, K2&gt;-K1/2) not covered by magmo:UniaxialMagneticAnisotropy (axial minimum) or magmo:CubicMagnetocrystallineAnisotropy; it requires a new subclass under magmo:UniaxialMagneticAnisotropy to maintain rigid subsumption.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/domain/pm-multiscale"/>
        <rdfs:label>easy-cone anisotropy</rdfs:label>
        <skos:prefLabel xml:lang="en">easy-cone anisotropy</skos:prefLabel>
    </owl:Class>
    


    <!-- https://w3id.org/emmo/domain/pm-multiscale#Effectiveanisotropy -->


    <owl:Class rdf:about="https://w3id.org/emmo/domain/pm-multiscale#Effectiveanisotropy">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/emmo/domain/pm-multiscale#hasScaleLevel"/>
                <owl:hasValue rdf:resource="https://w3id.org/emmo/domain/pm-multiscale#Mesoscopicscale"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- https://w3id.org/emmo/domain/pm-multiscale#EquiaxedGrains -->


    <owl:Class rdf:about="https://w3id.org/emmo/domain/pm-multiscale#EquiaxedGrains">
        <rdfs:subClassOf rdf:resource="https://w3id.org/emmo/domain/magnetic-material#Grain"/>
        <rdfs:comment xml:lang="en">Equiaxed grains are a rigid, sortal morphological subtype of magmo:Grain (equal dimensions in all directions) not distinguished by any existing magmo: annotation; they require a new subclass under magmo:Grain to capture their microstructural role in SmCo-based PM alloys.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/domain/pm-multiscale"/>
        <rdfs:label>equiaxed grains</rdfs:label>
        <skos:prefLabel xml:lang="en">equiaxed grains</skos:prefLabel>
    </owl:Class>
    


    <!-- https://w3id.org/emmo/domain/pm-multiscale#ExchangeCorrelationFunctional -->


    <owl:Class rdf:about="https://w3id.org/emmo/domain/pm-multiscale#ExchangeCorrelationFunctional">
        <rdfs:comment xml:lang="en">The exchange-correlation functional approximation used in DFT. The choice (PBE vs LDA vs GGA+U) directly affects computed magnetic moments and anisotropy.</rdfs:comment>
        <rdfs:label>ExchangeCorrelationFunctional</rdfs:label>
        <skos:prefLabel xml:lang="en">ExchangeCorrelationFunctional</skos:prefLabel>
    </owl:Class>
    


    <!-- https://w3id.org/emmo/domain/pm-multiscale#ExchangeEnergyDensity -->


    <owl:Class rdf:about="https://w3id.org/emmo/domain/pm-multiscale#ExchangeEnergyDensity">
        <rdfs:subClassOf rdf:resource="https://w3id.org/emmo/domain/magnetic-material#MagnetocrystallineAnisotropyEnergy"/>
        <rdfs:comment xml:lang="en">Exchange energy density (∝A|∇m|²) is a distinct micromagnetic energy density term not covered by any existing magmo: class; magmo:MagnetocrystallineAnisotropyEnergy is the closest structural parent as a volumetric magnetic energy density, warranting a new sibling subclass in M3_Material.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/domain/pm-multiscale"/>
        <rdfs:label>exchange energy density</rdfs:label>
        <skos:prefLabel xml:lang="en">exchange energy density</skos:prefLabel>
    </owl:Class>
    


    <!-- https://w3id.org/emmo/domain/pm-multiscale#ExchangeSpringMagnet -->


    <owl:Class rdf:about="https://w3id.org/emmo/domain/pm-multiscale#ExchangeSpringMagnet">
        <rdfs:subClassOf rdf:resource="https://w3id.org/emmo/domain/magnetic-material#BulkMagnet"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/emmo/domain/pm-multiscale#hasPart"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/emmo/domain/pm-multiscale#HardMagnet"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/emmo/domain/pm-multiscale#hasPart"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/emmo/domain/pm-multiscale#SoftMagnet"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">An exchange-spring magnet is a nanocomposite permanent magnet type combining hard and soft phases via exchange coupling; it is a distinct pm-multiscale-relevant material class not captured by pm:PermanentMagnetMaterial or any existing magmo: subclass, and should be a new subclass of magmo:BulkMagnet.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/domain/pm-multiscale"/>
        <rdfs:label>exchange-spring magnet</rdfs:label>
        <skos:prefLabel xml:lang="en">exchange-spring magnet</skos:prefLabel>
    </owl:Class>
    


    <!-- https://w3id.org/emmo/domain/pm-multiscale#Exchangecouplednanocompositepermanentmagnet -->


    <owl:Class rdf:about="https://w3id.org/emmo/domain/pm-multiscale#Exchangecouplednanocompositepermanentmagnet">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/emmo/domain/pm-multiscale#hasScaleLevel"/>
                <owl:hasValue rdf:resource="https://w3id.org/emmo/domain/pm-multiscale#Mesoscopicscale"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- https://w3id.org/emmo/domain/pm-multiscale#Exchangespringmagnet -->


    <owl:Class rdf:about="https://w3id.org/emmo/domain/pm-multiscale#Exchangespringmagnet">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/emmo/domain/pm-multiscale#hasScaleLevel"/>
                <owl:hasValue rdf:resource="https://w3id.org/emmo/domain/pm-multiscale#Mesoscopicscale"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- https://w3id.org/emmo/domain/pm-multiscale#Exchangespringpermanentmagnet -->


    <owl:Class rdf:about="https://w3id.org/emmo/domain/pm-multiscale#Exchangespringpermanentmagnet">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/emmo/domain/pm-multiscale#hasScaleLevel"/>
                <owl:hasValue rdf:resource="https://w3id.org/emmo/domain/pm-multiscale#Mesoscopicscale"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- https://w3id.org/emmo/domain/pm-multiscale#ExperimentalDetermination -->


    <owl:Class rdf:about="https://w3id.org/emmo/domain/pm-multiscale#ExperimentalDetermination">
        <rdfs:subClassOf rdf:resource="https://w3id.org/emmo/domain/pm-multiscale#PropertyDetermination"/>
        <rdfs:comment xml:lang="en">A property value obtained through experimental measurement: VSM, SQUID magnetometry, PPMS, or neutron diffraction.</rdfs:comment>
        <rdfs:label>ExperimentalDetermination</rdfs:label>
        <skos:prefLabel xml:lang="en">ExperimentalDetermination</skos:prefLabel>
    </owl:Class>
    


    <!-- https://w3id.org/emmo/domain/pm-multiscale#ExperimentalValidation -->


    <owl:Class rdf:about="https://w3id.org/emmo/domain/pm-multiscale#ExperimentalValidation">
        <rdfs:comment xml:lang="en">A record that a computed property value has been compared against an experimental measurement, including the agreement/discrepancy.</rdfs:comment>
        <rdfs:label>ExperimentalValidation</rdfs:label>
        <skos:altLabel xml:lang="en">lorentz tem</skos:altLabel>
        <skos:altLabel xml:lang="en">vibrating-sample magnetometer</skos:altLabel>
        <skos:prefLabel xml:lang="en">ExperimentalValidation</skos:prefLabel>
    </owl:Class>
    


    <!-- https://w3id.org/emmo/domain/pm-multiscale#Fermidiracsmearing -->


    <owl:Class rdf:about="https://w3id.org/emmo/domain/pm-multiscale#Fermidiracsmearing">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/emmo/domain/pm-multiscale#hasScaleLevel"/>
                <owl:hasValue rdf:resource="https://w3id.org/emmo/domain/pm-multiscale#Electronicscale"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- https://w3id.org/emmo/domain/pm-multiscale#Ferrimagnet -->


    <owl:Class rdf:about="https://w3id.org/emmo/domain/pm-multiscale#Ferrimagnet">
        <rdfs:subClassOf rdf:resource="https://w3id.org/emmo/domain/magnetic-material#CrystallineMagneticMaterial"/>
        <rdfs:comment xml:lang="en">A ferrimagnet (net spontaneous magnetisation from unequal antiparallel sublattices, e.g. Gd2Fe14B) is a rigid, sortal material class; pm:Ferrite is too narrow (oxide ferrites only), so a new subclass under magmo:CrystallineMagneticMaterial is required for the general ferrimagnetic material type.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/domain/pm-multiscale"/>
        <rdfs:label>ferrimagnet</rdfs:label>
        <skos:prefLabel xml:lang="en">ferrimagnet</skos:prefLabel>
    </owl:Class>
    


    <!-- https://w3id.org/emmo/domain/pm-multiscale#FigureSource -->


    <owl:Class rdf:about="https://w3id.org/emmo/domain/pm-multiscale#FigureSource">
        <rdfs:subClassOf rdf:resource="https://w3id.org/emmo/domain/pm-multiscale#PropertySource"/>
        <rdfs:comment xml:lang="en">A property value extracted or digitized from a figure in a publication.</rdfs:comment>
        <rdfs:label>FigureSource</rdfs:label>
        <skos:prefLabel xml:lang="en">FigureSource</skos:prefLabel>
    </owl:Class>
    


    <!-- https://w3id.org/emmo/domain/pm-multiscale#Fixedspinmomentcalculation -->


    <owl:Class rdf:about="https://w3id.org/emmo/domain/pm-multiscale#Fixedspinmomentcalculation">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/emmo/domain/pm-multiscale#hasScaleLevel"/>
                <owl:hasValue rdf:resource="https://w3id.org/emmo/domain/pm-multiscale#Electronicscale"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- https://w3id.org/emmo/domain/pm-multiscale#Fixedspinmomentmethod -->


    <owl:Class rdf:about="https://w3id.org/emmo/domain/pm-multiscale#Fixedspinmomentmethod">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/emmo/domain/pm-multiscale#hasScaleLevel"/>
                <owl:hasValue rdf:resource="https://w3id.org/emmo/domain/pm-multiscale#Electronicscale"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- https://w3id.org/emmo/domain/pm-multiscale#Flapwmethod -->


    <owl:Class rdf:about="https://w3id.org/emmo/domain/pm-multiscale#Flapwmethod">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/emmo/domain/pm-multiscale#hasScaleLevel"/>
                <owl:hasValue rdf:resource="https://w3id.org/emmo/domain/pm-multiscale#Electronicscale"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- https://w3id.org/emmo/domain/pm-multiscale#Frozenmagnoncalculation -->


    <owl:Class rdf:about="https://w3id.org/emmo/domain/pm-multiscale#Frozenmagnoncalculation">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/emmo/domain/pm-multiscale#hasScaleLevel"/>
                <owl:hasValue rdf:resource="https://w3id.org/emmo/domain/pm-multiscale#Atomisticscale"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- https://w3id.org/emmo/domain/pm-multiscale#Fullpotentiallmtomethod -->


    <owl:Class rdf:about="https://w3id.org/emmo/domain/pm-multiscale#Fullpotentiallmtomethod">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/emmo/domain/pm-multiscale#hasScaleLevel"/>
                <owl:hasValue rdf:resource="https://w3id.org/emmo/domain/pm-multiscale#Electronicscale"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- https://w3id.org/emmo/domain/pm-multiscale#Giantmagneticmoment -->


    <owl:Class rdf:about="https://w3id.org/emmo/domain/pm-multiscale#Giantmagneticmoment">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/emmo/domain/pm-multiscale#hasScaleLevel"/>
                <owl:hasValue rdf:resource="https://w3id.org/emmo/domain/pm-multiscale#Electronicscale"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- https://w3id.org/emmo/domain/pm-multiscale#GilbertDampingConstant -->


    <owl:Class rdf:about="https://w3id.org/emmo/domain/pm-multiscale#GilbertDampingConstant">
        <rdfs:subClassOf rdf:resource="https://w3id.org/emmo/domain/magnetic-material#ExchangeStiffnessConstant"/>
        <rdfs:comment xml:lang="en">The Gilbert damping constant α is a dimensionless material parameter governing LLG spin dynamics, analogous in role to magmo:ExchangeStiffnessConstant as a micromagnetic material parameter; no existing class covers it, so a new sibling subclass is needed.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/domain/pm-multiscale"/>
        <rdfs:label>gilbert damping constant</rdfs:label>
        <skos:prefLabel xml:lang="en">gilbert damping constant</skos:prefLabel>
    </owl:Class>
    


    <!-- https://w3id.org/emmo/domain/pm-multiscale#GilbertEquationOfMotion -->


    <owl:Class rdf:about="https://w3id.org/emmo/domain/pm-multiscale#GilbertEquationOfMotion">
        <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#MaterialsModel"/>
        <rdfs:comment xml:lang="en">The Gilbert equation of motion is the dynamic equation for magnetization precession and damping, foundational to both micromagnetic and atomistic spin-dynamics simulations; it is a MaterialsModel governing magnetization dynamics, and while pm:SpinDynamicsConfiguration captures its parameters, no class represents the equation itself.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/domain/pm-multiscale"/>
        <rdfs:label>gilbert equation of motion</rdfs:label>
        <skos:prefLabel xml:lang="en">gilbert equation of motion</skos:prefLabel>
    </owl:Class>
    


    <!-- https://w3id.org/emmo/domain/pm-multiscale#HardAxis -->


    <owl:Class rdf:about="https://w3id.org/emmo/domain/pm-multiscale#HardAxis">
        <rdfs:subClassOf rdf:resource="https://w3id.org/emmo/domain/magnetic-material#CrystallographicOrientation"/>
        <rdfs:comment xml:lang="en">Hard axis is a crystallographic direction concept directly relevant to magnetocrystalline anisotropy in permanent magnets; no existing magmo: class captures the hard-axis direction specifically, so a new subclass under magmo:CrystallographicOrientation is warranted.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/domain/pm-multiscale"/>
        <rdfs:label>hard axis</rdfs:label>
        <skos:prefLabel xml:lang="en">hard axis</skos:prefLabel>
    </owl:Class>
    


    <!-- https://w3id.org/emmo/domain/pm-multiscale#HardGrain -->


    <owl:Class rdf:about="https://w3id.org/emmo/domain/pm-multiscale#HardGrain">
        <rdfs:subClassOf rdf:resource="https://w3id.org/emmo/domain/magnetic-material#Grain"/>
        <rdfs:comment xml:lang="en">A hard grain is a rigid, sortal subtype of magmo:Grain distinguished by its switching-field criterion and bistable magnetisation states, a distinction not captured by any existing magmo: class annotation, making it a GAP requiring a new subclass under magmo:Grain.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/domain/pm-multiscale"/>
        <rdfs:label>hard grain</rdfs:label>
        <skos:prefLabel xml:lang="en">hard grain</skos:prefLabel>
    </owl:Class>
    


    <!-- https://w3id.org/emmo/domain/pm-multiscale#HardMagnet -->


    <owl:Class rdf:about="https://w3id.org/emmo/domain/pm-multiscale#HardMagnet">
        <rdfs:subClassOf rdf:resource="https://w3id.org/emmo/domain/pm-multiscale#PermanentMagnetMaterial"/>
        <owl:disjointWith rdf:resource="https://w3id.org/emmo/domain/pm-multiscale#SoftMagnet"/>
        <rdfs:comment xml:lang="en">A permanent magnet with high coercivity (typically Hc &gt; 400 kA/m), suitable for applications requiring stable magnetic fields: motors, generators, sensors.</rdfs:comment>
        <rdfs:label>HardMagnet</rdfs:label>
        <skos:prefLabel xml:lang="en">HardMagnet</skos:prefLabel>
    </owl:Class>
    


    <!-- https://w3id.org/emmo/domain/pm-multiscale#Hardaxis -->


    <owl:Class rdf:about="https://w3id.org/emmo/domain/pm-multiscale#Hardaxis">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/emmo/domain/pm-multiscale#hasProperty"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/emmo/domain/magnetic-material#MagnetocrystallineAnisotropy"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- https://w3id.org/emmo/domain/pm-multiscale#HeisenbergExchangeParameter -->


    <owl:Class rdf:about="https://w3id.org/emmo/domain/pm-multiscale#HeisenbergExchangeParameter">
        <rdfs:subClassOf rdf:resource="https://w3id.org/emmo/domain/magnetic-material#ExchangeStiffnessConstant"/>
        <rdfs:comment xml:lang="en">The Heisenberg exchange parameter J_ij is a pairwise site-resolved quantity distinct from the continuum magmo:ExchangeStiffnessConstant; it is an atomistic-scale input to Monte Carlo / spin-dynamics simulations and requires a new subclass under magmo:ExchangeStiffnessConstant in M3_Material.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/domain/pm-multiscale"/>
        <rdfs:label>heisenberg exchange parameter</rdfs:label>
        <skos:note xml:lang="en">What is the Heisenberg exchange parameter used for? — used as input to Monte Carlo simulations for Curie temperature determination</skos:note>
        <skos:prefLabel xml:lang="en">heisenberg exchange parameter</skos:prefLabel>
    </owl:Class>
    


    <!-- https://w3id.org/emmo/domain/pm-multiscale#HeisenbergModelHamiltonian -->


    <owl:Class rdf:about="https://w3id.org/emmo/domain/pm-multiscale#HeisenbergModelHamiltonian">
        <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#AtomisticModel"/>
    </owl:Class>
    


    <!-- https://w3id.org/emmo/domain/pm-multiscale#Heisenbergmodelhamiltonian -->


    <owl:Class rdf:about="https://w3id.org/emmo/domain/pm-multiscale#Heisenbergmodelhamiltonian">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/emmo/domain/pm-multiscale#hasScaleLevel"/>
                <owl:hasValue rdf:resource="https://w3id.org/emmo/domain/pm-multiscale#Atomisticscale"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- https://w3id.org/emmo/domain/pm-multiscale#Heisenbergspinhamiltonian -->


    <owl:Class rdf:about="https://w3id.org/emmo/domain/pm-multiscale#Heisenbergspinhamiltonian">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/emmo/domain/pm-multiscale#hasScaleLevel"/>
                <owl:hasValue rdf:resource="https://w3id.org/emmo/domain/pm-multiscale#Atomisticscale"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- https://w3id.org/emmo/domain/pm-multiscale#Heisenbergspinmodel -->


    <owl:Class rdf:about="https://w3id.org/emmo/domain/pm-multiscale#Heisenbergspinmodel">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/emmo/domain/pm-multiscale#hasScaleLevel"/>
                <owl:hasValue rdf:resource="https://w3id.org/emmo/domain/pm-multiscale#Atomisticscale"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- https://w3id.org/emmo/domain/pm-multiscale#HeuslerAlloy -->


    <owl:Class rdf:about="https://w3id.org/emmo/domain/pm-multiscale#HeuslerAlloy">
        <rdfs:subClassOf rdf:resource="https://w3id.org/emmo/domain/magnetic-material#CrystallineMagneticMaterial"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/emmo/domain/pm-multiscale#hasProperty"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/emmo/domain/magnetic-material#SaturationMagnetization"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/emmo/domain/pm-multiscale#hasProperty"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/emmo/domain/pm-multiscale#CurieTemperature"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">Heusler alloys (X2YZ intermetallics) are a distinct class of crystalline magnetic materials investigated for rare-earth-free permanent magnet applications; they are not captured by pm:AlNiCo or any existing pm:/magmo: material class, requiring a new subclass of magmo:CrystallineMagneticMaterial.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/domain/pm-multiscale"/>
        <rdfs:label>heusler alloy</rdfs:label>
        <skos:note xml:lang="en">What is a Heusler alloy used for? — studied here as all-3d transition metal variants for permanent magnet applications</skos:note>
        <skos:prefLabel xml:lang="en">heusler alloy</skos:prefLabel>
    </owl:Class>
    


    <!-- https://w3id.org/emmo/domain/pm-multiscale#HubbardIApproximation -->


    <owl:Class rdf:about="https://w3id.org/emmo/domain/pm-multiscale#HubbardIApproximation">
        <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#ElectronicModel"/>
    </owl:Class>
    


    <!-- https://w3id.org/emmo/domain/pm-multiscale#Hubbardiapproximation -->


    <owl:Class rdf:about="https://w3id.org/emmo/domain/pm-multiscale#Hubbardiapproximation">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/emmo/domain/pm-multiscale#hasScaleLevel"/>
                <owl:hasValue rdf:resource="https://w3id.org/emmo/domain/pm-multiscale#Electronicscale"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- https://w3id.org/emmo/domain/pm-multiscale#Hubbardupotential -->


    <owl:Class rdf:about="https://w3id.org/emmo/domain/pm-multiscale#Hubbardupotential">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/emmo/domain/pm-multiscale#hasScaleLevel"/>
                <owl:hasValue rdf:resource="https://w3id.org/emmo/domain/pm-multiscale#Electronicscale"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- https://w3id.org/emmo/domain/pm-multiscale#Interatomicexchangeparameter -->


    <owl:Class rdf:about="https://w3id.org/emmo/domain/pm-multiscale#Interatomicexchangeparameter">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/emmo/domain/pm-multiscale#hasScaleLevel"/>
                <owl:hasValue rdf:resource="https://w3id.org/emmo/domain/pm-multiscale#Electronicscale"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- https://w3id.org/emmo/domain/pm-multiscale#Intersiteexchangecouplingparameter -->


    <owl:Class rdf:about="https://w3id.org/emmo/domain/pm-multiscale#Intersiteexchangecouplingparameter">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/emmo/domain/pm-multiscale#hasScaleLevel"/>
                <owl:hasValue rdf:resource="https://w3id.org/emmo/domain/pm-multiscale#Atomisticscale"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- https://w3id.org/emmo/domain/pm-multiscale#KPointSampling -->


    <owl:Class rdf:about="https://w3id.org/emmo/domain/pm-multiscale#KPointSampling">
        <rdfs:comment xml:lang="en">The Brillouin zone sampling scheme (e.g., Monkhorst-Pack grid). Denser grids give more accurate results but cost more compute time.</rdfs:comment>
        <rdfs:label>KPointSampling</rdfs:label>
        <skos:prefLabel xml:lang="en">KPointSampling</skos:prefLabel>
    </owl:Class>
    


    <!-- https://w3id.org/emmo/domain/pm-multiscale#Kkrgreensfunctionmethod -->


    <owl:Class rdf:about="https://w3id.org/emmo/domain/pm-multiscale#Kkrgreensfunctionmethod">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/emmo/domain/pm-multiscale#hasScaleLevel"/>
                <owl:hasValue rdf:resource="https://w3id.org/emmo/domain/pm-multiscale#Electronicscale"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- https://w3id.org/emmo/domain/pm-multiscale#Kpointresolvedmae -->


    <owl:Class rdf:about="https://w3id.org/emmo/domain/pm-multiscale#Kpointresolvedmae">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/emmo/domain/pm-multiscale#hasScaleLevel"/>
                <owl:hasValue rdf:resource="https://w3id.org/emmo/domain/pm-multiscale#Electronicscale"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- https://w3id.org/emmo/domain/pm-multiscale#KronmüllerEquation -->


    <owl:Class rdf:about="https://w3id.org/emmo/domain/pm-multiscale#KronmüllerEquation">
        <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#MaterialLaw"/>
        <rdfs:comment xml:lang="en">The Kronmüller equation is a semiempirical constitutive expression for coercivity incorporating microstructural factors (α, Deff) to relate intrinsic magnetic properties to macroscopic coercive field; it is an emmo:MaterialLaw linking material parameters to a key permanent magnet performance quantity, and no existing pm: or magmo: class captures this coercivity-microstructure relation.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/domain/pm-multiscale"/>
        <rdfs:label>kronmüller equation</rdfs:label>
        <skos:prefLabel xml:lang="en">kronmüller equation</skos:prefLabel>
    </owl:Class>
    


    <!-- https://w3id.org/emmo/domain/pm-multiscale#L10mnga -->


    <owl:Class rdf:about="https://w3id.org/emmo/domain/pm-multiscale#L10mnga">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/emmo/domain/pm-multiscale#hasProperty"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/emmo/domain/magnetic-material#UniaxialMagnetocrystallineAnisotropy"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- https://w3id.org/emmo/domain/pm-multiscale#Ldaplusdmft -->


    <owl:Class rdf:about="https://w3id.org/emmo/domain/pm-multiscale#Ldaplusdmft">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/emmo/domain/pm-multiscale#hasScaleLevel"/>
                <owl:hasValue rdf:resource="https://w3id.org/emmo/domain/pm-multiscale#Electronicscale"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- https://w3id.org/emmo/domain/pm-multiscale#Ltpmnbi -->


    <owl:Class rdf:about="https://w3id.org/emmo/domain/pm-multiscale#Ltpmnbi">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/emmo/domain/pm-multiscale#hasProperty"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/emmo/domain/magnetic-material#UniaxialMagnetocrystallineAnisotropy"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- https://w3id.org/emmo/domain/pm-multiscale#MagneticAnisotropyConstantK3 -->


    <owl:Class rdf:about="https://w3id.org/emmo/domain/pm-multiscale#MagneticAnisotropyConstantK3">
        <rdfs:subClassOf rdf:resource="https://w3id.org/emmo/domain/magnetic-material#MagnetocrystallineAnisotropyConstantK2"/>
        <rdfs:comment xml:lang="en">K3 is the third-order magnetocrystalline anisotropy constant, a direct higher-order sibling of magmo:MagnetocrystallineAnisotropyConstantK2 and magmo:MagnetocrystallineAnisotropyConstantK1; the ontology has K1 and K2 but lacks K3, making this a genuine gap requiring a new subclass under the same parent.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/domain/pm-multiscale"/>
        <rdfs:label>magnetic anisotropy constant k3</rdfs:label>
        <skos:prefLabel xml:lang="en">magnetic anisotropy constant k3</skos:prefLabel>
    </owl:Class>
    


    <!-- https://w3id.org/emmo/domain/pm-multiscale#MagneticAnisotropyConstantK4 -->


    <owl:Class rdf:about="https://w3id.org/emmo/domain/pm-multiscale#MagneticAnisotropyConstantK4">
        <rdfs:subClassOf rdf:resource="https://w3id.org/emmo/domain/magnetic-material#UniaxialAnisotropyConstant"/>
        <rdfs:comment xml:lang="en">Magnetic anisotropy constant K4 is the fourth-order uniaxial magnetocrystalline anisotropy constant; while magmo:MagnetocrystallineAnisotropyConstantK2 is the closest existing class (second-order), K4 is a distinct higher-order term not currently represented, requiring a new subclass MagnetocrystallineAnisotropyConstantK4 under magmo:UniaxialAnisotropyConstant.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/domain/pm-multiscale"/>
        <rdfs:label>magnetic anisotropy constant k4</rdfs:label>
        <skos:note xml:lang="en">How is the magnetic anisotropy constant K4 computed? — extracted by fitting the torque curve from constrained Monte Carlo simulations</skos:note>
        <skos:prefLabel xml:lang="en">magnetic anisotropy constant k4</skos:prefLabel>
    </owl:Class>
    


    <!-- https://w3id.org/emmo/domain/pm-multiscale#MagneticExchangeCouplingConstant -->


    <owl:Class rdf:about="https://w3id.org/emmo/domain/pm-multiscale#MagneticExchangeCouplingConstant">
        <rdfs:subClassOf rdf:resource="https://w3id.org/emmo/domain/magnetic-material#ExchangeStiffnessConstant"/>
        <rdfs:comment xml:lang="en">The magnetic exchange coupling constant J (pairwise R-Fe, Fe-Fe) is a distinct atomistic quantity from magmo:ExchangeStiffnessConstant (a micromagnetic continuum parameter); no existing magmo: class captures the pairwise Heisenberg exchange parameter, so a new subclass is required under the exchange interaction branch.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/domain/pm-multiscale"/>
        <rdfs:label>magnetic exchange coupling constant</rdfs:label>
        <skos:note xml:lang="en">How is the magnetic exchange coupling constant calculated? — calculated using the Liechtenstein formula</skos:note>
        <skos:prefLabel xml:lang="en">magnetic exchange coupling constant</skos:prefLabel>
    </owl:Class>
    


    <!-- https://w3id.org/emmo/domain/pm-multiscale#MagneticForceTheorem -->


    <owl:Class rdf:about="https://w3id.org/emmo/domain/pm-multiscale#MagneticForceTheorem">
        <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#ElectronicModel"/>
    </owl:Class>
    


    <!-- https://w3id.org/emmo/domain/pm-multiscale#MagneticHardnessParameter -->


    <owl:Class rdf:about="https://w3id.org/emmo/domain/pm-multiscale#MagneticHardnessParameter">
        <rdfs:subClassOf rdf:resource="https://w3id.org/emmo/domain/magnetic-material#ExtrinsicMagneticProperties"/>
        <rdfs:comment xml:lang="en">The magnetic hardness parameter κ = √(K1/μ0Ms²) is a dimensionless figure of merit for hard magnets not represented in magmo:ExtrinsicMagneticProperties or any existing class; a new subclass is needed per the gap criterion.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/domain/pm-multiscale"/>
        <rdfs:label>magnetic hardness parameter</rdfs:label>
        <skos:prefLabel xml:lang="en">magnetic hardness parameter</skos:prefLabel>
    </owl:Class>
    


    <!-- https://w3id.org/emmo/domain/pm-multiscale#MagneticReluctivity -->


    <owl:Class rdf:about="https://w3id.org/emmo/domain/pm-multiscale#MagneticReluctivity">
        <rdfs:subClassOf rdf:resource="https://w3id.org/emmo/domain/magnetic-material#AbsolutePermeability"/>
        <rdfs:comment xml:lang="en">Magnetic reluctivity (ν = 1/μ, units m/H) is the reciprocal of permeability and a distinct quantity used in FEM motor optimization; it is not covered by magmo:AbsolutePermeability but is its logical inverse, requiring a new sibling class under the EMMO Quantity branch for magnetic field-response properties.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/domain/pm-multiscale"/>
        <rdfs:label>magnetic reluctivity</rdfs:label>
        <skos:prefLabel xml:lang="en">magnetic reluctivity</skos:prefLabel>
    </owl:Class>
    


    <!-- https://w3id.org/emmo/domain/pm-multiscale#Magneticexchangeconstant -->


    <owl:Class rdf:about="https://w3id.org/emmo/domain/pm-multiscale#Magneticexchangeconstant">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/emmo/domain/pm-multiscale#hasScaleLevel"/>
                <owl:hasValue rdf:resource="https://w3id.org/emmo/domain/pm-multiscale#Atomisticscale"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- https://w3id.org/emmo/domain/pm-multiscale#Magneticforcetheorem -->


    <owl:Class rdf:about="https://w3id.org/emmo/domain/pm-multiscale#Magneticforcetheorem">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/emmo/domain/pm-multiscale#hasScaleLevel"/>
                <owl:hasValue rdf:resource="https://w3id.org/emmo/domain/pm-multiscale#Electronicscale"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- https://w3id.org/emmo/domain/pm-multiscale#Magneticphase -->


    <owl:Class rdf:about="https://w3id.org/emmo/domain/pm-multiscale#Magneticphase">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/emmo/domain/pm-multiscale#hasProperty"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/emmo/domain/pm-multiscale#TheoreticalEnergyProductLimit"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- https://w3id.org/emmo/domain/pm-multiscale#Magneticsurfaceanisotropy -->


    <owl:Class rdf:about="https://w3id.org/emmo/domain/pm-multiscale#Magneticsurfaceanisotropy">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/emmo/domain/pm-multiscale#hasScaleLevel"/>
                <owl:hasValue rdf:resource="https://w3id.org/emmo/domain/pm-multiscale#Mesoscopicscale"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- https://w3id.org/emmo/domain/pm-multiscale#MagnetizationReversal -->


    <owl:Class rdf:about="https://w3id.org/emmo/domain/pm-multiscale#MagnetizationReversal">
        <rdfs:subClassOf rdf:resource="https://w3id.org/emmo/domain/pm-multiscale#MicromagneticsStep"/>
    </owl:Class>
    


    <!-- https://w3id.org/emmo/domain/pm-multiscale#Magnetizationreversal -->


    <owl:Class rdf:about="https://w3id.org/emmo/domain/pm-multiscale#Magnetizationreversal">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/emmo/domain/pm-multiscale#hasScaleLevel"/>
                <owl:hasValue rdf:resource="https://w3id.org/emmo/domain/pm-multiscale#Mesoscopicscale"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- https://w3id.org/emmo/domain/pm-multiscale#MagnetocrystallineAnisotropyConstantK3 -->


    <owl:Class rdf:about="https://w3id.org/emmo/domain/pm-multiscale#MagnetocrystallineAnisotropyConstantK3">
        <rdfs:subClassOf rdf:resource="https://w3id.org/emmo/domain/magnetic-material#MagnetocrystallineAnisotropyConstantK2"/>
        <rdfs:comment xml:lang="en">K3 is the third-order uniaxial magnetocrystalline anisotropy constant of Nd2Fe14B, a direct higher-order sibling of the existing magmo:MagnetocrystallineAnisotropyConstantK2; no existing magmo: class covers K3, requiring a new class as a sibling under the same parent in the EMMO Quantity branch.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/domain/pm-multiscale"/>
        <rdfs:label>magnetocrystalline anisotropy constant k3</rdfs:label>
        <skos:prefLabel xml:lang="en">magnetocrystalline anisotropy constant k3</skos:prefLabel>
    </owl:Class>
    


    <!-- https://w3id.org/emmo/domain/pm-multiscale#MagnetoelasticAnisotropy -->


    <owl:Class rdf:about="https://w3id.org/emmo/domain/pm-multiscale#MagnetoelasticAnisotropy">
        <rdfs:subClassOf rdf:resource="https://w3id.org/emmo/domain/magnetic-material#MagneticAnisotropy"/>
        <rdfs:comment xml:lang="en">Magnetoelastic anisotropy is a distinct physical mechanism (stress-magnetostriction coupling) not captured by any existing magmo: anisotropy subclass; it requires a new subclass under magmo:MagneticAnisotropy to preserve ontological rigidity of the mechanism.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/domain/pm-multiscale"/>
        <rdfs:label>magnetoelastic anisotropy</rdfs:label>
        <skos:prefLabel xml:lang="en">magnetoelastic anisotropy</skos:prefLabel>
    </owl:Class>
    


    <!-- https://w3id.org/emmo/domain/pm-multiscale#Magnetostriction -->


    <owl:Class rdf:about="https://w3id.org/emmo/domain/pm-multiscale#Magnetostriction">
        <rdfs:subClassOf rdf:resource="https://w3id.org/emmo/domain/magnetic-material#InducedMagneticAnisotropy"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/emmo/domain/pm-multiscale#hasProperty"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/emmo/domain/pm-multiscale#MagnetostrictionConstant"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">Magnetostriction (magnetoelastic coupling coefficient λ) is a distinct intrinsic magnetic quantity not represented by any existing magmo: class; a new subclass under magmo:InducedMagneticAnisotropy (the closest magnetoelastic parent) is required per the gap criterion.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/domain/pm-multiscale"/>
        <rdfs:label>magnetostriction</rdfs:label>
        <skos:prefLabel xml:lang="en">magnetostriction</skos:prefLabel>
    </owl:Class>
    


    <!-- https://w3id.org/emmo/domain/pm-multiscale#MagnetostrictionConstant -->


    <owl:Class rdf:about="https://w3id.org/emmo/domain/pm-multiscale#MagnetostrictionConstant">
        <rdfs:subClassOf rdf:resource="https://w3id.org/emmo/domain/magnetic-material#MagnetocrystallineAnisotropyConstantK1"/>
        <rdfs:comment xml:lang="en">λs is a dimensionless intrinsic material constant quantifying magneto-elastic coupling; no existing magmo: class covers magnetostriction constants, making it a genuine ontology gap requiring a new sibling class alongside magmo:MagnetocrystallineAnisotropyConstantK1 under the intrinsic-property branch.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/domain/pm-multiscale"/>
        <rdfs:label>magnetostriction constant</rdfs:label>
        <skos:prefLabel xml:lang="en">magnetostriction constant</skos:prefLabel>
    </owl:Class>
    


    <!-- https://w3id.org/emmo/domain/pm-multiscale#MeshSpecification -->


    <owl:Class rdf:about="https://w3id.org/emmo/domain/pm-multiscale#MeshSpecification">
        <rdfs:comment xml:lang="en">The spatial discretization for finite element micromagnetics: cell size, element type, and refinement strategy. Cell size must be smaller than the exchange length.</rdfs:comment>
        <rdfs:label>MeshSpecification</rdfs:label>
        <skos:prefLabel xml:lang="en">MeshSpecification</skos:prefLabel>
    </owl:Class>
    


    <!-- https://w3id.org/emmo/domain/pm-multiscale#MicromagneticsConfiguration -->


    <owl:Class rdf:about="https://w3id.org/emmo/domain/pm-multiscale#MicromagneticsConfiguration">
        <rdfs:subClassOf rdf:resource="https://w3id.org/emmo/domain/pm-multiscale#SimulationConfiguration"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/emmo/domain/pm-multiscale#hasMesh"/>
                <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">Configuration for continuum micromagnetics: finite element mesh, cell size, boundary conditions, solver algorithm, and external field sweep parameters.</rdfs:comment>
        <rdfs:label>MicromagneticsConfiguration</rdfs:label>
        <skos:altLabel xml:lang="en">micromagnetic theory</skos:altLabel>
        <skos:prefLabel xml:lang="en">MicromagneticsConfiguration</skos:prefLabel>
    </owl:Class>
    


    <!-- https://w3id.org/emmo/domain/pm-multiscale#MicromagneticsStep -->


    <owl:Class rdf:about="https://w3id.org/emmo/domain/pm-multiscale#MicromagneticsStep">
        <rdfs:subClassOf rdf:resource="https://w3id.org/emmo/domain/pm-multiscale#SimulationStep"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/emmo/domain/pm-multiscale#hasOutputParameter"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/emmo/domain/magnetic-material#CoercivityHc"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/emmo/domain/pm-multiscale#hasOutputParameter"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/emmo/domain/magnetic-material#MaximumEnergyProduct"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/emmo/domain/pm-multiscale#hasOutputParameter"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/emmo/domain/magnetic-material#Remanence"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/emmo/domain/pm-multiscale#hasConfiguration"/>
                <owl:allValuesFrom rdf:resource="https://w3id.org/emmo/domain/pm-multiscale#MicromagneticsConfiguration"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/emmo/domain/pm-multiscale#hasScaleLevel"/>
                <owl:hasValue rdf:resource="https://w3id.org/emmo/domain/pm-multiscale#MesoscopicScale"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">A continuum micromagnetic simulation (e.g., esys-escript, mumax3) that computes extrinsic properties: coercivity Hc, remanence Mr, maximum energy product BHmax, and domain structure.</rdfs:comment>
        <rdfs:label>MicromagneticsStep</rdfs:label>
        <skos:prefLabel xml:lang="en">MicromagneticsStep</skos:prefLabel>
    </owl:Class>
    


    <!-- https://w3id.org/emmo/domain/pm-multiscale#Micromagnetictheory -->


    <owl:Class rdf:about="https://w3id.org/emmo/domain/pm-multiscale#Micromagnetictheory">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/emmo/domain/pm-multiscale#hasScaleLevel"/>
                <owl:hasValue rdf:resource="https://w3id.org/emmo/domain/pm-multiscale#Mesoscopicscale"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- https://w3id.org/emmo/domain/pm-multiscale#MissingParameter -->


    <owl:Class rdf:about="https://w3id.org/emmo/domain/pm-multiscale#MissingParameter">
        <rdfs:comment xml:lang="en">A simulation input parameter required for reproduction but not explicitly stated in the paper. Common examples: exchange stiffness A, damping parameter, mesh details.</rdfs:comment>
        <rdfs:label>MissingParameter</rdfs:label>
        <skos:prefLabel xml:lang="en">MissingParameter</skos:prefLabel>
    </owl:Class>
    


    <!-- https://w3id.org/emmo/domain/pm-multiscale#Mnaltauphase -->


    <owl:Class rdf:about="https://w3id.org/emmo/domain/pm-multiscale#Mnaltauphase">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/emmo/domain/pm-multiscale#hasProperty"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/emmo/domain/magnetic-material#SaturationMagnetization"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- https://w3id.org/emmo/domain/pm-multiscale#Modifiedmagnetocrystallineanisotropyconstant -->


    <owl:Class rdf:about="https://w3id.org/emmo/domain/pm-multiscale#Modifiedmagnetocrystallineanisotropyconstant">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/emmo/domain/pm-multiscale#hasScaleLevel"/>
                <owl:hasValue rdf:resource="https://w3id.org/emmo/domain/pm-multiscale#Mesoscopicscale"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- https://w3id.org/emmo/domain/pm-multiscale#Montecarloalgorithm -->


    <owl:Class rdf:about="https://w3id.org/emmo/domain/pm-multiscale#Montecarloalgorithm">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/emmo/domain/pm-multiscale#hasScaleLevel"/>
                <owl:hasValue rdf:resource="https://w3id.org/emmo/domain/pm-multiscale#Atomisticscale"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- https://w3id.org/emmo/domain/pm-multiscale#Montecarlostep -->


    <owl:Class rdf:about="https://w3id.org/emmo/domain/pm-multiscale#Montecarlostep">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/emmo/domain/pm-multiscale#hasScaleLevel"/>
                <owl:hasValue rdf:resource="https://w3id.org/emmo/domain/pm-multiscale#Atomisticscale"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- https://w3id.org/emmo/domain/pm-multiscale#Muffintinapproximation -->


    <owl:Class rdf:about="https://w3id.org/emmo/domain/pm-multiscale#Muffintinapproximation">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/emmo/domain/pm-multiscale#hasScaleLevel"/>
                <owl:hasValue rdf:resource="https://w3id.org/emmo/domain/pm-multiscale#Electronicscale"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- https://w3id.org/emmo/domain/pm-multiscale#MultiScaleSimulationWorkflow -->


    <owl:Class rdf:about="https://w3id.org/emmo/domain/pm-multiscale#MultiScaleSimulationWorkflow">
        <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#EMMO_64963ed6_39c9_4258_85e0_6466c4b5420c"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#EMMO_7d56ec24_499d_487a_af7d_a91aaa787bfe"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/emmo/domain/pm-multiscale#hasSimulationStep"/>
                <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">2</owl:minCardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">A computational workflow that chains simulation steps across different spatial/temporal scales (e.g., DFT -&gt; spin dynamics -&gt; micromagnetics). Each step produces parameters consumed by the next.</rdfs:comment>
        <rdfs:label>MultiScaleSimulationWorkflow</rdfs:label>
        <skos:prefLabel xml:lang="en">MultiScaleSimulationWorkflow</skos:prefLabel>
    </owl:Class>
    


    <!-- https://w3id.org/emmo/domain/pm-multiscale#Nanocomposite -->


    <owl:Class rdf:about="https://w3id.org/emmo/domain/pm-multiscale#Nanocomposite">
        <rdfs:subClassOf rdf:resource="https://w3id.org/emmo/domain/magnetic-material#CrystallineMagneticMaterial"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/emmo/domain/pm-multiscale#hasScaleLevel"/>
                <owl:hasValue rdf:resource="https://w3id.org/emmo/domain/pm-multiscale#Mesoscopicscale"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">A nanocomposite hard/soft two-phase magnet is a rigid, sortal material class central to PM multi-scale simulation; it is not expressible as any single existing magmo: class (it combines hard and soft phases at nanoscale), so a new subclass under magmo:CrystallineMagneticMaterial is required.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/domain/pm-multiscale"/>
        <rdfs:label>nanocomposite</rdfs:label>
        <skos:prefLabel xml:lang="en">nanocomposite</skos:prefLabel>
    </owl:Class>
    


    <!-- https://w3id.org/emmo/domain/pm-multiscale#Nanocrystallinemicrostructure -->


    <owl:Class rdf:about="https://w3id.org/emmo/domain/pm-multiscale#Nanocrystallinemicrostructure">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/emmo/domain/pm-multiscale#hasScaleLevel"/>
                <owl:hasValue rdf:resource="https://w3id.org/emmo/domain/pm-multiscale#Mesoscopicscale"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- https://w3id.org/emmo/domain/pm-multiscale#Nd2fe14b -->


    <owl:Class rdf:about="https://w3id.org/emmo/domain/pm-multiscale#Nd2fe14b">
        <rdfs:subClassOf rdf:resource="http://org.semanticweb.owlapi/error#Error2"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/emmo/domain/pm-multiscale#hasProperty"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/emmo/domain/pm-multiscale#MagnetocrystallineAnisotropyConstantK3"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- https://w3id.org/emmo/domain/pm-multiscale#NdFeB -->


    <owl:Class rdf:about="https://w3id.org/emmo/domain/pm-multiscale#NdFeB">
        <rdfs:subClassOf rdf:resource="https://w3id.org/emmo/domain/pm-multiscale#HardMagnet"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/emmo/domain/pm-multiscale#hasPart"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/emmo/domain/magnetic-material#GrainBoundaryPhase"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/emmo/domain/pm-multiscale#hasProperty"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/emmo/domain/pm-multiscale#CurieTemperature"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">Neodymium-iron-boron (Nd2Fe14B) and its variants (with Dy, Tb substitution). Highest room-temperature BHmax (~400 kJ/m3) among all permanent magnets.</rdfs:comment>
        <rdfs:label>NdFeB</rdfs:label>
        <skos:prefLabel xml:lang="en">NdFeB</skos:prefLabel>
    </owl:Class>
    


    <!-- https://w3id.org/emmo/domain/pm-multiscale#NoncollinearCalculation -->


    <owl:Class rdf:about="https://w3id.org/emmo/domain/pm-multiscale#NoncollinearCalculation">
        <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#Computation"/>
        <rdfs:comment xml:lang="en">Noncollinear calculation is a DFT computational configuration that allows arbitrary spin orientations, required for accurate magnetocrystalline anisotropy computation in permanent magnets; it is a sub-method of pm:DFTStep not currently represented as a distinct class, warranting a new subclass under emmo:Computation.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/domain/pm-multiscale"/>
        <rdfs:label>noncollinear calculation</rdfs:label>
        <skos:note xml:lang="en">What is a noncollinear calculation used for? — required for accurate computation of magnetic anisotropy energy</skos:note>
        <skos:prefLabel xml:lang="en">noncollinear calculation</skos:prefLabel>
    </owl:Class>
    


    <!-- https://w3id.org/emmo/domain/pm-multiscale#Noncollinearmagneticcalculation -->


    <owl:Class rdf:about="https://w3id.org/emmo/domain/pm-multiscale#Noncollinearmagneticcalculation">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/emmo/domain/pm-multiscale#hasScaleLevel"/>
                <owl:hasValue rdf:resource="https://w3id.org/emmo/domain/pm-multiscale#Electronicscale"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- https://w3id.org/emmo/domain/pm-multiscale#Noncollinearspincalculation -->


    <owl:Class rdf:about="https://w3id.org/emmo/domain/pm-multiscale#Noncollinearspincalculation">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/emmo/domain/pm-multiscale#hasScaleLevel"/>
                <owl:hasValue rdf:resource="https://w3id.org/emmo/domain/pm-multiscale#Electronicscale"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- https://w3id.org/emmo/domain/pm-multiscale#Onetofivephase -->


    <owl:Class rdf:about="https://w3id.org/emmo/domain/pm-multiscale#Onetofivephase">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/emmo/domain/pm-multiscale#hasProperty"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/emmo/domain/magnetic-material#MagnetocrystallineAnisotropy"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- https://w3id.org/emmo/domain/pm-multiscale#Orbitalmagnetization -->


    <owl:Class rdf:about="https://w3id.org/emmo/domain/pm-multiscale#Orbitalmagnetization">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/emmo/domain/pm-multiscale#hasScaleLevel"/>
                <owl:hasValue rdf:resource="https://w3id.org/emmo/domain/pm-multiscale#Electronicscale"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- https://w3id.org/emmo/domain/pm-multiscale#Organicsemiconductorlayer -->


    <owl:Class rdf:about="https://w3id.org/emmo/domain/pm-multiscale#Organicsemiconductorlayer">
        <rdfs:subClassOf rdf:resource="http://org.semanticweb.owlapi/error#Error3"/>
    </owl:Class>
    


    <!-- https://w3id.org/emmo/domain/pm-multiscale#ParameterHandoff -->


    <owl:Class rdf:about="https://w3id.org/emmo/domain/pm-multiscale#ParameterHandoff">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/emmo/domain/pm-multiscale#transfersParameter"/>
                <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minCardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/emmo/domain/pm-multiscale#fromStep"/>
                <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/emmo/domain/pm-multiscale#toStep"/>
                <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">The transfer of computed parameter values from an upstream simulation step to a downstream step. Example: DFT-computed exchange integrals (Jij) passed to spin dynamics as Heisenberg Hamiltonian input.</rdfs:comment>
        <rdfs:label>ParameterHandoff</rdfs:label>
        <skos:prefLabel xml:lang="en">ParameterHandoff</skos:prefLabel>
    </owl:Class>
    


    <!-- https://w3id.org/emmo/domain/pm-multiscale#PermanentMagnetMaterial -->


    <owl:Class rdf:about="https://w3id.org/emmo/domain/pm-multiscale#PermanentMagnetMaterial">
        <rdfs:subClassOf rdf:resource="https://w3id.org/emmo/domain/magnetic-material#MagneticMaterial"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/emmo/domain/pm-multiscale#hasProperty"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/emmo/domain/magnetic-material#AnisotropyField"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/emmo/domain/pm-multiscale#hasProperty"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/emmo/domain/magnetic-material#CoercivityHc"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/emmo/domain/pm-multiscale#hasProperty"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/emmo/domain/magnetic-material#ExchangeStiffnessConstant"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/emmo/domain/pm-multiscale#hasProperty"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/emmo/domain/magnetic-material#MagnetocrystallineAnisotropyConstantK1"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/emmo/domain/pm-multiscale#hasProperty"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/emmo/domain/magnetic-material#MaximumEnergyProduct"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/emmo/domain/pm-multiscale#hasProperty"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/emmo/domain/magnetic-material#Remanence"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/emmo/domain/pm-multiscale#hasProperty"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/emmo/domain/magnetic-material#SaturationMagnetization"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/emmo/domain/pm-multiscale#hasProperty"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/emmo/domain/pm-multiscale#CurieTemperature"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <owl:disjointWith rdf:resource="https://w3id.org/emmo/domain/pm-multiscale#SoftMagnet"/>
        <rdfs:comment xml:lang="en">A magnetic material that retains magnetization after removal of an external field, characterized by high coercivity and remanence. Subclass of MagMO MagneticMaterial.</rdfs:comment>
        <rdfs:label>PermanentMagnetMaterial</rdfs:label>
        <skos:altLabel xml:lang="en">exchange-coupled nanocomposite permanent magnet</skos:altLabel>
        <skos:altLabel xml:lang="en">exchange-spring permanent magnet</skos:altLabel>
        <skos:altLabel xml:lang="en">spring exchange magnet</skos:altLabel>
        <skos:prefLabel xml:lang="en">PermanentMagnetMaterial</skos:prefLabel>
    </owl:Class>
    


    <!-- https://w3id.org/emmo/domain/pm-multiscale#Phase217 -->


    <owl:Class rdf:about="https://w3id.org/emmo/domain/pm-multiscale#Phase217">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/emmo/domain/pm-multiscale#hasProperty"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/emmo/domain/magnetic-material#MagnetocrystallineAnisotropy"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/emmo/domain/pm-multiscale#hasProperty"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/emmo/domain/magnetic-material#SaturationMagnetization"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- https://w3id.org/emmo/domain/pm-multiscale#PreisachModel -->


    <owl:Class rdf:about="https://w3id.org/emmo/domain/pm-multiscale#PreisachModel">
        <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#MaterialsModel"/>
        <rdfs:comment xml:lang="en">The Preisach model is a classical phenomenological hysteresis model based on bistable magnetic units with a distribution function, used to describe macroscopic hysteresis loops in permanent magnets; it is an emmo:MaterialsModel at the continuum/phenomenological level, and no existing pm: class represents hysteresis distribution models.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/domain/pm-multiscale"/>
        <rdfs:label>preisach model</rdfs:label>
        <skos:note xml:lang="en">What is the Preisach model used for? — A classical model of hysteresis based on bistable magnetic units with a fixed distribution function</skos:note>
        <skos:prefLabel xml:lang="en">preisach model</skos:prefLabel>
    </owl:Class>
    


    <!-- https://w3id.org/emmo/domain/pm-multiscale#PropertyDetermination -->


    <owl:Class rdf:about="https://w3id.org/emmo/domain/pm-multiscale#PropertyDetermination">
        <owl:equivalentClass>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/emmo/domain/pm-multiscale#ComputationalDetermination"/>
                    <rdf:Description rdf:about="https://w3id.org/emmo/domain/pm-multiscale#ExperimentalDetermination"/>
                </owl:unionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:comment xml:lang="en">How a property value was obtained: computationally (DFT, micromagnetics, ML) or experimentally (VSM, SQUID, PPMS).</rdfs:comment>
        <rdfs:label>PropertyDetermination</rdfs:label>
        <skos:prefLabel xml:lang="en">PropertyDetermination</skos:prefLabel>
    </owl:Class>
    


    <!-- https://w3id.org/emmo/domain/pm-multiscale#PropertyPrediction -->


    <owl:Class rdf:about="https://w3id.org/emmo/domain/pm-multiscale#PropertyPrediction">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/emmo/domain/pm-multiscale#fromInputProperty"/>
                <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minCardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/emmo/domain/pm-multiscale#predictsProperty"/>
                <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minCardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">A machine-learning prediction of extrinsic magnetic properties (Hc, Mr, BHmax) from intrinsic parameters (Ms, A, K1). Example: mammos-ai Random Forest models.</rdfs:comment>
        <rdfs:label>PropertyPrediction</rdfs:label>
        <skos:prefLabel xml:lang="en">PropertyPrediction</skos:prefLabel>
    </owl:Class>
    


    <!-- https://w3id.org/emmo/domain/pm-multiscale#PropertySource -->


    <owl:Class rdf:about="https://w3id.org/emmo/domain/pm-multiscale#PropertySource">
        <owl:equivalentClass>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/emmo/domain/pm-multiscale#FigureSource"/>
                    <rdf:Description rdf:about="https://w3id.org/emmo/domain/pm-multiscale#TableSource"/>
                    <rdf:Description rdf:about="https://w3id.org/emmo/domain/pm-multiscale#TextSource"/>
                </owl:unionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:comment xml:lang="en">Where in a publication a property value is found: running text, a table cell, or extracted from a figure.</rdfs:comment>
        <rdfs:label>PropertySource</rdfs:label>
        <skos:prefLabel xml:lang="en">PropertySource</skos:prefLabel>
    </owl:Class>
    


    <!-- https://w3id.org/emmo/domain/pm-multiscale#PropertySynonym -->


    <owl:Class rdf:about="https://w3id.org/emmo/domain/pm-multiscale#PropertySynonym">
        <rdfs:comment xml:lang="en">An alternative name or symbol for a magnetic property used in the literature. Example: coercivity appears as Hc, Hci, iHc, jHc, or BHc.</rdfs:comment>
        <rdfs:label>PropertySynonym</rdfs:label>
        <skos:prefLabel xml:lang="en">PropertySynonym</skos:prefLabel>
    </owl:Class>
    


    <!-- https://w3id.org/emmo/domain/pm-multiscale#RandomAnisotropyModel -->


    <owl:Class rdf:about="https://w3id.org/emmo/domain/pm-multiscale#RandomAnisotropyModel">
        <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#ContinuumModel"/>
        <rdfs:comment xml:lang="en">The random anisotropy model is a continuum-level theoretical framework describing how spatially disordered anisotropy axes are averaged by exchange interactions in nanocrystalline magnets; it fits emmo:ContinuumModel because it operates at the mesoscale/continuum level, and no existing pm: class captures this microstructural averaging model.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/domain/pm-multiscale"/>
        <rdfs:label>random anisotropy model</rdfs:label>
        <skos:prefLabel xml:lang="en">random anisotropy model</skos:prefLabel>
    </owl:Class>
    


    <!-- https://w3id.org/emmo/domain/pm-multiscale#Randomanisotropymodel -->


    <owl:Class rdf:about="https://w3id.org/emmo/domain/pm-multiscale#Randomanisotropymodel">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/emmo/domain/pm-multiscale#hasScaleLevel"/>
                <owl:hasValue rdf:resource="https://w3id.org/emmo/domain/pm-multiscale#Mesoscopicscale"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- https://w3id.org/emmo/domain/pm-multiscale#Rareearthsite -->


    <owl:Class rdf:about="https://w3id.org/emmo/domain/pm-multiscale#Rareearthsite">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/emmo/domain/pm-multiscale#hasProperty"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/emmo/domain/pm-multiscale#SingleIonAnisotropyEnergy"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- https://w3id.org/emmo/domain/pm-multiscale#RemanenceEnhancement -->


    <owl:Class rdf:about="https://w3id.org/emmo/domain/pm-multiscale#RemanenceEnhancement">
        <rdfs:subClassOf rdf:resource="https://w3id.org/emmo/domain/magnetic-material#Remanence"/>
        <rdfs:comment xml:lang="en">Remanence enhancement is a distinct phenomenon (exchange-coupling-driven increase above Stoner-Wohlfarth limit) not captured by magmo:Remanence alone; a new subclass under magmo:Remanence is needed per the ontological gap criterion.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/domain/pm-multiscale"/>
        <rdfs:label>remanence enhancement</rdfs:label>
        <skos:prefLabel xml:lang="en">remanence enhancement</skos:prefLabel>
    </owl:Class>
    


    <!-- https://w3id.org/emmo/domain/pm-multiscale#ReportedPropertyValue -->


    <owl:Class rdf:about="https://w3id.org/emmo/domain/pm-multiscale#ReportedPropertyValue">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/emmo/domain/pm-multiscale#forMaterial"/>
                <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/emmo/domain/pm-multiscale#forProperty"/>
                <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/emmo/domain/pm-multiscale#reportedInPublication"/>
                <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/emmo/domain/pm-multiscale#numericValue"/>
                <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">A specific magnetic property value as reported in a paper, with its context: material, method, temperature, unit, and location in the paper.</rdfs:comment>
        <rdfs:label>ReportedPropertyValue</rdfs:label>
        <skos:prefLabel xml:lang="en">ReportedPropertyValue</skos:prefLabel>
    </owl:Class>
    


    <!-- https://w3id.org/emmo/domain/pm-multiscale#ReproducibilityAssessment -->


    <owl:Class rdf:about="https://w3id.org/emmo/domain/pm-multiscale#ReproducibilityAssessment">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/emmo/domain/pm-multiscale#reproducibilityScore"/>
                <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">An evaluation of whether a paper reports sufficient parameters to reproduce its computational results. Score 0-1 based on completeness of inputs.</rdfs:comment>
        <rdfs:label>ReproducibilityAssessment</rdfs:label>
        <skos:prefLabel xml:lang="en">ReproducibilityAssessment</skos:prefLabel>
    </owl:Class>
    


    <!-- https://w3id.org/emmo/domain/pm-multiscale#ResearchGroup -->


    <owl:Class rdf:about="https://w3id.org/emmo/domain/pm-multiscale#ResearchGroup">
        <rdfs:comment xml:lang="en">The research group or institution that performed the study. Enables tracking which groups produce comparable results.</rdfs:comment>
        <rdfs:label>ResearchGroup</rdfs:label>
        <skos:prefLabel xml:lang="en">ResearchGroup</skos:prefLabel>
    </owl:Class>
    


    <!-- https://w3id.org/emmo/domain/pm-multiscale#ScaleBridgingAssumption -->


    <owl:Class rdf:about="https://w3id.org/emmo/domain/pm-multiscale#ScaleBridgingAssumption">
        <rdfs:comment xml:lang="en">A physical assumption that justifies mapping parameters between scales. Example: mean-field approximation connecting DFT exchange integrals to the atomistic Heisenberg Hamiltonian.</rdfs:comment>
        <rdfs:label>ScaleBridgingAssumption</rdfs:label>
        <skos:prefLabel xml:lang="en">ScaleBridgingAssumption</skos:prefLabel>
    </owl:Class>
    


    <!-- https://w3id.org/emmo/domain/pm-multiscale#ScaleLevel -->


    <owl:Class rdf:about="https://w3id.org/emmo/domain/pm-multiscale#ScaleLevel">
        <rdfs:comment xml:lang="en">The characteristic spatial and temporal scale at which a simulation operates: electronic (angstrom/femtosecond), atomistic (nanometer/picosecond), or mesoscopic (micrometer/nanosecond).</rdfs:comment>
        <rdfs:label>ScaleLevel</rdfs:label>
        <skos:prefLabel xml:lang="en">ScaleLevel</skos:prefLabel>
    </owl:Class>
    


    <!-- https://w3id.org/emmo/domain/pm-multiscale#ScientificPublication -->


    <owl:Class rdf:about="https://w3id.org/emmo/domain/pm-multiscale#ScientificPublication">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/emmo/domain/pm-multiscale#doi"/>
                <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">A published paper reporting computational or experimental results on magnetic materials. Identified by DOI.</rdfs:comment>
        <rdfs:label>ScientificPublication</rdfs:label>
        <skos:prefLabel xml:lang="en">ScientificPublication</skos:prefLabel>
    </owl:Class>
    


    <!-- https://w3id.org/emmo/domain/pm-multiscale#Secondvariationalapproach -->


    <owl:Class rdf:about="https://w3id.org/emmo/domain/pm-multiscale#Secondvariationalapproach">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/emmo/domain/pm-multiscale#hasScaleLevel"/>
                <owl:hasValue rdf:resource="https://w3id.org/emmo/domain/pm-multiscale#Electronicscale"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- https://w3id.org/emmo/domain/pm-multiscale#Selfconsistentfieldcalculation -->


    <owl:Class rdf:about="https://w3id.org/emmo/domain/pm-multiscale#Selfconsistentfieldcalculation">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/emmo/domain/pm-multiscale#hasScaleLevel"/>
                <owl:hasValue rdf:resource="https://w3id.org/emmo/domain/pm-multiscale#Electronicscale"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- https://w3id.org/emmo/domain/pm-multiscale#SimulationApproximation -->


    <owl:Class rdf:about="https://w3id.org/emmo/domain/pm-multiscale#SimulationApproximation">
        <rdfs:comment xml:lang="en">A simplification used in a paper&apos;s calculation: coherent rotation, single-domain approximation, neglect of thermal fluctuations, collinear spin assumption.</rdfs:comment>
        <rdfs:label>SimulationApproximation</rdfs:label>
        <skos:altLabel xml:lang="en">coherent-potential approximation</skos:altLabel>
        <skos:prefLabel xml:lang="en">SimulationApproximation</skos:prefLabel>
    </owl:Class>
    


    <!-- https://w3id.org/emmo/domain/pm-multiscale#SimulationConfiguration -->


    <owl:Class rdf:about="https://w3id.org/emmo/domain/pm-multiscale#SimulationConfiguration">
        <rdfs:comment xml:lang="en">The complete set of computational settings for a simulation step: software version, numerical parameters, boundary conditions, and convergence criteria.</rdfs:comment>
        <rdfs:label>SimulationConfiguration</rdfs:label>
        <skos:prefLabel xml:lang="en">SimulationConfiguration</skos:prefLabel>
    </owl:Class>
    


    <!-- https://w3id.org/emmo/domain/pm-multiscale#SimulationStep -->


    <owl:Class rdf:about="https://w3id.org/emmo/domain/pm-multiscale#SimulationStep">
        <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#EMMO_4299e344_a321_4ef2_a744_bacfcce80afc"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/emmo/domain/pm-multiscale#hasScaleLevel"/>
                <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">A single computational step in a multi-scale workflow, operating at a specific scale. Examples: a VASP DFT run, an UppASD temperature sweep, an esys-escript hysteresis loop calculation.</rdfs:comment>
        <rdfs:label>SimulationStep</rdfs:label>
        <skos:altLabel xml:lang="en">monte carlo step</skos:altLabel>
        <skos:altLabel xml:lang="en">monte carlo steps</skos:altLabel>
        <skos:prefLabel xml:lang="en">SimulationStep</skos:prefLabel>
    </owl:Class>
    


    <!-- https://w3id.org/emmo/domain/pm-multiscale#SingleIonAnisotropyEnergy -->


    <owl:Class rdf:about="https://w3id.org/emmo/domain/pm-multiscale#SingleIonAnisotropyEnergy">
        <rdfs:subClassOf rdf:resource="https://w3id.org/emmo/domain/magnetic-material#MagnetocrystallineAnisotropyEnergy"/>
        <rdfs:comment xml:lang="en">Single-ion anisotropy energy is the site-resolved classical anisotropy energy at a rare-earth site computed from crystal-field and Stevens coefficients; it is a precursor to the macroscopic magmo:MagnetocrystallineAnisotropyEnergy but operates at the single-ion scale not currently represented, requiring a new subclass.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/domain/pm-multiscale"/>
        <rdfs:label>single-ion anisotropy energy</rdfs:label>
        <skos:prefLabel xml:lang="en">single-ion anisotropy energy</skos:prefLabel>
    </owl:Class>
    


    <!-- https://w3id.org/emmo/domain/pm-multiscale#Singleionanisotropyenergy -->


    <owl:Class rdf:about="https://w3id.org/emmo/domain/pm-multiscale#Singleionanisotropyenergy">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/emmo/domain/pm-multiscale#hasScaleLevel"/>
                <owl:hasValue rdf:resource="https://w3id.org/emmo/domain/pm-multiscale#Atomisticscale"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- https://w3id.org/emmo/domain/pm-multiscale#SoftMagnet -->


    <owl:Class rdf:about="https://w3id.org/emmo/domain/pm-multiscale#SoftMagnet">
        <rdfs:subClassOf rdf:resource="https://w3id.org/emmo/domain/magnetic-material#MagneticMaterial"/>
        <rdfs:comment xml:lang="en">A magnetic material with low coercivity, easily magnetized and demagnetized. Used in transformers, inductors, and electromagnetic shielding. Disjoint with HardMagnet.</rdfs:comment>
        <rdfs:label>SoftMagnet</rdfs:label>
        <skos:prefLabel xml:lang="en">SoftMagnet</skos:prefLabel>
    </owl:Class>
    


    <!-- https://w3id.org/emmo/domain/pm-multiscale#SolverAlgorithm -->


    <owl:Class rdf:about="https://w3id.org/emmo/domain/pm-multiscale#SolverAlgorithm">
        <rdfs:comment xml:lang="en">The numerical algorithm used to solve governing equations: conjugate gradient, Runge-Kutta, implicit Euler, etc.</rdfs:comment>
        <rdfs:label>SolverAlgorithm</rdfs:label>
        <skos:prefLabel xml:lang="en">SolverAlgorithm</skos:prefLabel>
    </owl:Class>
    


    <!-- https://w3id.org/emmo/domain/pm-multiscale#SpinDynamicsConfiguration -->


    <owl:Class rdf:about="https://w3id.org/emmo/domain/pm-multiscale#SpinDynamicsConfiguration">
        <rdfs:subClassOf rdf:resource="https://w3id.org/emmo/domain/pm-multiscale#SimulationConfiguration"/>
        <rdfs:comment xml:lang="en">Configuration for atomistic spin dynamics: simulation temperature range, Gilbert damping parameter, time step, and number of Monte Carlo / Langevin dynamics steps.</rdfs:comment>
        <rdfs:label>SpinDynamicsConfiguration</rdfs:label>
        <skos:altLabel xml:lang="en">damping parameter</skos:altLabel>
        <skos:altLabel xml:lang="en">gilbert damping</skos:altLabel>
        <skos:altLabel xml:lang="en">heisenberg spin hamiltonian</skos:altLabel>
        <skos:altLabel xml:lang="en">heisenberg spin model</skos:altLabel>
        <skos:altLabel xml:lang="en">spin hamiltonian</skos:altLabel>
        <skos:altLabel xml:lang="en">spin heisenberg hamiltonian</skos:altLabel>
        <skos:altLabel xml:lang="en">stochastic landau-lifshitz equation</skos:altLabel>
        <skos:prefLabel xml:lang="en">SpinDynamicsConfiguration</skos:prefLabel>
    </owl:Class>
    


    <!-- https://w3id.org/emmo/domain/pm-multiscale#SpinDynamicsStep -->


    <owl:Class rdf:about="https://w3id.org/emmo/domain/pm-multiscale#SpinDynamicsStep">
        <rdfs:subClassOf rdf:resource="https://w3id.org/emmo/domain/pm-multiscale#SimulationStep"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/emmo/domain/pm-multiscale#hasOutputParameter"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/emmo/domain/pm-multiscale#CurieTemperature"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/emmo/domain/pm-multiscale#hasConfiguration"/>
                <owl:allValuesFrom rdf:resource="https://w3id.org/emmo/domain/pm-multiscale#SpinDynamicsConfiguration"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/emmo/domain/pm-multiscale#hasScaleLevel"/>
                <owl:hasValue rdf:resource="https://w3id.org/emmo/domain/pm-multiscale#AtomisticScale"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">An atomistic spin dynamics simulation (e.g., UppASD) that computes temperature-dependent magnetic properties: magnetization M(T), Curie temperature Tc, and temperature-dependent anisotropy K(T).</rdfs:comment>
        <rdfs:label>SpinDynamicsStep</rdfs:label>
        <skos:altLabel xml:lang="en">stochastic landau-lifshitz-gilbert</skos:altLabel>
        <skos:prefLabel xml:lang="en">SpinDynamicsStep</skos:prefLabel>
    </owl:Class>
    


    <!-- https://w3id.org/emmo/domain/pm-multiscale#Spinhamiltonian -->


    <owl:Class rdf:about="https://w3id.org/emmo/domain/pm-multiscale#Spinhamiltonian">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/emmo/domain/pm-multiscale#hasScaleLevel"/>
                <owl:hasValue rdf:resource="https://w3id.org/emmo/domain/pm-multiscale#Atomisticscale"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- https://w3id.org/emmo/domain/pm-multiscale#Spinheisenberghamiltonian -->


    <owl:Class rdf:about="https://w3id.org/emmo/domain/pm-multiscale#Spinheisenberghamiltonian">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/emmo/domain/pm-multiscale#hasScaleLevel"/>
