                           owl:someValuesFrom <https://w3id.org/emmo/domain/magnetic-material#UniaxialMagnetocrystallineAnisotropy>
                         ] .


###  https://w3id.org/emmo/domain/pm-multiscale#MagneticAnisotropyConstantK3
:MagneticAnisotropyConstantK3 rdf:type owl:Class ;
                              rdfs:subClassOf <https://w3id.org/emmo/domain/magnetic-material#MagnetocrystallineAnisotropyConstantK2> ;
                              rdfs:comment "K3 is the third-order magnetocrystalline anisotropy constant, a direct higher-order sibling of magmo:MagnetocrystallineAnisotropyConstantK2 and magmo:MagnetocrystallineAnisotropyConstantK1; the ontology has K1 and K2 but lacks K3, making this a genuine gap requiring a new subclass under the same parent."@en ;
                              rdfs:isDefinedBy <https://w3id.org/emmo/domain/pm-multiscale> ;
                              rdfs:label "magnetic anisotropy constant k3" ;
                              <http://www.w3.org/2004/02/skos/core#prefLabel> "magnetic anisotropy constant k3"@en .


###  https://w3id.org/emmo/domain/pm-multiscale#MagneticAnisotropyConstantK4
:MagneticAnisotropyConstantK4 rdf:type owl:Class ;
                              rdfs:subClassOf <https://w3id.org/emmo/domain/magnetic-material#UniaxialAnisotropyConstant> ;
                              rdfs:comment "Magnetic anisotropy constant K4 is the fourth-order uniaxial magnetocrystalline anisotropy constant; while magmo:MagnetocrystallineAnisotropyConstantK2 is the closest existing class (second-order), K4 is a distinct higher-order term not currently represented, requiring a new subclass MagnetocrystallineAnisotropyConstantK4 under magmo:UniaxialAnisotropyConstant."@en ;
                              rdfs:isDefinedBy <https://w3id.org/emmo/domain/pm-multiscale> ;
                              rdfs:label "magnetic anisotropy constant k4" ;
                              <http://www.w3.org/2004/02/skos/core#note> "How is the magnetic anisotropy constant K4 computed? — extracted by fitting the torque curve from constrained Monte Carlo simulations"@en ;
                              <http://www.w3.org/2004/02/skos/core#prefLabel> "magnetic anisotropy constant k4"@en .


###  https://w3id.org/emmo/domain/pm-multiscale#MagneticExchangeCouplingConstant
:MagneticExchangeCouplingConstant rdf:type owl:Class ;
                                  rdfs:subClassOf <https://w3id.org/emmo/domain/magnetic-material#ExchangeStiffnessConstant> ;
                                  rdfs:comment "The magnetic exchange coupling constant J (pairwise R-Fe, Fe-Fe) is a distinct atomistic quantity from magmo:ExchangeStiffnessConstant (a micromagnetic continuum parameter); no existing magmo: class captures the pairwise Heisenberg exchange parameter, so a new subclass is required under the exchange interaction branch."@en ;
                                  rdfs:isDefinedBy <https://w3id.org/emmo/domain/pm-multiscale> ;
                                  rdfs:label "magnetic exchange coupling constant" ;
                                  <http://www.w3.org/2004/02/skos/core#note> "How is the magnetic exchange coupling constant calculated? — calculated using the Liechtenstein formula"@en ;
                                  <http://www.w3.org/2004/02/skos/core#prefLabel> "magnetic exchange coupling constant"@en .


###  https://w3id.org/emmo/domain/pm-multiscale#MagneticForceTheorem
:MagneticForceTheorem rdf:type owl:Class ;
                      rdfs:subClassOf <https://w3id.org/emmo#ElectronicModel> .


###  https://w3id.org/emmo/domain/pm-multiscale#MagneticHardnessParameter
:MagneticHardnessParameter rdf:type owl:Class ;
                           rdfs:subClassOf <https://w3id.org/emmo/domain/magnetic-material#ExtrinsicMagneticProperties> ;
                           rdfs:comment "The magnetic hardness parameter κ = √(K1/μ0Ms²) is a dimensionless figure of merit for hard magnets not represented in magmo:ExtrinsicMagneticProperties or any existing class; a new subclass is needed per the gap criterion."@en ;
                           rdfs:isDefinedBy <https://w3id.org/emmo/domain/pm-multiscale> ;
                           rdfs:label "magnetic hardness parameter" ;
                           <http://www.w3.org/2004/02/skos/core#prefLabel> "magnetic hardness parameter"@en .


###  https://w3id.org/emmo/domain/pm-multiscale#MagneticReluctivity
:MagneticReluctivity rdf:type owl:Class ;
                     rdfs:subClassOf <https://w3id.org/emmo/domain/magnetic-material#AbsolutePermeability> ;
                     rdfs:comment "Magnetic reluctivity (ν = 1/μ, units m/H) is the reciprocal of permeability and a distinct quantity used in FEM motor optimization; it is not covered by magmo:AbsolutePermeability but is its logical inverse, requiring a new sibling class under the EMMO Quantity branch for magnetic field-response properties."@en ;
                     rdfs:isDefinedBy <https://w3id.org/emmo/domain/pm-multiscale> ;
                     rdfs:label "magnetic reluctivity" ;
                     <http://www.w3.org/2004/02/skos/core#prefLabel> "magnetic reluctivity"@en .


###  https://w3id.org/emmo/domain/pm-multiscale#Magneticexchangeconstant
:Magneticexchangeconstant rdf:type owl:Class ;
                          rdfs:subClassOf [ rdf:type owl:Restriction ;
                                            owl:onProperty :hasScaleLevel ;
                                            owl:hasValue :Atomisticscale
                                          ] .


###  https://w3id.org/emmo/domain/pm-multiscale#Magneticforcetheorem
:Magneticforcetheorem rdf:type owl:Class ;
                      rdfs:subClassOf [ rdf:type owl:Restriction ;
                                        owl:onProperty :hasScaleLevel ;
                                        owl:hasValue :Electronicscale
                                      ] .


