  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "A property value extracted from running text in a publication."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "TextSource"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/emmo/domain/pm-multiscale#PropertySource"
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "TextSource"
  } ]
}, {
  "@id" : "https://w3id.org/emmo/domain/pm-multiscale#TheoreticalEnergyProductLimit",
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.w3.org/2002/07/owl#Class"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Theoretical energy product limit is a derived upper-bound quantity distinct from the measured magmo:MaximumEnergyProduct; it requires a new subclass under magmo:MaximumEnergyProduct to represent the theoretically computed ceiling value assuming ideal microstructure."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/emmo/domain/pm-multiscale"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "theoretical energy product limit"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/emmo/domain/magnetic-material#MaximumEnergyProduct"
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "theoretical energy product limit"
  } ]
}, {
  "@id" : "https://w3id.org/emmo/domain/pm-multiscale#TwistGrainBoundary",
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.w3.org/2002/07/owl#Class"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "A twist grain boundary (basal-plane boundary between c-axis aligned grains, weak pinning centre) is a rigid, sortal subtype of grain boundary not captured by any existing magmo: annotation on magmo:GrainBoundaryPhase; a new subclass is required to distinguish it from tilt and general grain boundaries."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/emmo/domain/pm-multiscale"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "twist grain boundary"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/emmo/domain/magnetic-material#GrainBoundaryPhase"
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "twist grain boundary"
  } ]
}, {
  "@id" : "https://w3id.org/emmo/domain/pm-multiscale#TwoSublatticeMeanFieldModel",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.w3.org/2002/07/owl#Class"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "The two-sublattice mean-field model describes RE-TM magnetic coupling via molecular field coefficients and is directly used to compute temperature-dependent magnetisation in PM materials; it is IN_SCOPE and a GAP because emmo:AtomisticModel has no sub-class for sublattice mean-field exchange models."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/emmo/domain/pm-multiscale"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "two-sublattice mean field model"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/emmo#AtomisticModel"
  } ],
  "http://www.w3.org/2004/02/skos/core#note" : [ {
    "@language" : "en",
    "@value" : "What is the two-sublattice mean field model used for? — A model describing magnetic coupling between rare earth and transition metal sublattices"
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "two-sublattice mean field model"
  } ],
  "https://w3id.org/emmo/domain/pm-multiscale#hasScaleLevel" : [ {
    "@id" : "https://w3id.org/emmo/domain/pm-multiscale#AtomisticScale"
  } ]
}, {
  "@id" : "https://w3id.org/emmo/domain/pm-multiscale#TwoSublatticeMicromagneticModel",
  "http://www.w3.org/2004/02/skos/core#note" : [ {
    "@language" : "en",
    "@value" : "What is the two-sublattice micromagnetic model used for? — to describe the magnetic excitation spectrum including acoustic, optic, and crystal-field modes"
  } ]
}, {
  "@id" : "https://w3id.org/emmo/domain/pm-multiscale#Twosublatticemicromagneticmodel",
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.w3.org/2002/07/owl#Class"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "_:genid138"
  } ]
}, {
  "@id" : "https://w3id.org/emmo/domain/pm-multiscale#UniaxialCrystalStructure",
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.w3.org/2002/07/owl#Class"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "A uniaxial crystal structure is a specialisation of magmo:CrystalStructure distinguished by hexagonal/tetragonal/rhombohedral symmetry and a unique easy-axis; no existing class in the 3-tier ontology captures this symmetry-plus-anisotropy combination, so a new subclass under magmo:CrystalStructure is required."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/emmo/domain/pm-multiscale"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "uniaxial crystal structure"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/emmo/domain/magnetic-material#CrystalStructure"
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "uniaxial crystal structure"
  } ]
}, {
  "@id" : "https://w3id.org/emmo/domain/pm-multiscale#VacuumPermeability",
  "http://www.w3.org/2004/02/skos/core#note" : [ {
    "@language" : "en",
    "@value" : "What is vacuum permeability used for? — used as a fundamental constant in the magnetic equations"
  } ]
}, {
  "@id" : "https://w3id.org/emmo/domain/pm-multiscale#VibratingSampleMagnetometer",
  "http://www.w3.org/2004/02/skos/core#note" : [ {
    "@language" : "en",
    "@value" : "How is magnetization measured as a function of applied field and temperature? — An instrument (VSM) used to measure magnetization as a function of applied field and temperature"
  } ]
}, {
  "@id" : "https://w3id.org/emmo/domain/pm-multiscale#ZeemanEnergyDensity",
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.w3.org/2002/07/owl#Class"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Zeeman energy density is a distinct micromagnetic energy density term (-μ₀Ms·H) not expressible by any existing magmo: class; magmo:MagnetocrystallineAnisotropyEnergy is the closest structural analogue as a volumetric magnetic energy density, satisfying the GAP criterion for a new subclass in M3_Material."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/emmo/domain/pm-multiscale"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "zeeman energy density"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/emmo/domain/magnetic-material#MagnetocrystallineAnisotropyEnergy"
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "zeeman energy density"
  } ]
}, {
  "@id" : "https://w3id.org/emmo/domain/pm-multiscale#atTemperature",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty" ],
