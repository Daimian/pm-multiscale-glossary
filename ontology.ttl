@prefix : <https://w3id.org/emmo/domain/pm-multiscale#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <https://w3id.org/emmo/domain/pm-multiscale#> .

<https://w3id.org/emmo/domain/pm-multiscale> rdf:type owl:Ontology ;
                                              owl:versionIRI <https://w3id.org/emmo/domain/pm-multiscale/0.1.0> ;
                                              owl:imports <https://w3id.org/emmo/1.0.3/disciplines/models> ,
                                                          <https://w3id.org/emmo/1.0.3/reference/workflow> ,
                                                          <https://w3id.org/emmo/domain/magnetic-material/1.0.0> ;
                                              <http://purl.org/dc/terms/abstract> "An EMMO domain ontology for multi-scale computational simulation of permanent magnetic materials, covering DFT through spin dynamics to micromagnetics, with support for literature annotation and reproducibility assessment."@en ;
                                              <http://purl.org/dc/terms/created> "2026-05-22"^^xsd:date ;
                                              <http://purl.org/dc/terms/creator> "Generated via NEON-GPT methodology, validated L1-L4" ;
                                              <http://purl.org/dc/terms/license> "https://creativecommons.org/licenses/by/4.0/legalcode" ;
                                              <http://purl.org/dc/terms/title> "Permanent Magnet Multi-Scale Simulation Ontology"@en ;
                                              rdfs:comment "v2.0.0 — CQ-driven enrichment, self-checked, ABox cleaned, strict filtered. Removed SmCo/Ferrite/AlNiCo (no-pattern leaf classes). Updated 2026-05-30."@en ;
                                              owl:versionInfo "2.0.0" .

#################################################################
#    Annotation properties
#################################################################

###  http://purl.org/dc/terms/created
<http://purl.org/dc/terms/created> rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2004/02/skos/core#note
<http://www.w3.org/2004/02/skos/core#note> rdf:type owl:AnnotationProperty .


#################################################################
#    Datatypes
#################################################################

###  http://www.w3.org/2001/XMLSchema#date
xsd:date rdf:type rdfs:Datatype .


###  http://www.w3.org/2001/XMLSchema#gYear
xsd:gYear rdf:type rdfs:Datatype .


#################################################################
#    Object Properties
#################################################################

###  https://w3id.org/emmo/domain/pm-multiscale#canRunInParallelWith
:canRunInParallelWith rdf:type owl:ObjectProperty ,
                               owl:SymmetricProperty ;
                      rdfs:domain :SimulationStep ;
                      rdfs:range :SimulationStep ;
                      rdfs:comment "Indicates two steps have no data dependency and can execute concurrently. Symmetric: if A can run in parallel with B, then B can run in parallel with A."@en ;
                      <http://www.w3.org/2004/02/skos/core#prefLabel> "canRunInParallelWith"@en .


###  https://w3id.org/emmo/domain/pm-multiscale#cites
:cites rdf:type owl:ObjectProperty ;
       rdfs:domain :ScientificPublication ;
       rdfs:range :ScientificPublication ;
       <http://www.w3.org/2004/02/skos/core#prefLabel> "cites"@en .


###  https://w3id.org/emmo/domain/pm-multiscale#constrains
:constrains rdf:type owl:ObjectProperty ;
            rdfs:domain owl:Thing ;
            rdfs:range owl:Thing ;
            rdfs:label "constrains" .


###  https://w3id.org/emmo/domain/pm-multiscale#evaluatedAt
:evaluatedAt rdf:type owl:ObjectProperty ;
             rdfs:domain owl:Thing ;
             rdfs:range owl:Thing ;
             rdfs:label "evaluatedAt" .


###  https://w3id.org/emmo/domain/pm-multiscale#forMaterial
:forMaterial rdf:type owl:ObjectProperty ,
                      owl:FunctionalProperty ;
             rdfs:domain :ReportedPropertyValue ;
             rdfs:range <https://w3id.org/emmo/domain/magnetic-material#MagneticMaterial> ;
             <http://www.w3.org/2004/02/skos/core#prefLabel> "forMaterial"@en .


###  https://w3id.org/emmo/domain/pm-multiscale#forProperty
:forProperty rdf:type owl:ObjectProperty ,
                      owl:FunctionalProperty ;
             rdfs:domain :ReportedPropertyValue ;
             rdfs:range owl:Class ;
             <http://www.w3.org/2004/02/skos/core#prefLabel> "forProperty"@en .


###  https://w3id.org/emmo/domain/pm-multiscale#fromInputProperty
:fromInputProperty rdf:type owl:ObjectProperty ;
                   rdfs:domain :PropertyPrediction ;
                   rdfs:range owl:Class ;
                   <http://www.w3.org/2004/02/skos/core#prefLabel> "fromInputProperty"@en .


###  https://w3id.org/emmo/domain/pm-multiscale#fromStep
:fromStep rdf:type owl:ObjectProperty ,
                   owl:FunctionalProperty ;
          rdfs:domain :ParameterHandoff ;
          rdfs:range :SimulationStep ;
          rdfs:comment "The upstream simulation step that produced the parameter being handed off."@en ;
          <http://www.w3.org/2004/02/skos/core#prefLabel> "fromStep"@en .


###  https://w3id.org/emmo/domain/pm-multiscale#hasBasisSet
:hasBasisSet rdf:type owl:ObjectProperty ;
             rdfs:domain :DFTConfiguration ;
             rdfs:range :BasisSetSpecification ;
             <http://www.w3.org/2004/02/skos/core#prefLabel> "hasBasisSet"@en .


###  https://w3id.org/emmo/domain/pm-multiscale#hasBoundaryCondition
:hasBoundaryCondition rdf:type owl:ObjectProperty ;
                      rdfs:domain :SimulationConfiguration ;
                      rdfs:range :BoundaryCondition ;
                      <http://www.w3.org/2004/02/skos/core#prefLabel> "hasBoundaryCondition"@en .


###  https://w3id.org/emmo/domain/pm-multiscale#hasComputationalMethod
:hasComputationalMethod rdf:type owl:ObjectProperty ;
                        rdfs:domain :ReportedPropertyValue ;
                        rdfs:range :SimulationStep ;
                        <http://www.w3.org/2004/02/skos/core#prefLabel> "hasComputationalMethod"@en .


###  https://w3id.org/emmo/domain/pm-multiscale#hasConfiguration
:hasConfiguration rdf:type owl:ObjectProperty ;
                  rdfs:domain :SimulationStep ;
                  rdfs:range :SimulationConfiguration ;
                  <http://www.w3.org/2004/02/skos/core#prefLabel> "hasConfiguration"@en .


###  https://w3id.org/emmo/domain/pm-multiscale#hasConvergenceCriterion
:hasConvergenceCriterion rdf:type owl:ObjectProperty ;
                         rdfs:domain :SimulationConfiguration ;
                         rdfs:range :ConvergenceCriterion ;
                         <http://www.w3.org/2004/02/skos/core#prefLabel> "hasConvergenceCriterion"@en .


###  https://w3id.org/emmo/domain/pm-multiscale#hasDataRepository
:hasDataRepository rdf:type owl:ObjectProperty ;
                   rdfs:domain <https://w3id.org/emmo/domain/magnetic-material#MagneticMaterial> ;
                   rdfs:range :DataRepository ;
                   <http://www.w3.org/2004/02/skos/core#prefLabel> "hasDataRepository"@en .


###  https://w3id.org/emmo/domain/pm-multiscale#hasDetermination
:hasDetermination rdf:type owl:ObjectProperty ;
                  rdfs:domain :TemperatureDependentProperty ;
                  rdfs:range :PropertyDetermination ;
                  <http://www.w3.org/2004/02/skos/core#prefLabel> "hasDetermination"@en .


###  https://w3id.org/emmo/domain/pm-multiscale#hasEMMOMapping
:hasEMMOMapping rdf:type owl:ObjectProperty ;
                rdfs:domain owl:Class ;
                rdfs:range owl:Class ;
                <http://www.w3.org/2004/02/skos/core#prefLabel> "hasEMMOMapping"@en .


###  https://w3id.org/emmo/domain/pm-multiscale#hasExchangeCorrelationFunctional
:hasExchangeCorrelationFunctional rdf:type owl:ObjectProperty ,
                                           owl:FunctionalProperty ;
                                  rdfs:domain :DFTConfiguration ;
                                  rdfs:range :ExchangeCorrelationFunctional ;
                                  <http://www.w3.org/2004/02/skos/core#prefLabel> "hasExchangeCorrelationFunctional"@en .


###  https://w3id.org/emmo/domain/pm-multiscale#hasExperimentalValidation
:hasExperimentalValidation rdf:type owl:ObjectProperty ;
                           rdfs:domain :SimulationStep ;
                           rdfs:range :ExperimentalValidation ;
                           <http://www.w3.org/2004/02/skos/core#prefLabel> "hasExperimentalValidation"@en .


###  https://w3id.org/emmo/domain/pm-multiscale#hasInputParameter
:hasInputParameter rdf:type owl:ObjectProperty ;
                   rdfs:domain :SimulationStep ;
                   rdfs:range <https://w3id.org/emmo#EMMO_909a0a36_2242_4a8c_a5e1_3fa6e9b42f10> ;
                   rdfs:comment "Relates a simulation step to a physical quantity (e.g., Ms, K1) it requires as input."@en ;
                   <http://www.w3.org/2004/02/skos/core#prefLabel> "hasInputParameter"@en .


###  https://w3id.org/emmo/domain/pm-multiscale#hasKPointSampling
:hasKPointSampling rdf:type owl:ObjectProperty ;
                   rdfs:domain :DFTConfiguration ;
                   rdfs:range :KPointSampling ;
                   <http://www.w3.org/2004/02/skos/core#prefLabel> "hasKPointSampling"@en .


###  https://w3id.org/emmo/domain/pm-multiscale#hasMaterial
:hasMaterial rdf:type owl:ObjectProperty ;
             rdfs:domain :SimulationStep ;
             rdfs:range <https://w3id.org/emmo/domain/magnetic-material#MagneticMaterial> ;
             <http://www.w3.org/2004/02/skos/core#prefLabel> "hasMaterial"@en .


###  https://w3id.org/emmo/domain/pm-multiscale#hasMesh
:hasMesh rdf:type owl:ObjectProperty ,
                  owl:FunctionalProperty ;
         rdfs:domain :MicromagneticsConfiguration ;
         rdfs:range :MeshSpecification ;
         <http://www.w3.org/2004/02/skos/core#prefLabel> "hasMesh"@en .


###  https://w3id.org/emmo/domain/pm-multiscale#hasMissingParameter
:hasMissingParameter rdf:type owl:ObjectProperty ;
                     rdfs:domain :ReproducibilityAssessment ;
                     rdfs:range :MissingParameter ;
                     <http://www.w3.org/2004/02/skos/core#prefLabel> "hasMissingParameter"@en .


###  https://w3id.org/emmo/domain/pm-multiscale#hasNextStep
:hasNextStep rdf:type owl:ObjectProperty ,
                      owl:TransitiveProperty ;
             rdfs:domain :SimulationStep ;
             rdfs:range :SimulationStep ;
             rdfs:comment "Relates a simulation step to the next step in the execution chain. Transitive: if A->B->C, then A indirectly leads to C."@en ;
             <http://www.w3.org/2004/02/skos/core#prefLabel> "hasNextStep"@en .


###  https://w3id.org/emmo/domain/pm-multiscale#hasOutputParameter
:hasOutputParameter rdf:type owl:ObjectProperty ;
                    rdfs:domain :SimulationStep ;
                    rdfs:range <https://w3id.org/emmo#EMMO_909a0a36_2242_4a8c_a5e1_3fa6e9b42f10> ;
                    rdfs:comment "Relates a simulation step to a physical quantity it produces as output."@en ;
                    <http://www.w3.org/2004/02/skos/core#prefLabel> "hasOutputParameter"@en .


###  https://w3id.org/emmo/domain/pm-multiscale#hasParameterHandoff
:hasParameterHandoff rdf:type owl:ObjectProperty ;
                     rdfs:domain :MultiScaleSimulationWorkflow ;
                     rdfs:range :ParameterHandoff ;
                     <http://www.w3.org/2004/02/skos/core#prefLabel> "hasParameterHandoff"@en .


###  https://w3id.org/emmo/domain/pm-multiscale#hasPart
:hasPart rdf:type owl:ObjectProperty ;
         rdfs:domain owl:Thing ;
         rdfs:range owl:Thing ;
         rdfs:label "hasPart" .


###  https://w3id.org/emmo/domain/pm-multiscale#hasPredictionModel
:hasPredictionModel rdf:type owl:ObjectProperty ;
                    rdfs:domain :PropertyPrediction ;
                    rdfs:range <https://w3id.org/emmo#EMMO_8d4962d7_9608_44f7_a2f1_82a4bb173f4a> ;
                    <http://www.w3.org/2004/02/skos/core#prefLabel> "hasPredictionModel"@en .


###  https://w3id.org/emmo/domain/pm-multiscale#hasPreviousStep
:hasPreviousStep rdf:type owl:ObjectProperty ;
                 owl:inverseOf :hasNextStep ;
                 rdfs:domain :SimulationStep ;
                 rdfs:range :SimulationStep ;
                 <http://www.w3.org/2004/02/skos/core#prefLabel> "hasPreviousStep"@en .


###  https://w3id.org/emmo/domain/pm-multiscale#hasProperty
:hasProperty rdf:type owl:ObjectProperty ;
             rdfs:domain :PermanentMagnetMaterial ;
             rdfs:range owl:Thing ;
             rdfs:label "hasProperty" .


###  https://w3id.org/emmo/domain/pm-multiscale#hasPropertySource
:hasPropertySource rdf:type owl:ObjectProperty ;
                   rdfs:domain :ReportedPropertyValue ;
                   rdfs:range :PropertySource ;
                   <http://www.w3.org/2004/02/skos/core#prefLabel> "hasPropertySource"@en .


###  https://w3id.org/emmo/domain/pm-multiscale#hasReproducibilityAssessment
:hasReproducibilityAssessment rdf:type owl:ObjectProperty ;
                              rdfs:domain :ScientificPublication ;
                              rdfs:range :ReproducibilityAssessment ;
                              <http://www.w3.org/2004/02/skos/core#prefLabel> "hasReproducibilityAssessment"@en .


###  https://w3id.org/emmo/domain/pm-multiscale#hasScaleBridgingAssumption
:hasScaleBridgingAssumption rdf:type owl:ObjectProperty ;
                            rdfs:domain :ParameterHandoff ;
                            rdfs:range :ScaleBridgingAssumption ;
                            rdfs:comment "The physical assumption justifying parameter mapping across scales in a handoff."@en ;
                            <http://www.w3.org/2004/02/skos/core#prefLabel> "hasScaleBridgingAssumption"@en .


###  https://w3id.org/emmo/domain/pm-multiscale#hasScaleLevel
:hasScaleLevel rdf:type owl:ObjectProperty ,
                        owl:FunctionalProperty ;
               rdfs:domain :SimulationStep ;
               rdfs:range :ScaleLevel ;
               rdfs:comment "The spatial/temporal scale at which a simulation step operates. Functional: each step operates at exactly one scale."@en ;
               <http://www.w3.org/2004/02/skos/core#prefLabel> "hasScaleLevel"@en .


###  https://w3id.org/emmo/domain/pm-multiscale#hasSimulationStep
:hasSimulationStep rdf:type owl:ObjectProperty ;
                   rdfs:subPropertyOf <https://w3id.org/emmo#EMMO_70da982d_1810_4b01_9630_a28e216ecd9a> ;
                   rdfs:domain :MultiScaleSimulationWorkflow ;
                   rdfs:range :SimulationStep ;
                   rdfs:comment "Relates a multi-scale workflow to one of its constituent simulation steps."@en ;
                   <http://www.w3.org/2004/02/skos/core#prefLabel> "hasSimulationStep"@en .


###  https://w3id.org/emmo/domain/pm-multiscale#hasSolver
:hasSolver rdf:type owl:ObjectProperty ;
           rdfs:domain :SimulationConfiguration ;
           rdfs:range :SolverAlgorithm ;
           <http://www.w3.org/2004/02/skos/core#prefLabel> "hasSolver"@en .


###  https://w3id.org/emmo/domain/pm-multiscale#hasStatus
:hasStatus rdf:type owl:ObjectProperty ,
                    owl:FunctionalProperty ;
           rdfs:domain :SimulationStep ;
           rdfs:range :StepStatus ;
           <http://www.w3.org/2004/02/skos/core#prefLabel> "hasStatus"@en .


###  https://w3id.org/emmo/domain/pm-multiscale#hasSynonym
:hasSynonym rdf:type owl:ObjectProperty ;
            rdfs:domain owl:Class ;
            rdfs:range :PropertySynonym ;
            <http://www.w3.org/2004/02/skos/core#prefLabel> "hasSynonym"@en .


###  https://w3id.org/emmo/domain/pm-multiscale#isCitedBy
:isCitedBy rdf:type owl:ObjectProperty ;
           owl:inverseOf :cites ;
           rdfs:domain :ScientificPublication ;
           rdfs:range :ScientificPublication ;
           <http://www.w3.org/2004/02/skos/core#prefLabel> "isCitedBy"@en .


###  https://w3id.org/emmo/domain/pm-multiscale#isConfigurationOf
:isConfigurationOf rdf:type owl:ObjectProperty ;
                   owl:inverseOf :hasConfiguration ;
                   rdfs:domain :SimulationConfiguration ;
                   rdfs:range :SimulationStep ;
                   <http://www.w3.org/2004/02/skos/core#prefLabel> "isConfigurationOf"@en .


###  https://w3id.org/emmo/domain/pm-multiscale#isDerivedFrom
:isDerivedFrom rdf:type owl:ObjectProperty ;
               rdfs:domain :PermanentMagnetMaterial ;
               rdfs:range owl:Thing ;
               rdfs:label "isDerivedFrom" .


###  https://w3id.org/emmo/domain/pm-multiscale#isInputTo
:isInputTo rdf:type owl:ObjectProperty ;
           owl:inverseOf :hasInputParameter ;
           rdfs:domain <https://w3id.org/emmo#EMMO_909a0a36_2242_4a8c_a5e1_3fa6e9b42f10> ;
           rdfs:range :SimulationStep ;
           <http://www.w3.org/2004/02/skos/core#prefLabel> "isInputTo"@en .


###  https://w3id.org/emmo/domain/pm-multiscale#isMaterialOf
:isMaterialOf rdf:type owl:ObjectProperty ;
              owl:inverseOf :hasMaterial ;
              rdfs:domain <https://w3id.org/emmo/domain/magnetic-material#MagneticMaterial> ;
              rdfs:range :SimulationStep ;
              <http://www.w3.org/2004/02/skos/core#prefLabel> "isMaterialOf"@en .


###  https://w3id.org/emmo/domain/pm-multiscale#isOutputOf
:isOutputOf rdf:type owl:ObjectProperty ;
            owl:inverseOf :hasOutputParameter ;
            rdfs:domain <https://w3id.org/emmo#EMMO_909a0a36_2242_4a8c_a5e1_3fa6e9b42f10> ;
            rdfs:range :SimulationStep ;
            <http://www.w3.org/2004/02/skos/core#prefLabel> "isOutputOf"@en .


###  https://w3id.org/emmo/domain/pm-multiscale#isPerformerOf
:isPerformerOf rdf:type owl:ObjectProperty ;
               owl:inverseOf :performedBy ;
               rdfs:domain :ResearchGroup ;
               rdfs:range :ScientificPublication ;
               <http://www.w3.org/2004/02/skos/core#prefLabel> "isPerformerOf"@en .


###  https://w3id.org/emmo/domain/pm-multiscale#isSoftwareUsedBy
:isSoftwareUsedBy rdf:type owl:ObjectProperty ;
                  owl:inverseOf :usesSoftware ;
                  rdfs:domain <https://w3id.org/emmo#EMMO_8d4962d7_9608_44f7_a2f1_82a4bb173f4a> ;
                  rdfs:range :SimulationStep ;
                  <http://www.w3.org/2004/02/skos/core#prefLabel> "isSoftwareUsedBy"@en .


###  https://w3id.org/emmo/domain/pm-multiscale#isStepOf
:isStepOf rdf:type owl:ObjectProperty ;
          owl:inverseOf :hasSimulationStep ;
          rdfs:domain :SimulationStep ;
          rdfs:range :MultiScaleSimulationWorkflow ;
          <http://www.w3.org/2004/02/skos/core#prefLabel> "isStepOf"@en .


###  https://w3id.org/emmo/domain/pm-multiscale#performedBy
:performedBy rdf:type owl:ObjectProperty ;
             rdfs:domain :ScientificPublication ;
             rdfs:range :ResearchGroup ;
             <http://www.w3.org/2004/02/skos/core#prefLabel> "performedBy"@en .


###  https://w3id.org/emmo/domain/pm-multiscale#predictsProperty
:predictsProperty rdf:type owl:ObjectProperty ;
                  rdfs:domain :PropertyPrediction ;
                  rdfs:range owl:Class ;
                  <http://www.w3.org/2004/02/skos/core#prefLabel> "predictsProperty"@en .


###  https://w3id.org/emmo/domain/pm-multiscale#reportedInPublication
:reportedInPublication rdf:type owl:ObjectProperty ,
                                owl:FunctionalProperty ;
                       rdfs:domain :ReportedPropertyValue ;
                       rdfs:range :ScientificPublication ;
                       <http://www.w3.org/2004/02/skos/core#prefLabel> "reportedInPublication"@en .


###  https://w3id.org/emmo/domain/pm-multiscale#reportsInputParameter
:reportsInputParameter rdf:type owl:ObjectProperty ;
                       rdfs:domain :ScientificPublication ;
                       rdfs:range <https://w3id.org/emmo#EMMO_909a0a36_2242_4a8c_a5e1_3fa6e9b42f10> ;
                       <http://www.w3.org/2004/02/skos/core#prefLabel> "reportsInputParameter"@en .


###  https://w3id.org/emmo/domain/pm-multiscale#reportsSimulationStep
:reportsSimulationStep rdf:type owl:ObjectProperty ;
                       rdfs:domain :ScientificPublication ;
                       rdfs:range :SimulationStep ;
                       <http://www.w3.org/2004/02/skos/core#prefLabel> "reportsSimulationStep"@en .


###  https://w3id.org/emmo/domain/pm-multiscale#reportsValue
:reportsValue rdf:type owl:ObjectProperty ;
              owl:inverseOf :reportedInPublication ;
              rdfs:domain :ScientificPublication ;
              rdfs:range :ReportedPropertyValue ;
              <http://www.w3.org/2004/02/skos/core#prefLabel> "reportsValue"@en .


###  https://w3id.org/emmo/domain/pm-multiscale#toStep
:toStep rdf:type owl:ObjectProperty ,
                 owl:FunctionalProperty ;
        rdfs:domain :ParameterHandoff ;
        rdfs:range :SimulationStep ;
        rdfs:comment "The downstream simulation step that receives the parameter being handed off."@en ;
        <http://www.w3.org/2004/02/skos/core#prefLabel> "toStep"@en .


###  https://w3id.org/emmo/domain/pm-multiscale#transfersParameter
:transfersParameter rdf:type owl:ObjectProperty ;
                    rdfs:domain :ParameterHandoff ;
                    rdfs:range <https://w3id.org/emmo#EMMO_909a0a36_2242_4a8c_a5e1_3fa6e9b42f10> ;
                    rdfs:comment "The physical quantity (e.g., exchange stiffness A, Curie temperature Tc) being transferred between steps."@en ;
                    <http://www.w3.org/2004/02/skos/core#prefLabel> "transfersParameter"@en .


###  https://w3id.org/emmo/domain/pm-multiscale#usesApproximation
:usesApproximation rdf:type owl:ObjectProperty ;
                   rdfs:domain :ReportedPropertyValue ;
                   rdfs:range :SimulationApproximation ;
                   <http://www.w3.org/2004/02/skos/core#prefLabel> "usesApproximation"@en .


###  https://w3id.org/emmo/domain/pm-multiscale#usesSoftware
:usesSoftware rdf:type owl:ObjectProperty ;
              rdfs:domain :SimulationStep ;
              rdfs:range <https://w3id.org/emmo#EMMO_8d4962d7_9608_44f7_a2f1_82a4bb173f4a> ;
              <http://www.w3.org/2004/02/skos/core#prefLabel> "usesSoftware"@en .


#################################################################
#    Data properties
#################################################################

###  https://w3id.org/emmo/domain/pm-multiscale#atTemperature
:atTemperature rdf:type owl:DatatypeProperty ;
               rdfs:domain :TemperatureDependentProperty ;
               rdfs:range xsd:float ;
               <http://www.w3.org/2004/02/skos/core#prefLabel> "atTemperature"@en .


###  https://w3id.org/emmo/domain/pm-multiscale#cellSize
:cellSize rdf:type owl:DatatypeProperty ;
          rdfs:domain :MeshSpecification ;
          rdfs:range xsd:float ;
          <http://www.w3.org/2004/02/skos/core#prefLabel> "cellSize"@en .


###  https://w3id.org/emmo/domain/pm-multiscale#chemicalComposition
:chemicalComposition rdf:type owl:DatatypeProperty ;
                     rdfs:domain <https://w3id.org/emmo/domain/magnetic-material#MagneticMaterial> ;
                     rdfs:range xsd:string ;
                     <http://www.w3.org/2004/02/skos/core#prefLabel> "chemicalComposition"@en .


###  https://w3id.org/emmo/domain/pm-multiscale#convergenceThreshold
:convergenceThreshold rdf:type owl:DatatypeProperty ;
                      rdfs:domain :ConvergenceCriterion ;
                      rdfs:range xsd:float ;
                      <http://www.w3.org/2004/02/skos/core#prefLabel> "convergenceThreshold"@en .


###  https://w3id.org/emmo/domain/pm-multiscale#cutoffEnergy
:cutoffEnergy rdf:type owl:DatatypeProperty ;
              rdfs:domain :BasisSetSpecification ;
              rdfs:range xsd:float ;
              <http://www.w3.org/2004/02/skos/core#prefLabel> "cutoffEnergy"@en .


###  https://w3id.org/emmo/domain/pm-multiscale#dampingParameter
:dampingParameter rdf:type owl:DatatypeProperty ;
                  rdfs:domain :SpinDynamicsConfiguration ;
                  rdfs:range xsd:float ;
                  <http://www.w3.org/2004/02/skos/core#prefLabel> "dampingParameter"@en .


###  https://w3id.org/emmo/domain/pm-multiscale#doi
:doi rdf:type owl:DatatypeProperty ,
