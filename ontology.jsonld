  } ]
}, {
  "@id" : "https://w3id.org/emmo/domain/pm-multiscale#BondedMagnet",
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.w3.org/2002/07/owl#Class"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "A bonded magnet is a composite permanent magnet form (powder in polymer/metallic binder) directly relevant to pm-multiscale simulation targets; it is a distinct subtype of magmo:BulkMagnet not currently represented as a named class in the ontology."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/emmo/domain/pm-multiscale"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "bonded magnet"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/emmo/domain/magnetic-material#BulkMagnet"
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "bonded magnet"
  } ]
}, {
