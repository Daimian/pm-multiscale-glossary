  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "The Cahn-Hilliard equation is a continuum PDE governing conserved concentration-field evolution in phase-field solidification models for PM microstructure formation; it is IN_SCOPE as a continuum model component and a GAP because no existing pm: class covers phase-field PDE formulations."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/emmo/domain/pm-multiscale"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "cahn-hilliard equation"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/emmo#ContinuumModel"
  } ],
  "http://www.w3.org/2004/02/skos/core#note" : [ {
    "@language" : "en",
    "@value" : "What does the Cahn-Hilliard equation govern? — governing the conserved concentration field evolution during solidification in the CF-MPF model"
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "cahn-hilliard equation"
  } ]
}, {
  "@id" : "https://w3id.org/emmo/domain/pm-multiscale#Cahnhilliardequation",
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.w3.org/2002/07/owl#Class"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "_:genid10"
  } ]
}, {
  "@id" : "https://w3id.org/emmo/domain/pm-multiscale#Chargeselfconsistency",
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.w3.org/2002/07/owl#Class"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "_:genid11"
  } ]
}, {
  "@id" : "https://w3id.org/emmo/domain/pm-multiscale#ClassicalHeisenbergModel",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.w3.org/2002/07/owl#Class"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "The classical Heisenberg model is an atomistic spin Hamiltonian parameterized by exchange coupling constants Jij used to compute Curie temperature; it is a canonical emmo:AtomisticModel for spin-lattice simulations, and no existing pm: class represents this Hamiltonian model."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/emmo/domain/pm-multiscale"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "classical heisenberg model"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/emmo#AtomisticModel"
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "classical heisenberg model"
  } ],
  "https://w3id.org/emmo/domain/pm-multiscale#hasScaleLevel" : [ {
    "@id" : "https://w3id.org/emmo/domain/pm-multiscale#AtomisticScale"
  } ]
}, {
  "@id" : "https://w3id.org/emmo/domain/pm-multiscale#Classicalheisenbergmodel",
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.w3.org/2002/07/owl#Class"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "_:genid12"
  } ]
}, {
  "@id" : "https://w3id.org/emmo/domain/pm-multiscale#CoherentPotentialApproximation",
  "http://www.w3.org/2004/02/skos/core#note" : [ {
    "@language" : "en",
    "@value" : "How are electronic and magnetic properties of disordered alloys computed? — effective medium theory used to compute electronic and magnetic properties of disordered alloys by replacing the random potential with an effective coherent potential"
  } ]
}, {
  "@id" : "https://w3id.org/emmo/domain/pm-multiscale#Coherentpotentialapproximation",
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.w3.org/2002/07/owl#Class"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "_:genid13"
  } ]
}, {
  "@id" : "https://w3id.org/emmo/domain/pm-multiscale#ColumnarGrains",
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.w3.org/2002/07/owl#Class"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Columnar grains are a rigid, sortal morphological subtype of magmo:Grain (elongated, film-perpendicular orientation) not distinguished by any existing magmo: annotation; they require a new subclass under magmo:Grain to capture their pinning-site role in thin-film PM microstructure."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/emmo/domain/pm-multiscale"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "columnar grains"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/emmo/domain/magnetic-material#Grain"
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "columnar grains"
  } ]
}, {
  "@id" : "https://w3id.org/emmo/domain/pm-multiscale#ComputationalDetermination",
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.w3.org/2002/07/owl#Class"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "A property value obtained through computational simulation: DFT, spin dynamics, micromagnetics, or machine-learning prediction."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "ComputationalDetermination"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/emmo/domain/pm-multiscale#PropertyDetermination"
  } ],
  "http://www.w3.org/2002/07/owl#disjointWith" : [ {
    "@id" : "https://w3id.org/emmo/domain/pm-multiscale#ExperimentalDetermination"
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "ComputationalDetermination"
  } ]
}, {
  "@id" : "https://w3id.org/emmo/domain/pm-multiscale#ContinuumApproximation",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/emmo/domain/pm-multiscale#ScaleBridgingAssumption"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Maps discrete atomistic spin configurations to continuous magnetization field M(r), valid when domain features are much larger than atomic spacing."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "Continuum approximation"
  } ]
}, {
  "@id" : "https://w3id.org/emmo/domain/pm-multiscale#Converged",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/emmo/domain/pm-multiscale#StepStatus"
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "Converged"
  } ]
}, {
  "@id" : "https://w3id.org/emmo/domain/pm-multiscale#ConvergenceCriterion",
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.w3.org/2002/07/owl#Class"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "The threshold for declaring a simulation converged: energy difference, force residual, or magnetization change between iterations."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "ConvergenceCriterion"
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "ConvergenceCriterion"
  } ]
}, {
  "@id" : "https://w3id.org/emmo/domain/pm-multiscale#CrystalFieldCoefficient",
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.w3.org/2002/07/owl#Class"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Crystal field coefficient A_lm<r^l> is an atomic-scale parameter used to compute magnetocrystalline anisotropy via Stevens operators; it is a sub-concept of the anisotropy hierarchy but not expressible by any existing magmo: class, requiring a new subclass under magmo:MagnetocrystallineAnisotropy."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/emmo/domain/pm-multiscale"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "crystal field coefficient"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/emmo/domain/magnetic-material#MagnetocrystallineAnisotropy"
  } ],
  "http://www.w3.org/2004/02/skos/core#note" : [ {
    "@language" : "en",
    "@value" : "What is the crystal field coefficient used to compute? — used to compute magnetocrystalline anisotropy via Stevens operator formalism"
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "crystal field coefficient"
  } ]
}, {
  "@id" : "https://w3id.org/emmo/domain/pm-multiscale#CrystalFieldTheory",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.w3.org/2002/07/owl#Class"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Crystal field theory is a quantum-mechanical framework computing electrostatic interactions between rare-earth 4f electrons and the surrounding crystal lattice, directly relevant to magnetocrystalline anisotropy in permanent magnets; it is an emmo:ElectronicModel, and no existing pm: class captures this ligand-field approach."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/emmo/domain/pm-multiscale"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "crystal field theory"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/emmo#ElectronicModel"
  } ],
  "http://www.w3.org/2004/02/skos/core#note" : [ {
    "@language" : "en",
    "@value" : "How is crystal field theory computed? — using point charge model to calculate the electrostatic interaction between rare-earth ion 4f electrons and surrounding crystal environment"
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "crystal field theory"
  } ],
  "https://w3id.org/emmo/domain/pm-multiscale#hasScaleLevel" : [ {
    "@id" : "https://w3id.org/emmo/domain/pm-multiscale#ElectronicScale"
  } ]
}, {
  "@id" : "https://w3id.org/emmo/domain/pm-multiscale#Crystalfieldtheory",
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.w3.org/2002/07/owl#Class"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "_:genid14"
  } ]
}, {
  "@id" : "https://w3id.org/emmo/domain/pm-multiscale#CrystallographicSite",
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.w3.org/2002/07/owl#Class"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "A crystallographic site (Wyckoff position) is a sub-structural element of magmo:CrystalStructure; no existing class in the 3-tier ontology represents individual Wyckoff positions, so a new subclass is needed under magmo:CrystalStructure."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/emmo/domain/pm-multiscale"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "crystallographic site"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/emmo/domain/magnetic-material#CrystalStructure"
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "crystallographic site"
  } ]
}, {
  "@id" : "https://w3id.org/emmo/domain/pm-multiscale#CurieBlochEquation",
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.w3.org/2002/07/owl#Class"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "The Curie-Bloch equation is a phenomenological law relating magnetization to temperature (M(T) ∝ (1−T/Tc)^β); it functions as an emmo:MaterialLaw used to fit experimental or simulated M(T) curves, and no existing pm: or magmo: class captures this temperature-scaling relation."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/emmo/domain/pm-multiscale"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "curie-bloch equation"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/emmo#MaterialLaw"
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "curie-bloch equation"
  } ]
}, {
  "@id" : "https://w3id.org/emmo/domain/pm-multiscale#CurieTemperature",
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.w3.org/2002/07/owl#Class"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "The critical temperature above which a ferromagnet becomes paramagnetic, losing spontaneous magnetization. Nd2Fe14B: 585K, SmCo5: 1020K."
  }, {
    "@language" : "en",
    "@value" : "The critical temperature above which a ferromagnet becomes paramagnetic, losing spontaneous magnetization. Nd2Fe14B: 585K, SmCo5: 1020K. Not present in MagMO v1.0.0."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "CurieTemperature"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/emmo#EMMO_909a0a36_2242_4a8c_a5e1_3fa6e9b42f10"
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "CurieTemperature"
  } ]
}, {
  "@id" : "https://w3id.org/emmo/domain/pm-multiscale#DFTConfiguration",
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.w3.org/2002/07/owl#Class"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Configuration for a DFT calculation: exchange-correlation functional (PBE, LDA, GGA+U), basis set / plane-wave cutoff, k-point sampling, and spin-orbit coupling settings."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "DFTConfiguration"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/emmo/domain/pm-multiscale#SimulationConfiguration"
  }, {
    "@id" : "_:genid15"
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "DFTConfiguration"
  } ]
}, {
  "@id" : "https://w3id.org/emmo/domain/pm-multiscale#DFTStep",
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.w3.org/2002/07/owl#Class"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "A density functional theory calculation that computes ground-state electronic properties: spontaneous magnetization (Ms_0), magnetocrystalline anisotropy (K1), and exchange coupling constants (Jij) from first principles."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "DFTStep"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/emmo/domain/pm-multiscale#SimulationStep"
  }, {
    "@id" : "_:genid16"
  }, {
    "@id" : "_:genid17"
  }, {
    "@id" : "_:genid18"
  }, {
    "@id" : "_:genid19"
  }, {
    "@id" : "_:genid20"
  } ],
  "http://www.w3.org/2004/02/skos/core#altLabel" : [ {
    "@language" : "en",
    "@value" : "fermi-dirac smearing"
  }, {
    "@language" : "en",
    "@value" : "full-potential linear muffin-tin orbital method"
  }, {
    "@language" : "en",
    "@value" : "full-potential linearized augmented plane wave (flapw) method"
  }, {
    "@language" : "en",
    "@value" : "full-potential lmto method"
  }, {
    "@language" : "en",
    "@value" : "kkr green's function method"
  }, {
    "@language" : "en",
    "@value" : "noncollinear magnetic calculation"
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "DFTStep"
  } ]
}, {
  "@id" : "https://w3id.org/emmo/domain/pm-multiscale#DataRepository",
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.w3.org/2002/07/owl#Class"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "A data repository or database where material simulation data is stored and accessible via a persistent identifier."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "DataRepository"
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "DataRepository"
  } ]
}, {
  "@id" : "https://w3id.org/emmo/domain/pm-multiscale#DepinningCoercivity",
  "http://www.w3.org/2004/02/skos/core#note" : [ {
    "@language" : "en",
    "@value" : "What is depinning coercivity used for? — determining coercivity in the depinning-type magnetization reversal mechanism"
  } ]
}, {
  "@id" : "https://w3id.org/emmo/domain/pm-multiscale#DipolarCouplingConstant",
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.w3.org/2002/07/owl#Class"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Dipolar coupling constant (g_ab = M_a M_b v²) is a pairwise interaction prefactor not expressible by any existing magmo: constant class; it is a rigid Quantity analogous in role to magmo:UniaxialAnisotropyConstant but governing dipolar rather than anisotropy interactions."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/emmo/domain/pm-multiscale"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "dipolar coupling constant"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/emmo/domain/magnetic-material#UniaxialAnisotropyConstant"
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "dipolar coupling constant"
  } ]
}, {
  "@id" : "https://w3id.org/emmo/domain/pm-multiscale#DipolarEnergy",
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.w3.org/2002/07/owl#Class"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Dipolar energy is a distinct magnetic interaction energy (long-range dipole-dipole) not expressible as any existing magmo: energy class; it is a rigid Quantity under emmo:Energy and is essential for multi-scale micromagnetic simulations of permanent magnets."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/emmo/domain/pm-multiscale"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "dipolar energy"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/emmo/domain/magnetic-material#MagnetocrystallineAnisotropyEnergy"
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "dipolar energy"
  } ]
}, {
  "@id" : "https://w3id.org/emmo/domain/pm-multiscale#Dipolarenergy",
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.w3.org/2002/07/owl#Class"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "_:genid21"
  } ]
}, {
  "@id" : "https://w3id.org/emmo/domain/pm-multiscale#DipoleField",
  "http://www.w3.org/2004/02/skos/core#note" : [ {
    "@language" : "en",
    "@value" : "How is the dipole field computed? — computed via the demagnetization tensor"
  } ]
}, {
  "@id" : "https://w3id.org/emmo/domain/pm-multiscale#DomainNucleation",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.w3.org/2002/07/owl#Class"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Domain nucleation is a magnetisation-reversal mechanism central to coercivity modelling in permanent magnets; no existing pm: or magmo: class captures nucleation as a distinct process, requiring a new subclass under pm:MicromagneticsStep."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/emmo/domain/pm-multiscale"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "domain nucleation"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/emmo/domain/pm-multiscale#MicromagneticsStep"
  } ],
  "http://www.w3.org/2002/07/owl#disjointWith" : [ {
    "@id" : "https://w3id.org/emmo/domain/pm-multiscale#DomainWallMotion"
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "domain nucleation"
  } ],
  "https://w3id.org/emmo/domain/pm-multiscale#hasScaleLevel" : [ {
    "@id" : "https://w3id.org/emmo/domain/pm-multiscale#MesoscopicScale"
  } ]
}, {
  "@id" : "https://w3id.org/emmo/domain/pm-multiscale#DomainWallDepinningField",
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.w3.org/2002/07/owl#Class"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Domain wall depinning field is a distinct coercivity-mechanism quantity (the field required to unpin a domain wall from a defect) that is not captured by the general magmo:CoercivityHc class; it requires a new subclass to represent the pinning-limited coercivity contribution per the GAP criterion for missing mechanistic specificity."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/emmo/domain/pm-multiscale"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "domain wall depinning field"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/emmo/domain/magnetic-material#CoercivityHc"
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "domain wall depinning field"
  } ]
}, {
  "@id" : "https://w3id.org/emmo/domain/pm-multiscale#DomainWallEnergyDensity",
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.w3.org/2002/07/owl#Class"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Domain wall energy density (J/m²) is a distinct surface energy density quantity not expressible by magmo:MagnetocrystallineAnisotropyEnergy (a volumetric energy); it is a rigid Quantity in multi-scale permanent magnet modelling requiring a new GAP class."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/emmo/domain/pm-multiscale"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "domain wall energy density"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/emmo/domain/magnetic-material#MagnetocrystallineAnisotropyEnergy"
  } ],
  "http://www.w3.org/2004/02/skos/core#note" : [ {
    "@language" : "en",
    "@value" : "What does domain wall energy density drive? — drives domain wall pinning"
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "domain wall energy density"
  } ]
}, {
  "@id" : "https://w3id.org/emmo/domain/pm-multiscale#DomainWallMotion",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.w3.org/2002/07/owl#Class"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Domain wall motion is a distinct magnetization-change process simulated in micromagnetics workflows (pm:MicromagneticsStep) but not represented as its own class; a new subclass is needed per the gap criterion."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/emmo/domain/pm-multiscale"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "domain wall motion"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/emmo/domain/pm-multiscale#MicromagneticsStep"
  } ],
  "http://www.w3.org/2004/02/skos/core#note" : [ {
    "@language" : "en",
    "@value" : "What is domain wall motion used for? — the primary mechanism of magnetization change in materials with well-defined domain structures"
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "domain wall motion"
  } ],
  "https://w3id.org/emmo/domain/pm-multiscale#hasScaleLevel" : [ {
    "@id" : "https://w3id.org/emmo/domain/pm-multiscale#MesoscopicScale"
  } ]
}, {
  "@id" : "https://w3id.org/emmo/domain/pm-multiscale#DomainWallNucleationField",
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.w3.org/2002/07/owl#Class"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Domain wall nucleation field is a distinct coercivity-mechanism quantity (the field required to nucleate a domain wall at a specific defect) that is not captured by the general magmo:CoercivityHc class; it requires a new subclass to represent the nucleation-limited coercivity contribution per the GAP criterion for missing mechanistic specificity."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/emmo/domain/pm-multiscale"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "domain wall nucleation field"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/emmo/domain/magnetic-material#CoercivityHc"
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "domain wall nucleation field"
  } ]
}, {
  "@id" : "https://w3id.org/emmo/domain/pm-multiscale#DomainWallPropagation",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.w3.org/2002/07/owl#Class"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Domain wall propagation is a magnetisation-reversal mechanism (Barkhausen jumps) central to coercivity in permanent magnets and modelled in micromagnetics; no existing pm: or magmo: class captures wall motion as a distinct process."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/emmo/domain/pm-multiscale"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "domain wall propagation"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/emmo/domain/pm-multiscale#MicromagneticsStep"
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "domain wall propagation"
  } ],
  "https://w3id.org/emmo/domain/pm-multiscale#hasScaleLevel" : [ {
    "@id" : "https://w3id.org/emmo/domain/pm-multiscale#MesoscopicScale"
  } ]
}, {
  "@id" : "https://w3id.org/emmo/domain/pm-multiscale#Domainwalldepinningfield",
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.w3.org/2002/07/owl#Class"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "_:genid22"
  } ]
}, {
  "@id" : "https://w3id.org/emmo/domain/pm-multiscale#Domainwallnucleationfield",
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.w3.org/2002/07/owl#Class"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "_:genid23"
  } ]
}, {
  "@id" : "https://w3id.org/emmo/domain/pm-multiscale#Domainwallpinning",
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.w3.org/2002/07/owl#Class"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "_:genid24"
  } ]
}, {
  "@id" : "https://w3id.org/emmo/domain/pm-multiscale#Domainwallpropagation",
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.w3.org/2002/07/owl#Class"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "_:genid25"
  } ]
}, {
  "@id" : "https://w3id.org/emmo/domain/pm-multiscale#Dorbitalresolvedmae",
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.w3.org/2002/07/owl#Class"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "_:genid26"
  } ]
}, {
  "@id" : "https://w3id.org/emmo/domain/pm-multiscale#DynamicalMeanFieldTheory",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.w3.org/2002/07/owl#Class"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Dynamical mean-field theory (DMFT) is a many-body electronic-structure method treating local electron correlations beyond DFT, applied to Sm 4f electrons in permanent magnet calculations; it is a subclass of emmo:ElectronicModel, and no existing pm: class covers correlated-electron many-body methods."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/emmo/domain/pm-multiscale"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "dynamical mean-field theory"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/emmo#ElectronicModel"
  } ],
  "http://www.w3.org/2004/02/skos/core#note" : [ {
    "@language" : "en",
    "@value" : "How is dynamical mean-field theory computed? — applied here with the Hubbard I approximation for Sm 4f electrons and STPF solver for Co 3d electrons"
  }, {
    "@language" : "en",
    "@value" : "What is dynamical mean field theory used for? — combined with first-principles band structure calculations for finite-temperature magnetism"
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "dynamical mean-field theory"
  } ],
  "https://w3id.org/emmo/domain/pm-multiscale#hasScaleLevel" : [ {
    "@id" : "https://w3id.org/emmo/domain/pm-multiscale#ElectronicScale"
  } ]
}, {
  "@id" : "https://w3id.org/emmo/domain/pm-multiscale#Dynamicalmeanfieldtheory",
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.w3.org/2002/07/owl#Class"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "_:genid27"
  } ]
}, {
  "@id" : "https://w3id.org/emmo/domain/pm-multiscale#DzyaloshinskiiMoriyaInteraction",
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.w3.org/2002/07/owl#Class"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "DMI is an antisymmetric exchange interaction relevant to spin textures and domain-wall energetics in permanent-magnet interfaces; no existing magmo: class represents antisymmetric exchange, so a new sibling/subclass near magmo:ExchangeStiffnessConstant is needed."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/emmo/domain/pm-multiscale"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "dzyaloshinskii-moriya interaction"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/emmo/domain/magnetic-material#ExchangeStiffnessConstant"
  } ],
  "http://www.w3.org/2004/02/skos/core#note" : [ {
    "@language" : "en",
    "@value" : "What does the Dzyaloshinskii-Moriya interaction contribute to? — contributing a chiral term to the magnetic SANS cross section"
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "dzyaloshinskii-moriya interaction"
  } ]
}, {
  "@id" : "https://w3id.org/emmo/domain/pm-multiscale#EasyConeAnisotropy",
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.w3.org/2002/07/owl#Class"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Easy-cone anisotropy is a distinct anisotropy type (energy minimum on a cone, K1<0, K2>-K1/2) not covered by magmo:UniaxialMagneticAnisotropy (axial minimum) or magmo:CubicMagnetocrystallineAnisotropy; it requires a new subclass under magmo:UniaxialMagneticAnisotropy to maintain rigid subsumption."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/emmo/domain/pm-multiscale"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "easy-cone anisotropy"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/emmo/domain/magnetic-material#UniaxialMagneticAnisotropy"
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "easy-cone anisotropy"
  } ]
}, {
  "@id" : "https://w3id.org/emmo/domain/pm-multiscale#EffectiveAnisotropyField",
  "http://www.w3.org/2004/02/skos/core#note" : [ {
    "@language" : "en",
    "@value" : "What is the effective anisotropy field used for? — used in the LLG equation to compute resonance frequency"
  } ]
}, {
  "@id" : "https://w3id.org/emmo/domain/pm-multiscale#Effectiveanisotropy",
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.w3.org/2002/07/owl#Class"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "_:genid28"
  } ]
}, {
  "@id" : "https://w3id.org/emmo/domain/pm-multiscale#ElectronicScale",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/emmo/domain/pm-multiscale#ScaleLevel"
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "ElectronicScale"
  } ]
}, {
  "@id" : "https://w3id.org/emmo/domain/pm-multiscale#Electronicscale",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ]
}, {
  "@id" : "https://w3id.org/emmo/domain/pm-multiscale#EnergyProductDifference(δ(bh)max)",
  "http://www.w3.org/2004/02/skos/core#note" : [ {
    "@language" : "en",
    "@value" : "What is the energy product difference used for? — used as a measure of magnetic anisotropy"
  } ]
}, {
  "@id" : "https://w3id.org/emmo/domain/pm-multiscale#EquiaxedGrains",
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.w3.org/2002/07/owl#Class"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Equiaxed grains are a rigid, sortal morphological subtype of magmo:Grain (equal dimensions in all directions) not distinguished by any existing magmo: annotation; they require a new subclass under magmo:Grain to capture their microstructural role in SmCo-based PM alloys."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/emmo/domain/pm-multiscale"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "equiaxed grains"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/emmo/domain/magnetic-material#Grain"
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "equiaxed grains"
  } ]
}, {
  "@id" : "https://w3id.org/emmo/domain/pm-multiscale#ExchangeCorrelationFunctional",
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.w3.org/2002/07/owl#Class"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "The exchange-correlation functional approximation used in DFT. The choice (PBE vs LDA vs GGA+U) directly affects computed magnetic moments and anisotropy."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "ExchangeCorrelationFunctional"
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "ExchangeCorrelationFunctional"
  } ]
}, {
  "@id" : "https://w3id.org/emmo/domain/pm-multiscale#ExchangeEnergyDensity",
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.w3.org/2002/07/owl#Class"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Exchange energy density (∝A|∇m|²) is a distinct micromagnetic energy density term not covered by any existing magmo: class; magmo:MagnetocrystallineAnisotropyEnergy is the closest structural parent as a volumetric magnetic energy density, warranting a new sibling subclass in M3_Material."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/emmo/domain/pm-multiscale"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "exchange energy density"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/emmo/domain/magnetic-material#MagnetocrystallineAnisotropyEnergy"
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "exchange energy density"
  } ]
}, {
  "@id" : "https://w3id.org/emmo/domain/pm-multiscale#ExchangeSpringMagnet",
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.w3.org/2002/07/owl#Class"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "An exchange-spring magnet is a nanocomposite permanent magnet type combining hard and soft phases via exchange coupling; it is a distinct pm-multiscale-relevant material class not captured by pm:PermanentMagnetMaterial or any existing magmo: subclass, and should be a new subclass of magmo:BulkMagnet."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
