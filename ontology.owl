    <!-- https://w3id.org/emmo/domain/pm-multiscale#ClassicalHeisenbergModel -->


    <owl:NamedIndividual rdf:about="https://w3id.org/emmo/domain/pm-multiscale#ClassicalHeisenbergModel">
        <hasScaleLevel rdf:resource="https://w3id.org/emmo/domain/pm-multiscale#AtomisticScale"/>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/emmo/domain/pm-multiscale#ContinuumApproximation -->


    <owl:NamedIndividual rdf:about="https://w3id.org/emmo/domain/pm-multiscale#ContinuumApproximation">
        <rdf:type rdf:resource="https://w3id.org/emmo/domain/pm-multiscale#ScaleBridgingAssumption"/>
        <rdfs:comment xml:lang="en">Maps discrete atomistic spin configurations to continuous magnetization field M(r), valid when domain features are much larger than atomic spacing.</rdfs:comment>
        <skos:prefLabel xml:lang="en">Continuum approximation</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/emmo/domain/pm-multiscale#Converged -->


    <owl:NamedIndividual rdf:about="https://w3id.org/emmo/domain/pm-multiscale#Converged">
        <rdf:type rdf:resource="https://w3id.org/emmo/domain/pm-multiscale#StepStatus"/>
        <skos:prefLabel xml:lang="en">Converged</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/emmo/domain/pm-multiscale#CrystalFieldTheory -->


    <owl:NamedIndividual rdf:about="https://w3id.org/emmo/domain/pm-multiscale#CrystalFieldTheory">
        <hasScaleLevel rdf:resource="https://w3id.org/emmo/domain/pm-multiscale#ElectronicScale"/>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/emmo/domain/pm-multiscale#DomainNucleation -->


    <owl:NamedIndividual rdf:about="https://w3id.org/emmo/domain/pm-multiscale#DomainNucleation">
        <hasScaleLevel rdf:resource="https://w3id.org/emmo/domain/pm-multiscale#MesoscopicScale"/>
