    <!-- https://w3id.org/emmo/domain/pm-multiscale#Spinwavestiffnessconstant -->


    <owl:Class rdf:about="https://w3id.org/emmo/domain/pm-multiscale#Spinwavestiffnessconstant">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/emmo/domain/pm-multiscale#hasScaleLevel"/>
                <owl:hasValue rdf:resource="https://w3id.org/emmo/domain/pm-multiscale#Atomisticscale"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- https://w3id.org/emmo/domain/pm-multiscale#Stabilizationenergy -->


    <owl:Class rdf:about="https://w3id.org/emmo/domain/pm-multiscale#Stabilizationenergy">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/emmo/domain/pm-multiscale#hasScaleLevel"/>
                <owl:hasValue rdf:resource="https://w3id.org/emmo/domain/pm-multiscale#Atomisticscale"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- https://w3id.org/emmo/domain/pm-multiscale#StepStatus -->


    <owl:Class rdf:about="https://w3id.org/emmo/domain/pm-multiscale#StepStatus">
        <owl:equivalentClass>
            <owl:Class>
                <owl:oneOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/emmo/domain/pm-multiscale#Converged"/>
                    <rdf:Description rdf:about="https://w3id.org/emmo/domain/pm-multiscale#Failed"/>
                    <rdf:Description rdf:about="https://w3id.org/emmo/domain/pm-multiscale#Running"/>
                </owl:oneOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:comment xml:lang="en">The execution status of a simulation step: Converged (completed successfully), Failed (did not converge or crashed), or Running (in progress).</rdfs:comment>
        <rdfs:label>StepStatus</rdfs:label>
        <skos:prefLabel xml:lang="en">StepStatus</skos:prefLabel>
    </owl:Class>
    


    <!-- https://w3id.org/emmo/domain/pm-multiscale#StochasticLandauLifshitzGilbertEquation -->


    <owl:Class rdf:about="https://w3id.org/emmo/domain/pm-multiscale#StochasticLandauLifshitzGilbertEquation">
