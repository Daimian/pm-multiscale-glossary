:Heisenbergspinmodel rdf:type owl:Class ;
                     rdfs:subClassOf [ rdf:type owl:Restriction ;
                                       owl:onProperty :hasScaleLevel ;
                                       owl:hasValue :Atomisticscale
                                     ] .


###  https://w3id.org/emmo/domain/pm-multiscale#HeuslerAlloy
:HeuslerAlloy rdf:type owl:Class ;
              rdfs:subClassOf <https://w3id.org/emmo/domain/magnetic-material#CrystallineMagneticMaterial> ,
                              [ rdf:type owl:Restriction ;
                                owl:onProperty :hasProperty ;
                                owl:someValuesFrom <https://w3id.org/emmo/domain/magnetic-material#SaturationMagnetization>
                              ] ,
                              [ rdf:type owl:Restriction ;
                                owl:onProperty :hasProperty ;
                                owl:someValuesFrom :CurieTemperature
                              ] ;
              rdfs:comment "Heusler alloys (X2YZ intermetallics) are a distinct class of crystalline magnetic materials investigated for rare-earth-free permanent magnet applications; they are not captured by pm:AlNiCo or any existing pm:/magmo: material class, requiring a new subclass of magmo:CrystallineMagneticMaterial."@en ;
              rdfs:isDefinedBy <https://w3id.org/emmo/domain/pm-multiscale> ;
              rdfs:label "heusler alloy" ;
              <http://www.w3.org/2004/02/skos/core#note> "What is a Heusler alloy used for? — studied here as all-3d transition metal variants for permanent magnet applications"@en ;
              <http://www.w3.org/2004/02/skos/core#prefLabel> "heusler alloy"@en .


