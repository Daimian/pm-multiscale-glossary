}, {
  "@id" : "https://w3id.org/emmo/domain/pm-multiscale",
  "@type" : [ "http://www.w3.org/2002/07/owl#Ontology" ],
  "http://purl.org/dc/terms/abstract" : [ {
    "@language" : "en",
    "@value" : "An EMMO domain ontology for multi-scale computational simulation of permanent magnetic materials, covering DFT through spin dynamics to micromagnetics, with support for literature annotation and reproducibility assessment."
  } ],
  "http://purl.org/dc/terms/created" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#date",
    "@value" : "2026-05-22"
  } ],
  "http://purl.org/dc/terms/creator" : [ {
    "@value" : "Generated via NEON-GPT methodology, validated L1-L4"
  } ],
  "http://purl.org/dc/terms/license" : [ {
    "@value" : "https://creativecommons.org/licenses/by/4.0/legalcode"
  } ],
  "http://purl.org/dc/terms/title" : [ {
    "@language" : "en",
    "@value" : "Permanent Magnet Multi-Scale Simulation Ontology"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "v2.0.0 — CQ-driven enrichment, self-checked, ABox cleaned, strict filtered. Removed SmCo/Ferrite/AlNiCo (no-pattern leaf classes). Updated 2026-05-30."
  } ],
  "http://www.w3.org/2002/07/owl#imports" : [ {
    "@id" : "https://w3id.org/emmo/1.0.3/disciplines/models"
  }, {
    "@id" : "https://w3id.org/emmo/1.0.3/reference/workflow"
  }, {
    "@id" : "https://w3id.org/emmo/domain/magnetic-material/1.0.0"
  } ],
  "http://www.w3.org/2002/07/owl#versionIRI" : [ {
    "@id" : "https://w3id.org/emmo/domain/pm-multiscale/0.1.0"
  } ],
  "http://www.w3.org/2002/07/owl#versionInfo" : [ {
    "@value" : "2.0.0"
  } ]
}, {
  "@id" : "https://w3id.org/emmo/domain/pm-multiscale#1:5Phase",
  "http://www.w3.org/2004/02/skos/core#note" : [ {
    "@language" : "en",
    "@value" : "What is the 1:5 phase used for? — used in SmCo5 and PrCo5 permanent magnets"
  } ]
}, {
  "@id" : "https://w3id.org/emmo/domain/pm-multiscale#AllenCahnEquation",
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.w3.org/2002/07/owl#Class"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "The Allen-Cahn equation is a continuum PDE governing order-parameter evolution for phase-field modeling, used here for rotor pole shape optimization in permanent magnet motor design; it is a canonical emmo:ContinuumModel (phase-field), and no existing pm: class covers phase-field continuum equations."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/emmo/domain/pm-multiscale"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "allen-cahn equation"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/emmo#ContinuumModel"
  } ],
  "http://www.w3.org/2004/02/skos/core#note" : [ {
    "@language" : "en",
    "@value" : "What is the Allen-Cahn equation used for? — used here for rotor pole shape optimization"
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "allen-cahn equation"
  } ]
}, {
  "@id" : "https://w3id.org/emmo/domain/pm-multiscale#AmorphousGrainBoundaryPhase",
  "http://www.w3.org/2004/02/skos/core#note" : [ {
    "@language" : "en",
    "@value" : "What is the amorphous grain boundary phase used for? — provides magnetic isolation between SmFe12 grains"
  } ]
}, {
  "@id" : "https://w3id.org/emmo/domain/pm-multiscale#AndersonImpurityModel",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.w3.org/2002/07/owl#Class"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "The Anderson impurity model describes hybridisation of localised 4f states with conduction electrons in rare-earth PM compounds; it is IN_SCOPE as an electronic-structure model and a GAP because emmo:ElectronicModel has no sub-class for quantum impurity models distinct from DFT or tight-binding approaches."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/emmo/domain/pm-multiscale"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "anderson impurity model"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/emmo#ElectronicModel"
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "anderson impurity model"
  } ],
  "https://w3id.org/emmo/domain/pm-multiscale#hasScaleLevel" : [ {
    "@id" : "https://w3id.org/emmo/domain/pm-multiscale#ElectronicScale"
  } ]
}, {
  "@id" : "https://w3id.org/emmo/domain/pm-multiscale#AndersonModel",
  "http://www.w3.org/2004/02/skos/core#note" : [ {
    "@language" : "en",
    "@value" : "What is the Anderson model used for? — from which the Kondo model is derived via the Schrieffer-Wolff transformation"
  } ]
}, {
  "@id" : "https://w3id.org/emmo/domain/pm-multiscale#Andersonimpuritymodel",
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
