    </owl:Class>
    


    <!-- https://w3id.org/emmo/domain/pm-multiscale#Stochasticlandaulifshitzequation -->


    <owl:Class rdf:about="https://w3id.org/emmo/domain/pm-multiscale#Stochasticlandaulifshitzequation">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/emmo/domain/pm-multiscale#hasScaleLevel"/>
                <owl:hasValue rdf:resource="https://w3id.org/emmo/domain/pm-multiscale#Atomisticscale"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- https://w3id.org/emmo/domain/pm-multiscale#Stochasticlandaulifshitzgilbert -->


