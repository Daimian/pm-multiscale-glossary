  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "The spatial discretization for finite element micromagnetics: cell size, element type, and refinement strategy. Cell size must be smaller than the exchange length."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "MeshSpecification"
