:Montecarlostep rdf:type owl:Class ;
                rdfs:subClassOf [ rdf:type owl:Restriction ;
                                  owl:onProperty :hasScaleLevel ;
                                  owl:hasValue :Atomisticscale
                                ] .


###  https://w3id.org/emmo/domain/pm-multiscale#Muffintinapproximation
:Muffintinapproximation rdf:type owl:Class ;
                        rdfs:subClassOf [ rdf:type owl:Restriction ;
                                          owl:onProperty :hasScaleLevel ;
                                          owl:hasValue :Electronicscale
                                        ] .


###  https://w3id.org/emmo/domain/pm-multiscale#MultiScaleSimulationWorkflow
:MultiScaleSimulationWorkflow rdf:type owl:Class ;
                              rdfs:subClassOf <https://w3id.org/emmo#EMMO_64963ed6_39c9_4258_85e0_6466c4b5420c> ,
                                              <https://w3id.org/emmo#EMMO_7d56ec24_499d_487a_af7d_a91aaa787bfe> ,
                                              [ rdf:type owl:Restriction ;
                                                owl:onProperty :hasSimulationStep ;
                                                owl:minCardinality "2"^^xsd:nonNegativeInteger
                                              ] ;
                              rdfs:comment "A computational workflow that chains simulation steps across different spatial/temporal scales (e.g., DFT -> spin dynamics -> micromagnetics). Each step produces parameters consumed by the next."@en ;
                              rdfs:label "MultiScaleSimulationWorkflow" ;
                              <http://www.w3.org/2004/02/skos/core#prefLabel> "MultiScaleSimulationWorkflow"@en .


###  https://w3id.org/emmo/domain/pm-multiscale#Nanocomposite
:Nanocomposite rdf:type owl:Class ;
               rdfs:subClassOf <https://w3id.org/emmo/domain/magnetic-material#CrystallineMagneticMaterial> ,
                               [ rdf:type owl:Restriction ;
                                 owl:onProperty :hasScaleLevel ;
                                 owl:hasValue :Mesoscopicscale
                               ] ;
               rdfs:comment "A nanocomposite hard/soft two-phase magnet is a rigid, sortal material class central to PM multi-scale simulation; it is not expressible as any single existing magmo: class (it combines hard and soft phases at nanoscale), so a new subclass under magmo:CrystallineMagneticMaterial is required."@en ;
               rdfs:isDefinedBy <https://w3id.org/emmo/domain/pm-multiscale> ;
               rdfs:label "nanocomposite" ;
               <http://www.w3.org/2004/02/skos/core#prefLabel> "nanocomposite"@en .


