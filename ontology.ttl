:KPointSampling rdf:type owl:Class ;
                rdfs:comment "The Brillouin zone sampling scheme (e.g., Monkhorst-Pack grid). Denser grids give more accurate results but cost more compute time."@en ;
                rdfs:label "KPointSampling" ;
                <http://www.w3.org/2004/02/skos/core#prefLabel> "KPointSampling"@en .


