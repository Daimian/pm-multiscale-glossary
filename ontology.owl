    <owl:Class rdf:about="https://w3id.org/emmo/domain/pm-multiscale#BoundaryCondition">
        <rdfs:comment xml:lang="en">The boundary condition applied to the simulation domain: periodic (infinite crystal), open (isolated particle), or mixed.</rdfs:comment>
        <rdfs:label>BoundaryCondition</rdfs:label>
        <skos:prefLabel xml:lang="en">BoundaryCondition</skos:prefLabel>
    </owl:Class>
    


    <!-- https://w3id.org/emmo/domain/pm-multiscale#CahnHilliardEquation -->


    <owl:Class rdf:about="https://w3id.org/emmo/domain/pm-multiscale#CahnHilliardEquation">
        <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#ContinuumModel"/>
        <rdfs:comment xml:lang="en">The Cahn-Hilliard equation is a continuum PDE governing conserved concentration-field evolution in phase-field solidification models for PM microstructure formation; it is IN_SCOPE as a continuum model component and a GAP because no existing pm: class covers phase-field PDE formulations.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/domain/pm-multiscale"/>
        <rdfs:label>cahn-hilliard equation</rdfs:label>
        <skos:note xml:lang="en">What does the Cahn-Hilliard equation govern? — governing the conserved concentration field evolution during solidification in the CF-MPF model</skos:note>
        <skos:prefLabel xml:lang="en">cahn-hilliard equation</skos:prefLabel>
    </owl:Class>
    


    <!-- https://w3id.org/emmo/domain/pm-multiscale#Cahnhilliardequation -->


