    <!-- https://w3id.org/emmo/domain/pm-multiscale#BasisSetSpecification -->


    <owl:Class rdf:about="https://w3id.org/emmo/domain/pm-multiscale#BasisSetSpecification">
        <rdfs:comment xml:lang="en">The basis set type and size for a DFT calculation. For plane-wave codes (VASP): cutoff energy in eV. For LAPW codes (FLEUR): muffin-tin radius and lmax.</rdfs:comment>
        <rdfs:label>BasisSetSpecification</rdfs:label>
        <skos:prefLabel xml:lang="en">BasisSetSpecification</skos:prefLabel>
    </owl:Class>
    


    <!-- https://w3id.org/emmo/domain/pm-multiscale#BirchMurnaghanEquationOfState -->


    <owl:Class rdf:about="https://w3id.org/emmo/domain/pm-multiscale#BirchMurnaghanEquationOfState">
        <rdfs:subClassOf rdf:resource="https://w3id.org/emmo#MaterialLaw"/>
        <rdfs:comment xml:lang="en">The Birch-Murnaghan equation of state is an empirical constitutive relation (energy vs. volume) used in ab initio workflows to extract equilibrium volume and bulk modulus; it is a MaterialLaw in EMMO terms, and no existing pm: class covers equation-of-state fitting methods.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/domain/pm-multiscale"/>
        <rdfs:label>birch-murnaghan equation of state</rdfs:label>
        <skos:note xml:lang="en">What is the Birch-Murnaghan equation of state applied to? — extract equilibrium volume and bulk modulus from ab initio calculations</skos:note>
        <skos:prefLabel xml:lang="en">birch-murnaghan equation of state</skos:prefLabel>
    </owl:Class>
    


    <!-- https://w3id.org/emmo/domain/pm-multiscale#Birchmurnaghanequationofstate -->


