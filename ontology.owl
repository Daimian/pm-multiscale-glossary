    <!-- https://w3id.org/emmo/domain/pm-multiscale#canRunInParallelWith -->


    <owl:ObjectProperty rdf:about="https://w3id.org/emmo/domain/pm-multiscale#canRunInParallelWith">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/emmo/domain/pm-multiscale#SimulationStep"/>
        <rdfs:range rdf:resource="https://w3id.org/emmo/domain/pm-multiscale#SimulationStep"/>
        <rdfs:comment xml:lang="en">Indicates two steps have no data dependency and can execute concurrently. Symmetric: if A can run in parallel with B, then B can run in parallel with A.</rdfs:comment>
        <skos:prefLabel xml:lang="en">canRunInParallelWith</skos:prefLabel>
    </owl:ObjectProperty>
    


