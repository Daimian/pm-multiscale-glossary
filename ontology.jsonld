  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "The basis set type and size for a DFT calculation. For plane-wave codes (VASP): cutoff energy in eV. For LAPW codes (FLEUR): muffin-tin radius and lmax."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
