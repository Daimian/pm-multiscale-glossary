}, {
  "@id" : "https://w3id.org/emmo/domain/pm-multiscale#ExperimentalDetermination",
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.w3.org/2002/07/owl#Class"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "A property value obtained through experimental measurement: VSM, SQUID magnetometry, PPMS, or neutron diffraction."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "ExperimentalDetermination"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/emmo/domain/pm-multiscale#PropertyDetermination"
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "ExperimentalDetermination"
  } ]
}, {
  "@id" : "https://w3id.org/emmo/domain/pm-multiscale#ExperimentalValidation",
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.w3.org/2002/07/owl#Class"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "A record that a computed property value has been compared against an experimental measurement, including the agreement/discrepancy."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "ExperimentalValidation"
  } ],
  "http://www.w3.org/2004/02/skos/core#altLabel" : [ {
    "@language" : "en",
    "@value" : "lorentz tem"
  }, {
    "@language" : "en",
    "@value" : "vibrating-sample magnetometer"
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "ExperimentalValidation"
  } ]
}, {
  "@id" : "https://w3id.org/emmo/domain/pm-multiscale#Failed",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/emmo/domain/pm-multiscale#StepStatus"
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "Failed"
  } ]
}, {
  "@id" : "https://w3id.org/emmo/domain/pm-multiscale#FccStructure",
  "http://www.w3.org/2004/02/skos/core#note" : [ {
    "@language" : "en",
    "@value" : "What transformation must fcc structure undergo to acquire hard magnetic properties? — must be transformed to fct for hard magnetic properties"
  } ]
}, {
  "@id" : "https://w3id.org/emmo/domain/pm-multiscale#FermiDiracSmearing",
  "http://www.w3.org/2004/02/skos/core#note" : [ {
    "@language" : "en",
    "@value" : "How are Kohn-Sham states occupied in DFT calculations? — Fermi-Dirac distribution with width 0.01 eV used to occupy Kohn-Sham states in the DFT calculation"
  } ]
}, {
  "@id" : "https://w3id.org/emmo/domain/pm-multiscale#Fermidiracsmearing",
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.w3.org/2002/07/owl#Class"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "_:genid34"
  } ]
}, {
  "@id" : "https://w3id.org/emmo/domain/pm-multiscale#Ferrimagnet",
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.w3.org/2002/07/owl#Class"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "A ferrimagnet (net spontaneous magnetisation from unequal antiparallel sublattices, e.g. Gd2Fe14B) is a rigid, sortal material class; pm:Ferrite is too narrow (oxide ferrites only), so a new subclass under magmo:CrystallineMagneticMaterial is required for the general ferrimagnetic material type."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/emmo/domain/pm-multiscale"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "ferrimagnet"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/emmo/domain/magnetic-material#CrystallineMagneticMaterial"
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "ferrimagnet"
  } ]
}, {
  "@id" : "https://w3id.org/emmo/domain/pm-multiscale#FigureSource",
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.w3.org/2002/07/owl#Class"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "A property value extracted or digitized from a figure in a publication."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "FigureSource"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/emmo/domain/pm-multiscale#PropertySource"
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "FigureSource"
  } ]
}, {
  "@id" : "https://w3id.org/emmo/domain/pm-multiscale#FixedSpinMoment(fsm)Calculation",
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.w3.org/2002/07/owl#Class"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Fixed spin moment (FSM) calculation is a constrained DFT method in which the total magnetic moment is fixed to study magnetisation-dependent properties of permanent magnets; it is a sub-method of pm:DFTStep not currently represented as a distinct class, warranting a new subclass under emmo:Computation."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/emmo/domain/pm-multiscale"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "fixed spin moment (fsm) calculation"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/emmo#Computation"
  } ],
  "http://www.w3.org/2004/02/skos/core#note" : [ {
    "@language" : "en",
    "@value" : "What is fixed spin moment calculation used for? — to study the dependence of magnetic properties on magnetization magnitude"
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "fixed spin moment (fsm) calculation"
  } ]
}, {
  "@id" : "https://w3id.org/emmo/domain/pm-multiscale#Fixedspinmomentcalculation",
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.w3.org/2002/07/owl#Class"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "_:genid35"
  } ]
}, {
  "@id" : "https://w3id.org/emmo/domain/pm-multiscale#Fixedspinmomentmethod",
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.w3.org/2002/07/owl#Class"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "_:genid36"
  } ]
}, {
  "@id" : "https://w3id.org/emmo/domain/pm-multiscale#Flapwmethod",
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.w3.org/2002/07/owl#Class"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "_:genid37"
  } ]
}, {
  "@id" : "https://w3id.org/emmo/domain/pm-multiscale#ForceTheorem",
  "http://www.w3.org/2004/02/skos/core#note" : [ {
    "@language" : "en",
    "@value" : "What is the force theorem used for? — used to calculate magnetocrystalline anisotropy energy by comparing band energies along different magnetization directions"
  } ]
}, {
  "@id" : "https://w3id.org/emmo/domain/pm-multiscale#Frozenmagnoncalculation",
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.w3.org/2002/07/owl#Class"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "_:genid38"
  } ]
}, {
  "@id" : "https://w3id.org/emmo/domain/pm-multiscale#FullPotentialLinearMuffinTinOrbitalMethod",
  "http://www.w3.org/2004/02/skos/core#note" : [ {
    "@language" : "en",
    "@value" : "How is the full-potential linear muffin-tin orbital method implemented? — implemented in RSPt"
  } ]
}, {
  "@id" : "https://w3id.org/emmo/domain/pm-multiscale#FullPotentialLinearizedAugmentedPlaneWave(flapw)Method",
  "http://www.w3.org/2004/02/skos/core#note" : [ {
    "@language" : "en",
    "@value" : "How is the FLAPW method implemented? — implemented in WIEN2k"
  } ]
}, {
  "@id" : "https://w3id.org/emmo/domain/pm-multiscale#FullPotentialLmtoMethod",
  "http://www.w3.org/2004/02/skos/core#note" : [ {
    "@language" : "en",
    "@value" : "How is magnetocrystalline anisotropy energy computed using the full-potential LMTO method? — A full-potential linear muffin-tin orbital computational method (RSPt code) used to compute magnetocrystalline anisotropy energy with spin-orbit coupling treated post-SCF"
  } ]
}, {
  "@id" : "https://w3id.org/emmo/domain/pm-multiscale#Fullpotentiallmtomethod",
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.w3.org/2002/07/owl#Class"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "_:genid39"
  } ]
}, {
  "@id" : "https://w3id.org/emmo/domain/pm-multiscale#GGA_Plus_U",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/emmo/domain/pm-multiscale#ExchangeCorrelationFunctional"
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "GGA+U"
  } ]
}, {
  "@id" : "https://w3id.org/emmo/domain/pm-multiscale#GaussianDistributionOfEasyAxes",
  "http://www.w3.org/2004/02/skos/core#note" : [ {
    "@language" : "en",
    "@value" : "What does the Gaussian distribution of easy axes describe? — used to describe the angular spread of grain easy axes in oriented nanocrystalline magnets"
  } ]
}, {
  "@id" : "https://w3id.org/emmo/domain/pm-multiscale#Giantmagneticmoment",
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.w3.org/2002/07/owl#Class"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "_:genid40"
  } ]
}, {
  "@id" : "https://w3id.org/emmo/domain/pm-multiscale#GilbertDampingConstant",
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.w3.org/2002/07/owl#Class"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "The Gilbert damping constant α is a dimensionless material parameter governing LLG spin dynamics, analogous in role to magmo:ExchangeStiffnessConstant as a micromagnetic material parameter; no existing class covers it, so a new sibling subclass is needed."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/emmo/domain/pm-multiscale"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "gilbert damping constant"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/emmo/domain/magnetic-material#ExchangeStiffnessConstant"
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "gilbert damping constant"
  } ]
}, {
  "@id" : "https://w3id.org/emmo/domain/pm-multiscale#GilbertEquationOfMotion",
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.w3.org/2002/07/owl#Class"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "The Gilbert equation of motion is the dynamic equation for magnetization precession and damping, foundational to both micromagnetic and atomistic spin-dynamics simulations; it is a MaterialsModel governing magnetization dynamics, and while pm:SpinDynamicsConfiguration captures its parameters, no class represents the equation itself."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/emmo/domain/pm-multiscale"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "gilbert equation of motion"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/emmo#MaterialsModel"
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "gilbert equation of motion"
  } ]
}, {
  "@id" : "https://w3id.org/emmo/domain/pm-multiscale#HardAxis",
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.w3.org/2002/07/owl#Class"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Hard axis is a crystallographic direction concept directly relevant to magnetocrystalline anisotropy in permanent magnets; no existing magmo: class captures the hard-axis direction specifically, so a new subclass under magmo:CrystallographicOrientation is warranted."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/emmo/domain/pm-multiscale"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "hard axis"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/emmo/domain/magnetic-material#CrystallographicOrientation"
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "hard axis"
  } ]
}, {
  "@id" : "https://w3id.org/emmo/domain/pm-multiscale#HardGrain",
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.w3.org/2002/07/owl#Class"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "A hard grain is a rigid, sortal subtype of magmo:Grain distinguished by its switching-field criterion and bistable magnetisation states, a distinction not captured by any existing magmo: class annotation, making it a GAP requiring a new subclass under magmo:Grain."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/emmo/domain/pm-multiscale"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "hard grain"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/emmo/domain/magnetic-material#Grain"
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "hard grain"
  } ]
}, {
  "@id" : "https://w3id.org/emmo/domain/pm-multiscale#HardMagnet",
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.w3.org/2002/07/owl#Class"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "A permanent magnet with high coercivity (typically Hc > 400 kA/m), suitable for applications requiring stable magnetic fields: motors, generators, sensors."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "HardMagnet"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/emmo/domain/pm-multiscale#PermanentMagnetMaterial"
  } ],
  "http://www.w3.org/2002/07/owl#disjointWith" : [ {
    "@id" : "https://w3id.org/emmo/domain/pm-multiscale#SoftMagnet"
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "HardMagnet"
  } ]
}, {
  "@id" : "https://w3id.org/emmo/domain/pm-multiscale#Hardaxis",
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.w3.org/2002/07/owl#Class"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "_:genid41"
  } ]
}, {
  "@id" : "https://w3id.org/emmo/domain/pm-multiscale#HeisenbergExchangeParameter",
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.w3.org/2002/07/owl#Class"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "The Heisenberg exchange parameter J_ij is a pairwise site-resolved quantity distinct from the continuum magmo:ExchangeStiffnessConstant; it is an atomistic-scale input to Monte Carlo / spin-dynamics simulations and requires a new subclass under magmo:ExchangeStiffnessConstant in M3_Material."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/emmo/domain/pm-multiscale"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "heisenberg exchange parameter"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/emmo/domain/magnetic-material#ExchangeStiffnessConstant"
  } ],
  "http://www.w3.org/2004/02/skos/core#note" : [ {
    "@language" : "en",
    "@value" : "What is the Heisenberg exchange parameter used for? — used as input to Monte Carlo simulations for Curie temperature determination"
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "heisenberg exchange parameter"
  } ]
}, {
  "@id" : "https://w3id.org/emmo/domain/pm-multiscale#HeisenbergModelHamiltonian",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.w3.org/2002/07/owl#Class"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "The Heisenberg model Hamiltonian is the classical spin Hamiltonian parameterising pairwise exchange interactions between atomic sites in PM spin-dynamics simulations; it is IN_SCOPE and a GAP because pm:SpinDynamicsConfiguration covers solver/configuration settings but not the Hamiltonian functional form as a model class."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/emmo/domain/pm-multiscale"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "heisenberg model hamiltonian"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/emmo#AtomisticModel"
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "heisenberg model hamiltonian"
  } ],
  "https://w3id.org/emmo/domain/pm-multiscale#hasScaleLevel" : [ {
    "@id" : "https://w3id.org/emmo/domain/pm-multiscale#AtomisticScale"
  } ]
}, {
  "@id" : "https://w3id.org/emmo/domain/pm-multiscale#Heisenbergmodelhamiltonian",
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.w3.org/2002/07/owl#Class"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "_:genid42"
  } ]
}, {
  "@id" : "https://w3id.org/emmo/domain/pm-multiscale#Heisenbergspinhamiltonian",
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.w3.org/2002/07/owl#Class"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "_:genid43"
  } ]
}, {
  "@id" : "https://w3id.org/emmo/domain/pm-multiscale#Heisenbergspinmodel",
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.w3.org/2002/07/owl#Class"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "_:genid44"
  } ]
}, {
  "@id" : "https://w3id.org/emmo/domain/pm-multiscale#HeuslerAlloy",
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.w3.org/2002/07/owl#Class"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Heusler alloys (X2YZ intermetallics) are a distinct class of crystalline magnetic materials investigated for rare-earth-free permanent magnet applications; they are not captured by pm:AlNiCo or any existing pm:/magmo: material class, requiring a new subclass of magmo:CrystallineMagneticMaterial."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/emmo/domain/pm-multiscale"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "heusler alloy"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/emmo/domain/magnetic-material#CrystallineMagneticMaterial"
  }, {
    "@id" : "_:genid45"
  }, {
    "@id" : "_:genid46"
  } ],
  "http://www.w3.org/2004/02/skos/core#note" : [ {
    "@language" : "en",
    "@value" : "What is a Heusler alloy used for? — studied here as all-3d transition metal variants for permanent magnet applications"
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "heusler alloy"
  } ]
}, {
  "@id" : "https://w3id.org/emmo/domain/pm-multiscale#HubbardIApproximation",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.w3.org/2002/07/owl#Class"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "The Hubbard-I approximation is a many-body electronic-structure method for treating localised 4f electrons in rare-earth PM compounds; it is IN_SCOPE and a GAP because pm:ExchangeCorrelationFunctional covers DFT XC functionals but not beyond-DFT many-body impurity solvers."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/emmo/domain/pm-multiscale"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "hubbard i approximation"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/emmo#ElectronicModel"
  } ],
  "http://www.w3.org/2004/02/skos/core#note" : [ {
    "@language" : "en",
    "@value" : "How is the Hubbard I approximation computed? — neglecting hybridization in the DMFT impurity problem, approximating the self-energy by the atomic self-energy"
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "hubbard i approximation"
  } ],
  "https://w3id.org/emmo/domain/pm-multiscale#hasScaleLevel" : [ {
    "@id" : "https://w3id.org/emmo/domain/pm-multiscale#ElectronicScale"
  } ]
}, {
  "@id" : "https://w3id.org/emmo/domain/pm-multiscale#HubbardUPotential",
  "http://www.w3.org/2004/02/skos/core#note" : [ {
    "@language" : "en",
    "@value" : "How is the Hubbard U potential computed? — A phenomenological on-site Coulomb correction term added to DFT to better describe strongly correlated d or f electrons"
  } ]
}, {
  "@id" : "https://w3id.org/emmo/domain/pm-multiscale#Hubbardiapproximation",
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.w3.org/2002/07/owl#Class"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "_:genid47"
  } ]
}, {
  "@id" : "https://w3id.org/emmo/domain/pm-multiscale#Hubbardupotential",
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.w3.org/2002/07/owl#Class"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "_:genid48"
  } ]
}, {
  "@id" : "https://w3id.org/emmo/domain/pm-multiscale#IdealEnergyProduct(2πms)2",
  "http://www.w3.org/2004/02/skos/core#note" : [ {
    "@language" : "en",
    "@value" : "What is the ideal energy product used for? — used as a benchmark for comparing experimental energy products"
  } ]
}, {
  "@id" : "https://w3id.org/emmo/domain/pm-multiscale#InPlaneMagneticAnisotropy",
  "http://www.w3.org/2004/02/skos/core#note" : [ {
    "@language" : "en",
    "@value" : "What is in-plane magnetic anisotropy used for? — which is unfavorable for permanent magnet applications"
  } ]
}, {
  "@id" : "https://w3id.org/emmo/domain/pm-multiscale#Interatomicexchangeparameter",
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.w3.org/2002/07/owl#Class"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "_:genid49"
  } ]
}, {
  "@id" : "https://w3id.org/emmo/domain/pm-multiscale#IntersiteExchangeCouplingParameter",
  "http://www.w3.org/2004/02/skos/core#note" : [ {
    "@language" : "en",
    "@value" : "How is the intersite exchange coupling parameter computed? — calculated via linear-response to small-angle spin fluctuations"
  } ]
}, {
  "@id" : "https://w3id.org/emmo/domain/pm-multiscale#Intersiteexchangecouplingparameter",
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.w3.org/2002/07/owl#Class"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "_:genid50"
  } ]
}, {
  "@id" : "https://w3id.org/emmo/domain/pm-multiscale#IsothermalRemanentMagnetization",
  "http://www.w3.org/2004/02/skos/core#note" : [ {
    "@language" : "en",
    "@value" : "What is isothermal remanent magnetization used for? — used to construct Henkel plots"
  } ]
}, {
  "@id" : "https://w3id.org/emmo/domain/pm-multiscale#KPointSampling",
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.w3.org/2002/07/owl#Class"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "The Brillouin zone sampling scheme (e.g., Monkhorst-Pack grid). Denser grids give more accurate results but cost more compute time."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "KPointSampling"
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "KPointSampling"
  } ]
}, {
  "@id" : "https://w3id.org/emmo/domain/pm-multiscale#KkrGreen'sFunctionMethod",
  "http://www.w3.org/2004/02/skos/core#note" : [ {
    "@language" : "en",
    "@value" : "How is the KKR Green's function method used? — used to solve the Kohn-Sham equations in density functional theory calculations"
  } ]
}, {
  "@id" : "https://w3id.org/emmo/domain/pm-multiscale#Kkrgreensfunctionmethod",
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.w3.org/2002/07/owl#Class"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "_:genid51"
  } ]
}, {
  "@id" : "https://w3id.org/emmo/domain/pm-multiscale#Kpointresolvedmae",
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.w3.org/2002/07/owl#Class"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "_:genid52"
  } ]
}, {
  "@id" : "https://w3id.org/emmo/domain/pm-multiscale#KronmüllerEquation",
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.w3.org/2002/07/owl#Class"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "The Kronmüller equation is a semiempirical constitutive expression for coercivity incorporating microstructural factors (α, Deff) to relate intrinsic magnetic properties to macroscopic coercive field; it is an emmo:MaterialLaw linking material parameters to a key permanent magnet performance quantity, and no existing pm: or magmo: class captures this coercivity-microstructure relation."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/emmo/domain/pm-multiscale"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "kronmüller equation"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/emmo#MaterialLaw"
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "kronmüller equation"
  } ]
}, {
  "@id" : "https://w3id.org/emmo/domain/pm-multiscale#L10mnga",
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.w3.org/2002/07/owl#Class"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "_:genid53"
  } ]
}, {
  "@id" : "https://w3id.org/emmo/domain/pm-multiscale#LDA",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/emmo/domain/pm-multiscale#ExchangeCorrelationFunctional"
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "LDA"
  } ]
}, {
  "@id" : "https://w3id.org/emmo/domain/pm-multiscale#Ldaplusdmft",
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.w3.org/2002/07/owl#Class"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "_:genid54"
  } ]
}, {
  "@id" : "https://w3id.org/emmo/domain/pm-multiscale#Ltpmnbi",
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.w3.org/2002/07/owl#Class"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "_:genid55"
  } ]
}, {
  "@id" : "https://w3id.org/emmo/domain/pm-multiscale#MagneticAnisotropyConstantK3",
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.w3.org/2002/07/owl#Class"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "K3 is the third-order magnetocrystalline anisotropy constant, a direct higher-order sibling of magmo:MagnetocrystallineAnisotropyConstantK2 and magmo:MagnetocrystallineAnisotropyConstantK1; the ontology has K1 and K2 but lacks K3, making this a genuine gap requiring a new subclass under the same parent."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/emmo/domain/pm-multiscale"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "magnetic anisotropy constant k3"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/emmo/domain/magnetic-material#MagnetocrystallineAnisotropyConstantK2"
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "magnetic anisotropy constant k3"
  } ]
}, {
  "@id" : "https://w3id.org/emmo/domain/pm-multiscale#MagneticAnisotropyConstantK4",
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.w3.org/2002/07/owl#Class"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Magnetic anisotropy constant K4 is the fourth-order uniaxial magnetocrystalline anisotropy constant; while magmo:MagnetocrystallineAnisotropyConstantK2 is the closest existing class (second-order), K4 is a distinct higher-order term not currently represented, requiring a new subclass MagnetocrystallineAnisotropyConstantK4 under magmo:UniaxialAnisotropyConstant."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/emmo/domain/pm-multiscale"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "magnetic anisotropy constant k4"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/emmo/domain/magnetic-material#UniaxialAnisotropyConstant"
  } ],
  "http://www.w3.org/2004/02/skos/core#note" : [ {
    "@language" : "en",
    "@value" : "How is the magnetic anisotropy constant K4 computed? — extracted by fitting the torque curve from constrained Monte Carlo simulations"
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "magnetic anisotropy constant k4"
  } ]
}, {
  "@id" : "https://w3id.org/emmo/domain/pm-multiscale#MagneticExchangeConstant",
  "http://www.w3.org/2004/02/skos/core#note" : [ {
    "@language" : "en",
    "@value" : "How is the magnetic exchange constant computed? — obtained via the Liechtenstein real-space approach using SPR-KKR"
  } ]
}, {
  "@id" : "https://w3id.org/emmo/domain/pm-multiscale#MagneticExchangeCouplingConstant",
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.w3.org/2002/07/owl#Class"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "The magnetic exchange coupling constant J (pairwise R-Fe, Fe-Fe) is a distinct atomistic quantity from magmo:ExchangeStiffnessConstant (a micromagnetic continuum parameter); no existing magmo: class captures the pairwise Heisenberg exchange parameter, so a new subclass is required under the exchange interaction branch."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/emmo/domain/pm-multiscale"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "magnetic exchange coupling constant"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/emmo/domain/magnetic-material#ExchangeStiffnessConstant"
  } ],
  "http://www.w3.org/2004/02/skos/core#note" : [ {
    "@language" : "en",
    "@value" : "How is the magnetic exchange coupling constant calculated? — calculated using the Liechtenstein formula"
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "magnetic exchange coupling constant"
  } ]
}, {
  "@id" : "https://w3id.org/emmo/domain/pm-multiscale#MagneticForceTheorem",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.w3.org/2002/07/owl#Class"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "The magnetic force theorem is a first-principles electronic-structure method for computing intersite exchange parameters Jij via second derivatives of total energy w.r.t. spin rotations; it fits under emmo:ElectronicModel as a quantum-mechanical computational approach, and no existing pm: or magmo: class captures this specific perturbative energy-derivative technique."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/emmo/domain/pm-multiscale"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "magnetic force theorem"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/emmo#ElectronicModel"
  } ],
  "http://www.w3.org/2004/02/skos/core#note" : [ {
    "@language" : "en",
    "@value" : "How are exchange parameters Jij computed using the magnetic force theorem? — computing intersite exchange parameters Jij from the second derivative of the total energy with respect to spin rotations, without performing full self-consistent calculations"
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "magnetic force theorem"
  } ],
  "https://w3id.org/emmo/domain/pm-multiscale#hasScaleLevel" : [ {
    "@id" : "https://w3id.org/emmo/domain/pm-multiscale#ElectronicScale"
  } ]
}, {
  "@id" : "https://w3id.org/emmo/domain/pm-multiscale#MagneticHardnessParameter",
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.w3.org/2002/07/owl#Class"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "The magnetic hardness parameter κ = √(K1/μ0Ms²) is a dimensionless figure of merit for hard magnets not represented in magmo:ExtrinsicMagneticProperties or any existing class; a new subclass is needed per the gap criterion."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/emmo/domain/pm-multiscale"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "magnetic hardness parameter"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/emmo/domain/magnetic-material#ExtrinsicMagneticProperties"
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "magnetic hardness parameter"
  } ]
}, {
  "@id" : "https://w3id.org/emmo/domain/pm-multiscale#MagneticHyperfineField",
  "http://www.w3.org/2004/02/skos/core#note" : [ {
    "@language" : "en",
    "@value" : "How is the magnetic hyperfine field measured? — measured by Mössbauer spectroscopy"
  }, {
    "@language" : "en",
    "@value" : "What is the magnetic hyperfine field used for? — used to estimate local magnetic moments"
  } ]
}, {
  "@id" : "https://w3id.org/emmo/domain/pm-multiscale#MagneticPermeabilityOfVacuum",
  "http://www.w3.org/2004/02/skos/core#note" : [ {
    "@language" : "en",
    "@value" : "What is the magnetic permeability of vacuum used for? — used in the magnetostatic potential equations for the conical magnet"
  } ]
}, {
  "@id" : "https://w3id.org/emmo/domain/pm-multiscale#MagneticReluctivity",
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.w3.org/2002/07/owl#Class"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Magnetic reluctivity (ν = 1/μ, units m/H) is the reciprocal of permeability and a distinct quantity used in FEM motor optimization; it is not covered by magmo:AbsolutePermeability but is its logical inverse, requiring a new sibling class under the EMMO Quantity branch for magnetic field-response properties."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/emmo/domain/pm-multiscale"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "magnetic reluctivity"
  } ],
