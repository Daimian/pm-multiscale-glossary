}, {
  "@id" : "https://w3id.org/emmo/domain/pm-multiscale#MagnetocrystallineAnisotropyConstantK3",
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.w3.org/2002/07/owl#Class"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "K3 is the third-order uniaxial magnetocrystalline anisotropy constant of Nd2Fe14B, a direct higher-order sibling of the existing magmo:MagnetocrystallineAnisotropyConstantK2; no existing magmo: class covers K3, requiring a new class as a sibling under the same parent in the EMMO Quantity branch."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/emmo/domain/pm-multiscale"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "magnetocrystalline anisotropy constant k3"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/emmo/domain/magnetic-material#MagnetocrystallineAnisotropyConstantK2"
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "magnetocrystalline anisotropy constant k3"
  } ]
}, {
  "@id" : "https://w3id.org/emmo/domain/pm-multiscale#MagnetoelasticAnisotropy",
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.w3.org/2002/07/owl#Class"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Magnetoelastic anisotropy is a distinct physical mechanism (stress-magnetostriction coupling) not captured by any existing magmo: anisotropy subclass; it requires a new subclass under magmo:MagneticAnisotropy to preserve ontological rigidity of the mechanism."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/emmo/domain/pm-multiscale"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "magnetoelastic anisotropy"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/emmo/domain/magnetic-material#MagneticAnisotropy"
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "magnetoelastic anisotropy"
  } ]
}, {
  "@id" : "https://w3id.org/emmo/domain/pm-multiscale#MagnetostaticField",
  "http://www.w3.org/2004/02/skos/core#note" : [ {
    "@language" : "en",
    "@value" : "What is the magnetostatic field used for? — contributing to spin disorder"
  } ]
}, {
  "@id" : "https://w3id.org/emmo/domain/pm-multiscale#Magnetostriction",
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.w3.org/2002/07/owl#Class"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Magnetostriction (magnetoelastic coupling coefficient λ) is a distinct intrinsic magnetic quantity not represented by any existing magmo: class; a new subclass under magmo:InducedMagneticAnisotropy (the closest magnetoelastic parent) is required per the gap criterion."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/emmo/domain/pm-multiscale"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "magnetostriction"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/emmo/domain/magnetic-material#InducedMagneticAnisotropy"
  }, {
    "@id" : "_:genid61"
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "magnetostriction"
  } ]
}, {
  "@id" : "https://w3id.org/emmo/domain/pm-multiscale#MagnetostrictionConstant",
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.w3.org/2002/07/owl#Class"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "λs is a dimensionless intrinsic material constant quantifying magneto-elastic coupling; no existing magmo: class covers magnetostriction constants, making it a genuine ontology gap requiring a new sibling class alongside magmo:MagnetocrystallineAnisotropyConstantK1 under the intrinsic-property branch."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/emmo/domain/pm-multiscale"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "magnetostriction constant"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/emmo/domain/magnetic-material#MagnetocrystallineAnisotropyConstantK1"
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "magnetostriction constant"
  } ]
}, {
  "@id" : "https://w3id.org/emmo/domain/pm-multiscale#MeanFieldApproximation",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/emmo/domain/pm-multiscale#ScaleBridgingAssumption"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Maps DFT-computed exchange integrals to the Heisenberg Hamiltonian, treating spin-spin interactions in a mean-field framework."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "Mean-field approximation"
  } ]
