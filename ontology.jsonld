}, {
  "@id" : "https://w3id.org/emmo/domain/pm-multiscale#NoncollinearCalculation",
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.w3.org/2002/07/owl#Class"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Noncollinear calculation is a DFT computational configuration that allows arbitrary spin orientations, required for accurate magnetocrystalline anisotropy computation in permanent magnets; it is a sub-method of pm:DFTStep not currently represented as a distinct class, warranting a new subclass under emmo:Computation."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/emmo/domain/pm-multiscale"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "noncollinear calculation"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/emmo#Computation"
  } ],
  "http://www.w3.org/2004/02/skos/core#note" : [ {
    "@language" : "en",
    "@value" : "What is a noncollinear calculation used for? — required for accurate computation of magnetic anisotropy energy"
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "noncollinear calculation"
  } ]
}, {
  "@id" : "https://w3id.org/emmo/domain/pm-multiscale#NoncollinearMagneticCalculation",
  "http://www.w3.org/2004/02/skos/core#note" : [ {
    "@language" : "en",
    "@value" : "How is a noncollinear magnetic calculation performed? — A DFT calculation in which spin directions are not constrained to be parallel or antiparallel, allowing treatment of spin canting, spin spirals, and complex magnetic textures"
  } ]
}, {
  "@id" : "https://w3id.org/emmo/domain/pm-multiscale#Noncollinearmagneticcalculation",
