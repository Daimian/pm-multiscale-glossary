  } ]
}, {
  "@id" : "https://w3id.org/emmo/domain/pm-multiscale#PreisachModel",
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.w3.org/2002/07/owl#Class"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "The Preisach model is a classical phenomenological hysteresis model based on bistable magnetic units with a distribution function, used to describe macroscopic hysteresis loops in permanent magnets; it is an emmo:MaterialsModel at the continuum/phenomenological level, and no existing pm: class represents hysteresis distribution models."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/emmo/domain/pm-multiscale"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "preisach model"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/emmo#MaterialsModel"
  } ],
  "http://www.w3.org/2004/02/skos/core#note" : [ {
    "@language" : "en",
    "@value" : "What is the Preisach model used for? — A classical model of hysteresis based on bistable magnetic units with a fixed distribution function"
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "preisach model"
  } ]
}, {
  "@id" : "https://w3id.org/emmo/domain/pm-multiscale#PropertyDetermination",
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.w3.org/2002/07/owl#Class"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "How a property value was obtained: computationally (DFT, micromagnetics, ML) or experimentally (VSM, SQUID, PPMS)."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "PropertyDetermination"
  } ],
  "http://www.w3.org/2002/07/owl#equivalentClass" : [ {
    "@id" : "_:genid97"
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "PropertyDetermination"
  } ]
}, {
  "@id" : "https://w3id.org/emmo/domain/pm-multiscale#PropertyPrediction",
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.w3.org/2002/07/owl#Class"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "A machine-learning prediction of extrinsic magnetic properties (Hc, Mr, BHmax) from intrinsic parameters (Ms, A, K1). Example: mammos-ai Random Forest models."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "PropertyPrediction"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "_:genid100"
  }, {
    "@id" : "_:genid101"
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "PropertyPrediction"
  } ]
}, {
  "@id" : "https://w3id.org/emmo/domain/pm-multiscale#PropertySource",
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.w3.org/2002/07/owl#Class"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Where in a publication a property value is found: running text, a table cell, or extracted from a figure."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "PropertySource"
  } ],
  "http://www.w3.org/2002/07/owl#equivalentClass" : [ {
    "@id" : "_:genid102"
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "PropertySource"
  } ]
}, {
  "@id" : "https://w3id.org/emmo/domain/pm-multiscale#PropertySynonym",
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.w3.org/2002/07/owl#Class"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "An alternative name or symbol for a magnetic property used in the literature. Example: coercivity appears as Hc, Hci, iHc, jHc, or BHc."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "PropertySynonym"
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "PropertySynonym"
  } ]
}, {
  "@id" : "https://w3id.org/emmo/domain/pm-multiscale#QuasiharmonicApproximation",
  "http://www.w3.org/2004/02/skos/core#note" : [ {
    "@language" : "en",
    "@value" : "How is the quasiharmonic approximation computed? — sampling phonon modes at the Gamma point of a supercell, accounting for volume-dependent frequency changes"
  } ]
}, {
  "@id" : "https://w3id.org/emmo/domain/pm-multiscale#RandomAnisotropyModel",
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.w3.org/2002/07/owl#Class"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "The random anisotropy model is a continuum-level theoretical framework describing how spatially disordered anisotropy axes are averaged by exchange interactions in nanocrystalline magnets; it fits emmo:ContinuumModel because it operates at the mesoscale/continuum level, and no existing pm: class captures this microstructural averaging model."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/emmo/domain/pm-multiscale"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "random anisotropy model"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/emmo#ContinuumModel"
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "random anisotropy model"
  } ]
}, {
  "@id" : "https://w3id.org/emmo/domain/pm-multiscale#Randomanisotropymodel",
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.w3.org/2002/07/owl#Class"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "_:genid106"
  } ]
}, {
  "@id" : "https://w3id.org/emmo/domain/pm-multiscale#Rareearthsite",
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.w3.org/2002/07/owl#Class"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "_:genid107"
  } ]
}, {
  "@id" : "https://w3id.org/emmo/domain/pm-multiscale#RemanenceEnhancement",
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.w3.org/2002/07/owl#Class"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Remanence enhancement is a distinct phenomenon (exchange-coupling-driven increase above Stoner-Wohlfarth limit) not captured by magmo:Remanence alone; a new subclass under magmo:Remanence is needed per the ontological gap criterion."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/emmo/domain/pm-multiscale"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "remanence enhancement"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/emmo/domain/magnetic-material#Remanence"
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "remanence enhancement"
  } ]
}, {
  "@id" : "https://w3id.org/emmo/domain/pm-multiscale#ReportedPropertyValue",
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.w3.org/2002/07/owl#Class"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "A specific magnetic property value as reported in a paper, with its context: material, method, temperature, unit, and location in the paper."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "ReportedPropertyValue"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "_:genid108"
  }, {
    "@id" : "_:genid109"
  }, {
    "@id" : "_:genid110"
  }, {
    "@id" : "_:genid111"
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "ReportedPropertyValue"
  } ]
}, {
  "@id" : "https://w3id.org/emmo/domain/pm-multiscale#ReproducibilityAssessment",
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.w3.org/2002/07/owl#Class"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "An evaluation of whether a paper reports sufficient parameters to reproduce its computational results. Score 0-1 based on completeness of inputs."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "ReproducibilityAssessment"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "_:genid112"
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "ReproducibilityAssessment"
  } ]
}, {
  "@id" : "https://w3id.org/emmo/domain/pm-multiscale#ResearchGroup",
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.w3.org/2002/07/owl#Class"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "The research group or institution that performed the study. Enables tracking which groups produce comparable results."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "ResearchGroup"
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "ResearchGroup"
  } ]
}, {
  "@id" : "https://w3id.org/emmo/domain/pm-multiscale#Running",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/emmo/domain/pm-multiscale#StepStatus"
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "Running"
  } ]
}, {
  "@id" : "https://w3id.org/emmo/domain/pm-multiscale#ScaleBridgingAssumption",
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.w3.org/2002/07/owl#Class"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "A physical assumption that justifies mapping parameters between scales. Example: mean-field approximation connecting DFT exchange integrals to the atomistic Heisenberg Hamiltonian."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "ScaleBridgingAssumption"
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "ScaleBridgingAssumption"
  } ]
}, {
  "@id" : "https://w3id.org/emmo/domain/pm-multiscale#ScaleLevel",
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.w3.org/2002/07/owl#Class"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "The characteristic spatial and temporal scale at which a simulation operates: electronic (angstrom/femtosecond), atomistic (nanometer/picosecond), or mesoscopic (micrometer/nanosecond)."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "ScaleLevel"
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "ScaleLevel"
