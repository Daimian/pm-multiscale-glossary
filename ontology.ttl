###  https://w3id.org/emmo/domain/pm-multiscale#AllenCahnEquation
:AllenCahnEquation rdf:type owl:Class ;
                   rdfs:subClassOf <https://w3id.org/emmo#ContinuumModel> ;
                   rdfs:comment "The Allen-Cahn equation is a continuum PDE governing order-parameter evolution for phase-field modeling, used here for rotor pole shape optimization in permanent magnet motor design; it is a canonical emmo:ContinuumModel (phase-field), and no existing pm: class covers phase-field continuum equations."@en ;
                   rdfs:isDefinedBy <https://w3id.org/emmo/domain/pm-multiscale> ;
                   rdfs:label "allen-cahn equation" ;
                   <http://www.w3.org/2004/02/skos/core#note> "What is the Allen-Cahn equation used for? — used here for rotor pole shape optimization"@en ;
                   <http://www.w3.org/2004/02/skos/core#prefLabel> "allen-cahn equation"@en .


###  https://w3id.org/emmo/domain/pm-multiscale#AndersonImpurityModel
:AndersonImpurityModel rdf:type owl:Class ;
                       rdfs:subClassOf <https://w3id.org/emmo#ElectronicModel> .


###  https://w3id.org/emmo/domain/pm-multiscale#Andersonimpuritymodel
:Andersonimpuritymodel rdf:type owl:Class ;
                       rdfs:subClassOf [ rdf:type owl:Restriction ;
                                         owl:onProperty :hasScaleLevel ;
                                         owl:hasValue :Electronicscale
                                       ] .


