    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Annotations
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    <rdf:Description rdf:about="https://w3id.org/emmo/domain/pm-multiscale#AmorphousGrainBoundaryPhase">
        <skos:note xml:lang="en">What is the amorphous grain boundary phase used for? — provides magnetic isolation between SmFe12 grains</skos:note>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/emmo/domain/pm-multiscale#AndersonImpurityModel">
        <rdfs:comment xml:lang="en">The Anderson impurity model describes hybridisation of localised 4f states with conduction electrons in rare-earth PM compounds; it is IN_SCOPE as an electronic-structure model and a GAP because emmo:ElectronicModel has no sub-class for quantum impurity models distinct from DFT or tight-binding approaches.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/domain/pm-multiscale"/>
        <rdfs:label>anderson impurity model</rdfs:label>
        <skos:prefLabel xml:lang="en">anderson impurity model</skos:prefLabel>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/emmo/domain/pm-multiscale#AndersonModel">
        <skos:note xml:lang="en">What is the Anderson model used for? — from which the Kondo model is derived via the Schrieffer-Wolff transformation</skos:note>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/emmo/domain/pm-multiscale#ClassicalHeisenbergModel">
        <rdfs:comment xml:lang="en">The classical Heisenberg model is an atomistic spin Hamiltonian parameterized by exchange coupling constants Jij used to compute Curie temperature; it is a canonical emmo:AtomisticModel for spin-lattice simulations, and no existing pm: class represents this Hamiltonian model.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/domain/pm-multiscale"/>
        <rdfs:label>classical heisenberg model</rdfs:label>
        <skos:prefLabel xml:lang="en">classical heisenberg model</skos:prefLabel>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/emmo/domain/pm-multiscale#CoherentPotentialApproximation">
        <skos:note xml:lang="en">How are electronic and magnetic properties of disordered alloys computed? — effective medium theory used to compute electronic and magnetic properties of disordered alloys by replacing the random potential with an effective coherent potential</skos:note>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/emmo/domain/pm-multiscale#CrystalFieldTheory">
        <rdfs:comment xml:lang="en">Crystal field theory is a quantum-mechanical framework computing electrostatic interactions between rare-earth 4f electrons and the surrounding crystal lattice, directly relevant to magnetocrystalline anisotropy in permanent magnets; it is an emmo:ElectronicModel, and no existing pm: class captures this ligand-field approach.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/domain/pm-multiscale"/>
        <rdfs:label>crystal field theory</rdfs:label>
        <skos:note xml:lang="en">How is crystal field theory computed? — using point charge model to calculate the electrostatic interaction between rare-earth ion 4f electrons and surrounding crystal environment</skos:note>
        <skos:prefLabel xml:lang="en">crystal field theory</skos:prefLabel>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/emmo/domain/pm-multiscale#DepinningCoercivity">
        <skos:note xml:lang="en">What is depinning coercivity used for? — determining coercivity in the depinning-type magnetization reversal mechanism</skos:note>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/emmo/domain/pm-multiscale#DipoleField">
        <skos:note xml:lang="en">How is the dipole field computed? — computed via the demagnetization tensor</skos:note>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/emmo/domain/pm-multiscale#DomainNucleation">
        <rdfs:comment xml:lang="en">Domain nucleation is a magnetisation-reversal mechanism central to coercivity modelling in permanent magnets; no existing pm: or magmo: class captures nucleation as a distinct process, requiring a new subclass under pm:MicromagneticsStep.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/domain/pm-multiscale"/>
        <rdfs:label>domain nucleation</rdfs:label>
        <skos:prefLabel xml:lang="en">domain nucleation</skos:prefLabel>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/emmo/domain/pm-multiscale#DomainWallMotion">
        <rdfs:comment xml:lang="en">Domain wall motion is a distinct magnetization-change process simulated in micromagnetics workflows (pm:MicromagneticsStep) but not represented as its own class; a new subclass is needed per the gap criterion.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/domain/pm-multiscale"/>
        <rdfs:label>domain wall motion</rdfs:label>
        <skos:note xml:lang="en">What is domain wall motion used for? — the primary mechanism of magnetization change in materials with well-defined domain structures</skos:note>
        <skos:prefLabel xml:lang="en">domain wall motion</skos:prefLabel>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/emmo/domain/pm-multiscale#DomainWallPropagation">
        <rdfs:comment xml:lang="en">Domain wall propagation is a magnetisation-reversal mechanism (Barkhausen jumps) central to coercivity in permanent magnets and modelled in micromagnetics; no existing pm: or magmo: class captures wall motion as a distinct process.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/domain/pm-multiscale"/>
        <rdfs:label>domain wall propagation</rdfs:label>
        <skos:prefLabel xml:lang="en">domain wall propagation</skos:prefLabel>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/emmo/domain/pm-multiscale#DynamicalMeanFieldTheory">
        <rdfs:comment xml:lang="en">Dynamical mean-field theory (DMFT) is a many-body electronic-structure method treating local electron correlations beyond DFT, applied to Sm 4f electrons in permanent magnet calculations; it is a subclass of emmo:ElectronicModel, and no existing pm: class covers correlated-electron many-body methods.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/domain/pm-multiscale"/>
        <rdfs:label>dynamical mean-field theory</rdfs:label>
        <skos:note xml:lang="en">How is dynamical mean-field theory computed? — applied here with the Hubbard I approximation for Sm 4f electrons and STPF solver for Co 3d electrons</skos:note>
        <skos:note xml:lang="en">What is dynamical mean field theory used for? — combined with first-principles band structure calculations for finite-temperature magnetism</skos:note>
        <skos:prefLabel xml:lang="en">dynamical mean-field theory</skos:prefLabel>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/emmo/domain/pm-multiscale#EffectiveAnisotropyField">
        <skos:note xml:lang="en">What is the effective anisotropy field used for? — used in the LLG equation to compute resonance frequency</skos:note>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/emmo/domain/pm-multiscale#FccStructure">
        <skos:note xml:lang="en">What transformation must fcc structure undergo to acquire hard magnetic properties? — must be transformed to fct for hard magnetic properties</skos:note>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/emmo/domain/pm-multiscale#FermiDiracSmearing">
        <skos:note xml:lang="en">How are Kohn-Sham states occupied in DFT calculations? — Fermi-Dirac distribution with width 0.01 eV used to occupy Kohn-Sham states in the DFT calculation</skos:note>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/emmo/domain/pm-multiscale#ForceTheorem">
        <skos:note xml:lang="en">What is the force theorem used for? — used to calculate magnetocrystalline anisotropy energy by comparing band energies along different magnetization directions</skos:note>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/emmo/domain/pm-multiscale#FullPotentialLinearMuffinTinOrbitalMethod">
        <skos:note xml:lang="en">How is the full-potential linear muffin-tin orbital method implemented? — implemented in RSPt</skos:note>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/emmo/domain/pm-multiscale#FullPotentialLmtoMethod">
        <skos:note xml:lang="en">How is magnetocrystalline anisotropy energy computed using the full-potential LMTO method? — A full-potential linear muffin-tin orbital computational method (RSPt code) used to compute magnetocrystalline anisotropy energy with spin-orbit coupling treated post-SCF</skos:note>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/emmo/domain/pm-multiscale#GaussianDistributionOfEasyAxes">
        <skos:note xml:lang="en">What does the Gaussian distribution of easy axes describe? — used to describe the angular spread of grain easy axes in oriented nanocrystalline magnets</skos:note>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/emmo/domain/pm-multiscale#HeisenbergModelHamiltonian">
        <rdfs:comment xml:lang="en">The Heisenberg model Hamiltonian is the classical spin Hamiltonian parameterising pairwise exchange interactions between atomic sites in PM spin-dynamics simulations; it is IN_SCOPE and a GAP because pm:SpinDynamicsConfiguration covers solver/configuration settings but not the Hamiltonian functional form as a model class.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/domain/pm-multiscale"/>
        <rdfs:label>heisenberg model hamiltonian</rdfs:label>
        <skos:prefLabel xml:lang="en">heisenberg model hamiltonian</skos:prefLabel>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/emmo/domain/pm-multiscale#HubbardIApproximation">
        <rdfs:comment xml:lang="en">The Hubbard-I approximation is a many-body electronic-structure method for treating localised 4f electrons in rare-earth PM compounds; it is IN_SCOPE and a GAP because pm:ExchangeCorrelationFunctional covers DFT XC functionals but not beyond-DFT many-body impurity solvers.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/domain/pm-multiscale"/>
        <rdfs:label>hubbard i approximation</rdfs:label>
        <skos:note xml:lang="en">How is the Hubbard I approximation computed? — neglecting hybridization in the DMFT impurity problem, approximating the self-energy by the atomic self-energy</skos:note>
        <skos:prefLabel xml:lang="en">hubbard i approximation</skos:prefLabel>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/emmo/domain/pm-multiscale#HubbardUPotential">
        <skos:note xml:lang="en">How is the Hubbard U potential computed? — A phenomenological on-site Coulomb correction term added to DFT to better describe strongly correlated d or f electrons</skos:note>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/emmo/domain/pm-multiscale#InPlaneMagneticAnisotropy">
        <skos:note xml:lang="en">What is in-plane magnetic anisotropy used for? — which is unfavorable for permanent magnet applications</skos:note>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/emmo/domain/pm-multiscale#IntersiteExchangeCouplingParameter">
        <skos:note xml:lang="en">How is the intersite exchange coupling parameter computed? — calculated via linear-response to small-angle spin fluctuations</skos:note>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/emmo/domain/pm-multiscale#IsothermalRemanentMagnetization">
        <skos:note xml:lang="en">What is isothermal remanent magnetization used for? — used to construct Henkel plots</skos:note>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/emmo/domain/pm-multiscale#MagneticExchangeConstant">
        <skos:note xml:lang="en">How is the magnetic exchange constant computed? — obtained via the Liechtenstein real-space approach using SPR-KKR</skos:note>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/emmo/domain/pm-multiscale#MagneticForceTheorem">
        <rdfs:comment xml:lang="en">The magnetic force theorem is a first-principles electronic-structure method for computing intersite exchange parameters Jij via second derivatives of total energy w.r.t. spin rotations; it fits under emmo:ElectronicModel as a quantum-mechanical computational approach, and no existing pm: or magmo: class captures this specific perturbative energy-derivative technique.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/domain/pm-multiscale"/>
        <rdfs:label>magnetic force theorem</rdfs:label>
        <skos:note xml:lang="en">How are exchange parameters Jij computed using the magnetic force theorem? — computing intersite exchange parameters Jij from the second derivative of the total energy with respect to spin rotations, without performing full self-consistent calculations</skos:note>
        <skos:prefLabel xml:lang="en">magnetic force theorem</skos:prefLabel>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/emmo/domain/pm-multiscale#MagneticHyperfineField">
        <skos:note xml:lang="en">How is the magnetic hyperfine field measured? — measured by Mössbauer spectroscopy</skos:note>
        <skos:note xml:lang="en">What is the magnetic hyperfine field used for? — used to estimate local magnetic moments</skos:note>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/emmo/domain/pm-multiscale#MagneticPermeabilityOfVacuum">
        <skos:note xml:lang="en">What is the magnetic permeability of vacuum used for? — used in the magnetostatic potential equations for the conical magnet</skos:note>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/emmo/domain/pm-multiscale#MagnetizationReversal">
        <rdfs:comment xml:lang="en">Magnetization reversal is a core micromagnetic process simulated in pm:MicromagneticsStep workflows but is not itself an existing class; a new subclass under pm:MicromagneticsStep captures the switching process per the gap criterion.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/domain/pm-multiscale"/>
        <rdfs:label>magnetization reversal</rdfs:label>
        <skos:prefLabel xml:lang="en">magnetization reversal</skos:prefLabel>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/emmo/domain/pm-multiscale#MagnetostaticField">
        <skos:note xml:lang="en">What is the magnetostatic field used for? — contributing to spin disorder</skos:note>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/emmo/domain/pm-multiscale#MonteCarloAlgorithm">
        <skos:note xml:lang="en">What is the Monte Carlo algorithm used for? — used to calculate equilibrium magnetic properties such as temperature-dependent magnetization by averaging over thermally accessible spin configurations</skos:note>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/emmo/domain/pm-multiscale#MonteCarloStep">
        <skos:note xml:lang="en">How is a Monte Carlo step defined? — corresponding to one attempted spin flip per lattice site on average</skos:note>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/emmo/domain/pm-multiscale#MuffinTinApproximation">
        <skos:note xml:lang="en">How is the crystal potential approximated in the muffin-tin approximation? — crystal potential is spherically symmetric within non-overlapping spheres (muffin tins) centered on each atom and constant in the interstitial region</skos:note>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/emmo/domain/pm-multiscale#NoncollinearMagneticCalculation">
        <skos:note xml:lang="en">How is a noncollinear magnetic calculation performed? — A DFT calculation in which spin directions are not constrained to be parallel or antiparallel, allowing treatment of spin canting, spin spirals, and complex magnetic textures</skos:note>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/emmo/domain/pm-multiscale#QuasiharmonicApproximation">
        <skos:note xml:lang="en">How is the quasiharmonic approximation computed? — sampling phonon modes at the Gamma point of a supercell, accounting for volume-dependent frequency changes</skos:note>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/emmo/domain/pm-multiscale#SelfConsistentFieldCalculation">
        <skos:note xml:lang="en">How is the self-consistent field calculation performed? — Iterative DFT procedure to solve the Kohn-Sham equations self-consistently to obtain the ground-state electron density and magnetic moments</skos:note>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/emmo/domain/pm-multiscale#StochasticLandauLifshitzGilbert">
        <skos:note xml:lang="en">What is the stochastic Landau-Lifshitz-Gilbert method used for? — used in related coercivity studies</skos:note>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/emmo/domain/pm-multiscale#StochasticLandauLifshitzGilbertEquation">
        <rdfs:comment xml:lang="en">The stochastic LLG equation is an atomistic spin-dynamics equation of motion augmented with a Langevin noise term for thermal fluctuations; it extends the deterministic LLG and belongs under emmo:AtomisticModel, while pm:SpinDynamicsConfiguration could hold its configuration parameters but does not represent the model itself.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/domain/pm-multiscale"/>
        <rdfs:label>stochastic landau-lifshitz-gilbert equation</rdfs:label>
        <skos:note xml:lang="en">What is the stochastic LLG equation used for? — enabling simulation of thermally activated magnetization reversal</skos:note>
        <skos:prefLabel xml:lang="en">stochastic landau-lifshitz-gilbert equation</skos:prefLabel>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/emmo/domain/pm-multiscale#TemperatureCoefficientOfRemanence">
        <skos:note xml:lang="en">What is the temperature coefficient of remanence used for? — a key figure of merit for high-temperature permanent magnet applications</skos:note>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/emmo/domain/pm-multiscale#TwoSublatticeMeanFieldModel">
        <rdfs:comment xml:lang="en">The two-sublattice mean-field model describes RE-TM magnetic coupling via molecular field coefficients and is directly used to compute temperature-dependent magnetisation in PM materials; it is IN_SCOPE and a GAP because emmo:AtomisticModel has no sub-class for sublattice mean-field exchange models.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/emmo/domain/pm-multiscale"/>
        <rdfs:label>two-sublattice mean field model</rdfs:label>
        <skos:note xml:lang="en">What is the two-sublattice mean field model used for? — A model describing magnetic coupling between rare earth and transition metal sublattices</skos:note>
        <skos:prefLabel xml:lang="en">two-sublattice mean field model</skos:prefLabel>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/emmo/domain/pm-multiscale#TwoSublatticeMicromagneticModel">
        <skos:note xml:lang="en">What is the two-sublattice micromagnetic model used for? — to describe the magnetic excitation spectrum including acoustic, optic, and crystal-field modes</skos:note>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/emmo/domain/pm-multiscale#VacuumPermeability">
        <skos:note xml:lang="en">What is vacuum permeability used for? — used as a fundamental constant in the magnetic equations</skos:note>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/emmo/domain/pm-multiscale#VibratingSampleMagnetometer">
        <skos:note xml:lang="en">How is magnetization measured as a function of applied field and temperature? — An instrument (VSM) used to measure magnetization as a function of applied field and temperature</skos:note>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/emmo/domain/pm-multiscale#1:5Phase">
        <skos:note xml:lang="en">What is the 1:5 phase used for? — used in SmCo5 and PrCo5 permanent magnets</skos:note>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/emmo/domain/pm-multiscale#EnergyProductDifference(δ(bh)max)">
        <skos:note xml:lang="en">What is the energy product difference used for? — used as a measure of magnetic anisotropy</skos:note>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/emmo/domain/pm-multiscale#FullPotentialLinearizedAugmentedPlaneWave(flapw)Method">
        <skos:note xml:lang="en">How is the FLAPW method implemented? — implemented in WIEN2k</skos:note>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/emmo/domain/pm-multiscale#IdealEnergyProduct(2πms)2">
        <skos:note xml:lang="en">What is the ideal energy product used for? — used as a benchmark for comparing experimental energy products</skos:note>
    </rdf:Description>
    <rdf:Description rdf:about="https://w3id.org/emmo/domain/pm-multiscale#KkrGreen&apos;sFunctionMethod">
        <skos:note xml:lang="en">How is the KKR Green&apos;s function method used? — used to solve the Kohn-Sham equations in density functional theory calculations</skos:note>
    </rdf:Description>
    


