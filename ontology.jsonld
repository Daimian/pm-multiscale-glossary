    "@language" : "en",
    "@value" : "The transfer of computed parameter values from an upstream simulation step to a downstream step. Example: DFT-computed exchange integrals (Jij) passed to spin dynamics as Heisenberg Hamiltonian input."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "ParameterHandoff"
  } ],
