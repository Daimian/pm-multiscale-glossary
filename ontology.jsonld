}, {
  "@id" : "https://w3id.org/emmo/domain/pm-multiscale#BirchMurnaghanEquationOfState",
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.w3.org/2002/07/owl#Class"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "The Birch-Murnaghan equation of state is an empirical constitutive relation (energy vs. volume) used in ab initio workflows to extract equilibrium volume and bulk modulus; it is a MaterialLaw in EMMO terms, and no existing pm: class covers equation-of-state fitting methods."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://w3id.org/emmo/domain/pm-multiscale"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "birch-murnaghan equation of state"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/emmo#MaterialLaw"
  } ],
  "http://www.w3.org/2004/02/skos/core#note" : [ {
    "@language" : "en",
    "@value" : "What is the Birch-Murnaghan equation of state applied to? — extract equilibrium volume and bulk modulus from ab initio calculations"
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "birch-murnaghan equation of state"
  } ]
}, {
  "@id" : "https://w3id.org/emmo/domain/pm-multiscale#Birchmurnaghanequationofstate",
