:Fixedspinmomentmethod rdf:type owl:Class ;
                       rdfs:subClassOf [ rdf:type owl:Restriction ;
                                         owl:onProperty :hasScaleLevel ;
                                         owl:hasValue :Electronicscale
                                       ] .


###  https://w3id.org/emmo/domain/pm-multiscale#Flapwmethod
:Flapwmethod rdf:type owl:Class ;
             rdfs:subClassOf [ rdf:type owl:Restriction ;
                               owl:onProperty :hasScaleLevel ;
                               owl:hasValue :Electronicscale
                             ] .


###  https://w3id.org/emmo/domain/pm-multiscale#Frozenmagnoncalculation
:Frozenmagnoncalculation rdf:type owl:Class ;
                         rdfs:subClassOf [ rdf:type owl:Restriction ;
                                           owl:onProperty :hasScaleLevel ;
                                           owl:hasValue :Atomisticscale
                                         ] .


###  https://w3id.org/emmo/domain/pm-multiscale#Fullpotentiallmtomethod
:Fullpotentiallmtomethod rdf:type owl:Class ;
                         rdfs:subClassOf [ rdf:type owl:Restriction ;
                                           owl:onProperty :hasScaleLevel ;
                                           owl:hasValue :Electronicscale
                                         ] .


###  https://w3id.org/emmo/domain/pm-multiscale#Giantmagneticmoment
:Giantmagneticmoment rdf:type owl:Class ;
                     rdfs:subClassOf [ rdf:type owl:Restriction ;
                                       owl:onProperty :hasScaleLevel ;
                                       owl:hasValue :Electronicscale
                                     ] .


###  https://w3id.org/emmo/domain/pm-multiscale#GilbertDampingConstant
:GilbertDampingConstant rdf:type owl:Class ;
                        rdfs:subClassOf <https://w3id.org/emmo/domain/magnetic-material#ExchangeStiffnessConstant> ;
                        rdfs:comment "The Gilbert damping constant α is a dimensionless material parameter governing LLG spin dynamics, analogous in role to magmo:ExchangeStiffnessConstant as a micromagnetic material parameter; no existing class covers it, so a new sibling subclass is needed."@en ;
                        rdfs:isDefinedBy <https://w3id.org/emmo/domain/pm-multiscale> ;
                        rdfs:label "gilbert damping constant" ;
                        <http://www.w3.org/2004/02/skos/core#prefLabel> "gilbert damping constant"@en .


###  https://w3id.org/emmo/domain/pm-multiscale#GilbertEquationOfMotion
:GilbertEquationOfMotion rdf:type owl:Class ;
                         rdfs:subClassOf <https://w3id.org/emmo#MaterialsModel> ;
                         rdfs:comment "The Gilbert equation of motion is the dynamic equation for magnetization precession and damping, foundational to both micromagnetic and atomistic spin-dynamics simulations; it is a MaterialsModel governing magnetization dynamics, and while pm:SpinDynamicsConfiguration captures its parameters, no class represents the equation itself."@en ;
                         rdfs:isDefinedBy <https://w3id.org/emmo/domain/pm-multiscale> ;
                         rdfs:label "gilbert equation of motion" ;
                         <http://www.w3.org/2004/02/skos/core#prefLabel> "gilbert equation of motion"@en .


###  https://w3id.org/emmo/domain/pm-multiscale#HardAxis
:HardAxis rdf:type owl:Class ;
          rdfs:subClassOf <https://w3id.org/emmo/domain/magnetic-material#CrystallographicOrientation> ;
          rdfs:comment "Hard axis is a crystallographic direction concept directly relevant to magnetocrystalline anisotropy in permanent magnets; no existing magmo: class captures the hard-axis direction specifically, so a new subclass under magmo:CrystallographicOrientation is warranted."@en ;
          rdfs:isDefinedBy <https://w3id.org/emmo/domain/pm-multiscale> ;
          rdfs:label "hard axis" ;
          <http://www.w3.org/2004/02/skos/core#prefLabel> "hard axis"@en .


###  https://w3id.org/emmo/domain/pm-multiscale#HardGrain
:HardGrain rdf:type owl:Class ;
           rdfs:subClassOf <https://w3id.org/emmo/domain/magnetic-material#Grain> ;
           rdfs:comment "A hard grain is a rigid, sortal subtype of magmo:Grain distinguished by its switching-field criterion and bistable magnetisation states, a distinction not captured by any existing magmo: class annotation, making it a GAP requiring a new subclass under magmo:Grain."@en ;
           rdfs:isDefinedBy <https://w3id.org/emmo/domain/pm-multiscale> ;
           rdfs:label "hard grain" ;
           <http://www.w3.org/2004/02/skos/core#prefLabel> "hard grain"@en .


###  https://w3id.org/emmo/domain/pm-multiscale#HardMagnet
:HardMagnet rdf:type owl:Class ;
            rdfs:subClassOf :PermanentMagnetMaterial ;
            owl:disjointWith :SoftMagnet ;
            rdfs:comment "A permanent magnet with high coercivity (typically Hc > 400 kA/m), suitable for applications requiring stable magnetic fields: motors, generators, sensors."@en ;
            rdfs:label "HardMagnet" ;
            <http://www.w3.org/2004/02/skos/core#prefLabel> "HardMagnet"@en .


###  https://w3id.org/emmo/domain/pm-multiscale#Hardaxis
:Hardaxis rdf:type owl:Class ;
          rdfs:subClassOf [ rdf:type owl:Restriction ;
                            owl:onProperty :hasProperty ;
                            owl:someValuesFrom <https://w3id.org/emmo/domain/magnetic-material#MagnetocrystallineAnisotropy>
                          ] .


###  https://w3id.org/emmo/domain/pm-multiscale#HeisenbergExchangeParameter
:HeisenbergExchangeParameter rdf:type owl:Class ;
                             rdfs:subClassOf <https://w3id.org/emmo/domain/magnetic-material#ExchangeStiffnessConstant> ;
                             rdfs:comment "The Heisenberg exchange parameter J_ij is a pairwise site-resolved quantity distinct from the continuum magmo:ExchangeStiffnessConstant; it is an atomistic-scale input to Monte Carlo / spin-dynamics simulations and requires a new subclass under magmo:ExchangeStiffnessConstant in M3_Material."@en ;
                             rdfs:isDefinedBy <https://w3id.org/emmo/domain/pm-multiscale> ;
                             rdfs:label "heisenberg exchange parameter" ;
                             <http://www.w3.org/2004/02/skos/core#note> "What is the Heisenberg exchange parameter used for? — used as input to Monte Carlo simulations for Curie temperature determination"@en ;
                             <http://www.w3.org/2004/02/skos/core#prefLabel> "heisenberg exchange parameter"@en .


