  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "PeriodicBoundaryCondition"
  } ]
}, {
  "@id" : "https://w3id.org/emmo/domain/pm-multiscale#PermanentMagnetMaterial",
