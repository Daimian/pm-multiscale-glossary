                                                                ] .


###  https://w3id.org/emmo/domain/pm-multiscale#BasisSetSpecification
:BasisSetSpecification rdf:type owl:Class ;
                       rdfs:comment "The basis set type and size for a DFT calculation. For plane-wave codes (VASP): cutoff energy in eV. For LAPW codes (FLEUR): muffin-tin radius and lmax."@en ;
                       rdfs:label "BasisSetSpecification" ;
                       <http://www.w3.org/2004/02/skos/core#prefLabel> "BasisSetSpecification"@en .


###  https://w3id.org/emmo/domain/pm-multiscale#BirchMurnaghanEquationOfState
:BirchMurnaghanEquationOfState rdf:type owl:Class ;
                               rdfs:subClassOf <https://w3id.org/emmo#MaterialLaw> ;
                               rdfs:comment "The Birch-Murnaghan equation of state is an empirical constitutive relation (energy vs. volume) used in ab initio workflows to extract equilibrium volume and bulk modulus; it is a MaterialLaw in EMMO terms, and no existing pm: class covers equation-of-state fitting methods."@en ;
                               rdfs:isDefinedBy <https://w3id.org/emmo/domain/pm-multiscale> ;
                               rdfs:label "birch-murnaghan equation of state" ;
                               <http://www.w3.org/2004/02/skos/core#note> "What is the Birch-Murnaghan equation of state applied to? — extract equilibrium volume and bulk modulus from ab initio calculations"@en ;
                               <http://www.w3.org/2004/02/skos/core#prefLabel> "birch-murnaghan equation of state"@en .


###  https://w3id.org/emmo/domain/pm-multiscale#Birchmurnaghanequationofstate
:Birchmurnaghanequationofstate rdf:type owl:Class ;
                               rdfs:subClassOf [ rdf:type owl:Restriction ;
                                                 owl:onProperty :hasScaleLevel ;
                                                 owl:hasValue :Electronicscale
                                               ] .


###  https://w3id.org/emmo/domain/pm-multiscale#Blockexchangecouplingconstant
:Blockexchangecouplingconstant rdf:type owl:Class ;
                               rdfs:subClassOf [ rdf:type owl:Restriction ;
                                                 owl:onProperty :hasScaleLevel ;
                                                 owl:hasValue :Mesoscopicscale
                                               ] .


###  https://w3id.org/emmo/domain/pm-multiscale#BondedMagnet
:BondedMagnet rdf:type owl:Class ;
              rdfs:subClassOf <https://w3id.org/emmo/domain/magnetic-material#BulkMagnet> ;
              rdfs:comment "A bonded magnet is a composite permanent magnet form (powder in polymer/metallic binder) directly relevant to pm-multiscale simulation targets; it is a distinct subtype of magmo:BulkMagnet not currently represented as a named class in the ontology."@en ;
              rdfs:isDefinedBy <https://w3id.org/emmo/domain/pm-multiscale> ;
              rdfs:label "bonded magnet" ;
              <http://www.w3.org/2004/02/skos/core#prefLabel> "bonded magnet"@en .


###  https://w3id.org/emmo/domain/pm-multiscale#BoundaryCondition
:BoundaryCondition rdf:type owl:Class ;
                   rdfs:comment "The boundary condition applied to the simulation domain: periodic (infinite crystal), open (isolated particle), or mixed."@en ;
                   rdfs:label "BoundaryCondition" ;
                   <http://www.w3.org/2004/02/skos/core#prefLabel> "BoundaryCondition"@en .


###  https://w3id.org/emmo/domain/pm-multiscale#CahnHilliardEquation
:CahnHilliardEquation rdf:type owl:Class ;
                      rdfs:subClassOf <https://w3id.org/emmo#ContinuumModel> ;
                      rdfs:comment "The Cahn-Hilliard equation is a continuum PDE governing conserved concentration-field evolution in phase-field solidification models for PM microstructure formation; it is IN_SCOPE as a continuum model component and a GAP because no existing pm: class covers phase-field PDE formulations."@en ;
                      rdfs:isDefinedBy <https://w3id.org/emmo/domain/pm-multiscale> ;
                      rdfs:label "cahn-hilliard equation" ;
                      <http://www.w3.org/2004/02/skos/core#note> "What does the Cahn-Hilliard equation govern? — governing the conserved concentration field evolution during solidification in the CF-MPF model"@en ;
                      <http://www.w3.org/2004/02/skos/core#prefLabel> "cahn-hilliard equation"@en .


###  https://w3id.org/emmo/domain/pm-multiscale#Cahnhilliardequation
:Cahnhilliardequation rdf:type owl:Class ;
                      rdfs:subClassOf [ rdf:type owl:Restriction ;
                                        owl:onProperty :hasScaleLevel ;
                                        owl:hasValue :Mesoscopicscale
                                      ] .


###  https://w3id.org/emmo/domain/pm-multiscale#Chargeselfconsistency
:Chargeselfconsistency rdf:type owl:Class ;
                       rdfs:subClassOf [ rdf:type owl:Restriction ;
                                         owl:onProperty :hasScaleLevel ;
                                         owl:hasValue :Electronicscale
                                       ] .


###  https://w3id.org/emmo/domain/pm-multiscale#ClassicalHeisenbergModel
:ClassicalHeisenbergModel rdf:type owl:Class ;
                          rdfs:subClassOf <https://w3id.org/emmo#AtomisticModel> .


###  https://w3id.org/emmo/domain/pm-multiscale#Classicalheisenbergmodel
:Classicalheisenbergmodel rdf:type owl:Class ;
                          rdfs:subClassOf [ rdf:type owl:Restriction ;
                                            owl:onProperty :hasScaleLevel ;
                                            owl:hasValue :Atomisticscale
                                          ] .


###  https://w3id.org/emmo/domain/pm-multiscale#Coherentpotentialapproximation
:Coherentpotentialapproximation rdf:type owl:Class ;
                                rdfs:subClassOf [ rdf:type owl:Restriction ;
                                                  owl:onProperty :hasScaleLevel ;
                                                  owl:hasValue :Electronicscale
                                                ] .


###  https://w3id.org/emmo/domain/pm-multiscale#ColumnarGrains
:ColumnarGrains rdf:type owl:Class ;
                rdfs:subClassOf <https://w3id.org/emmo/domain/magnetic-material#Grain> ;
                rdfs:comment "Columnar grains are a rigid, sortal morphological subtype of magmo:Grain (elongated, film-perpendicular orientation) not distinguished by any existing magmo: annotation; they require a new subclass under magmo:Grain to capture their pinning-site role in thin-film PM microstructure."@en ;
                rdfs:isDefinedBy <https://w3id.org/emmo/domain/pm-multiscale> ;
                rdfs:label "columnar grains" ;
                <http://www.w3.org/2004/02/skos/core#prefLabel> "columnar grains"@en .


###  https://w3id.org/emmo/domain/pm-multiscale#ComputationalDetermination
:ComputationalDetermination rdf:type owl:Class ;
                            rdfs:subClassOf :PropertyDetermination ;
                            owl:disjointWith :ExperimentalDetermination ;
                            rdfs:comment "A property value obtained through computational simulation: DFT, spin dynamics, micromagnetics, or machine-learning prediction."@en ;
                            rdfs:label "ComputationalDetermination" ;
                            <http://www.w3.org/2004/02/skos/core#prefLabel> "ComputationalDetermination"@en .


###  https://w3id.org/emmo/domain/pm-multiscale#ConvergenceCriterion
:ConvergenceCriterion rdf:type owl:Class ;
                      rdfs:comment "The threshold for declaring a simulation converged: energy difference, force residual, or magnetization change between iterations."@en ;
                      rdfs:label "ConvergenceCriterion" ;
                      <http://www.w3.org/2004/02/skos/core#prefLabel> "ConvergenceCriterion"@en .


###  https://w3id.org/emmo/domain/pm-multiscale#CrystalFieldCoefficient
:CrystalFieldCoefficient rdf:type owl:Class ;
                         rdfs:subClassOf <https://w3id.org/emmo/domain/magnetic-material#MagnetocrystallineAnisotropy> ;
                         rdfs:comment "Crystal field coefficient A_lm<r^l> is an atomic-scale parameter used to compute magnetocrystalline anisotropy via Stevens operators; it is a sub-concept of the anisotropy hierarchy but not expressible by any existing magmo: class, requiring a new subclass under magmo:MagnetocrystallineAnisotropy."@en ;
                         rdfs:isDefinedBy <https://w3id.org/emmo/domain/pm-multiscale> ;
                         rdfs:label "crystal field coefficient" ;
                         <http://www.w3.org/2004/02/skos/core#note> "What is the crystal field coefficient used to compute? — used to compute magnetocrystalline anisotropy via Stevens operator formalism"@en ;
                         <http://www.w3.org/2004/02/skos/core#prefLabel> "crystal field coefficient"@en .


###  https://w3id.org/emmo/domain/pm-multiscale#CrystalFieldTheory
:CrystalFieldTheory rdf:type owl:Class ;
                    rdfs:subClassOf <https://w3id.org/emmo#ElectronicModel> .


###  https://w3id.org/emmo/domain/pm-multiscale#Crystalfieldtheory
:Crystalfieldtheory rdf:type owl:Class ;
                    rdfs:subClassOf [ rdf:type owl:Restriction ;
                                      owl:onProperty :hasScaleLevel ;
                                      owl:hasValue :Electronicscale
                                    ] .


###  https://w3id.org/emmo/domain/pm-multiscale#CrystallographicSite
:CrystallographicSite rdf:type owl:Class ;
                      rdfs:subClassOf <https://w3id.org/emmo/domain/magnetic-material#CrystalStructure> ;
                      rdfs:comment "A crystallographic site (Wyckoff position) is a sub-structural element of magmo:CrystalStructure; no existing class in the 3-tier ontology represents individual Wyckoff positions, so a new subclass is needed under magmo:CrystalStructure."@en ;
                      rdfs:isDefinedBy <https://w3id.org/emmo/domain/pm-multiscale> ;
                      rdfs:label "crystallographic site" ;
                      <http://www.w3.org/2004/02/skos/core#prefLabel> "crystallographic site"@en .


###  https://w3id.org/emmo/domain/pm-multiscale#CurieBlochEquation
:CurieBlochEquation rdf:type owl:Class ;
                    rdfs:subClassOf <https://w3id.org/emmo#MaterialLaw> ;
                    rdfs:comment "The Curie-Bloch equation is a phenomenological law relating magnetization to temperature (M(T) ∝ (1−T/Tc)^β); it functions as an emmo:MaterialLaw used to fit experimental or simulated M(T) curves, and no existing pm: or magmo: class captures this temperature-scaling relation."@en ;
                    rdfs:isDefinedBy <https://w3id.org/emmo/domain/pm-multiscale> ;
                    rdfs:label "curie-bloch equation" ;
                    <http://www.w3.org/2004/02/skos/core#prefLabel> "curie-bloch equation"@en .


###  https://w3id.org/emmo/domain/pm-multiscale#CurieTemperature
:CurieTemperature rdf:type owl:Class ;
                  rdfs:subClassOf <https://w3id.org/emmo#EMMO_909a0a36_2242_4a8c_a5e1_3fa6e9b42f10> ;
                  rdfs:comment "The critical temperature above which a ferromagnet becomes paramagnetic, losing spontaneous magnetization. Nd2Fe14B: 585K, SmCo5: 1020K."@en ,
                               "The critical temperature above which a ferromagnet becomes paramagnetic, losing spontaneous magnetization. Nd2Fe14B: 585K, SmCo5: 1020K. Not present in MagMO v1.0.0."@en ;
                  rdfs:label "CurieTemperature" ;
                  <http://www.w3.org/2004/02/skos/core#prefLabel> "CurieTemperature"@en .


###  https://w3id.org/emmo/domain/pm-multiscale#DFTConfiguration
:DFTConfiguration rdf:type owl:Class ;
                  rdfs:subClassOf :SimulationConfiguration ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty :hasExchangeCorrelationFunctional ;
                                    owl:cardinality "1"^^xsd:nonNegativeInteger
                                  ] ;
                  rdfs:comment "Configuration for a DFT calculation: exchange-correlation functional (PBE, LDA, GGA+U), basis set / plane-wave cutoff, k-point sampling, and spin-orbit coupling settings."@en ;
                  rdfs:label "DFTConfiguration" ;
                  <http://www.w3.org/2004/02/skos/core#prefLabel> "DFTConfiguration"@en .


###  https://w3id.org/emmo/domain/pm-multiscale#DFTStep
:DFTStep rdf:type owl:Class ;
         rdfs:subClassOf :SimulationStep ,
                         [ rdf:type owl:Restriction ;
                           owl:onProperty :hasOutputParameter ;
                           owl:someValuesFrom <https://w3id.org/emmo/domain/magnetic-material#MagnetocrystallineAnisotropyEnergy>
                         ] ,
                         [ rdf:type owl:Restriction ;
                           owl:onProperty :hasOutputParameter ;
                           owl:someValuesFrom <https://w3id.org/emmo/domain/magnetic-material#SaturationMagnetization>
                         ] ,
                         [ rdf:type owl:Restriction ;
                           owl:onProperty :hasOutputParameter ;
                           owl:someValuesFrom :CurieTemperature
                         ] ,
                         [ rdf:type owl:Restriction ;
                           owl:onProperty :hasConfiguration ;
                           owl:allValuesFrom :DFTConfiguration
                         ] ,
                         [ rdf:type owl:Restriction ;
                           owl:onProperty :hasScaleLevel ;
                           owl:hasValue :ElectronicScale
                         ] ;
         rdfs:comment "A density functional theory calculation that computes ground-state electronic properties: spontaneous magnetization (Ms_0), magnetocrystalline anisotropy (K1), and exchange coupling constants (Jij) from first principles."@en ;
         rdfs:label "DFTStep" ;
         <http://www.w3.org/2004/02/skos/core#altLabel> "fermi-dirac smearing"@en ,
                                                        "full-potential linear muffin-tin orbital method"@en ,
                                                        "full-potential linearized augmented plane wave (flapw) method"@en ,
                                                        "full-potential lmto method"@en ,
                                                        "kkr green's function method"@en ,
                                                        "noncollinear magnetic calculation"@en ;
         <http://www.w3.org/2004/02/skos/core#prefLabel> "DFTStep"@en .


###  https://w3id.org/emmo/domain/pm-multiscale#DataRepository
:DataRepository rdf:type owl:Class ;
                rdfs:comment "A data repository or database where material simulation data is stored and accessible via a persistent identifier."@en ;
                rdfs:label "DataRepository" ;
                <http://www.w3.org/2004/02/skos/core#prefLabel> "DataRepository"@en .


###  https://w3id.org/emmo/domain/pm-multiscale#DipolarCouplingConstant
:DipolarCouplingConstant rdf:type owl:Class ;
                         rdfs:subClassOf <https://w3id.org/emmo/domain/magnetic-material#UniaxialAnisotropyConstant> ;
                         rdfs:comment "Dipolar coupling constant (g_ab = M_a M_b v²) is a pairwise interaction prefactor not expressible by any existing magmo: constant class; it is a rigid Quantity analogous in role to magmo:UniaxialAnisotropyConstant but governing dipolar rather than anisotropy interactions."@en ;
                         rdfs:isDefinedBy <https://w3id.org/emmo/domain/pm-multiscale> ;
                         rdfs:label "dipolar coupling constant" ;
                         <http://www.w3.org/2004/02/skos/core#prefLabel> "dipolar coupling constant"@en .


###  https://w3id.org/emmo/domain/pm-multiscale#DipolarEnergy
:DipolarEnergy rdf:type owl:Class ;
               rdfs:subClassOf <https://w3id.org/emmo/domain/magnetic-material#MagnetocrystallineAnisotropyEnergy> ;
               rdfs:comment "Dipolar energy is a distinct magnetic interaction energy (long-range dipole-dipole) not expressible as any existing magmo: energy class; it is a rigid Quantity under emmo:Energy and is essential for multi-scale micromagnetic simulations of permanent magnets."@en ;
               rdfs:isDefinedBy <https://w3id.org/emmo/domain/pm-multiscale> ;
               rdfs:label "dipolar energy" ;
               <http://www.w3.org/2004/02/skos/core#prefLabel> "dipolar energy"@en .


###  https://w3id.org/emmo/domain/pm-multiscale#Dipolarenergy
:Dipolarenergy rdf:type owl:Class ;
               rdfs:subClassOf [ rdf:type owl:Restriction ;
                                 owl:onProperty :hasScaleLevel ;
                                 owl:hasValue :Mesoscopicscale
                               ] .


###  https://w3id.org/emmo/domain/pm-multiscale#DomainNucleation
:DomainNucleation rdf:type owl:Class ;
                  rdfs:subClassOf :MicromagneticsStep ;
                  owl:disjointWith :DomainWallMotion .


###  https://w3id.org/emmo/domain/pm-multiscale#DomainWallDepinningField
:DomainWallDepinningField rdf:type owl:Class ;
                          rdfs:subClassOf <https://w3id.org/emmo/domain/magnetic-material#CoercivityHc> ;
                          rdfs:comment "Domain wall depinning field is a distinct coercivity-mechanism quantity (the field required to unpin a domain wall from a defect) that is not captured by the general magmo:CoercivityHc class; it requires a new subclass to represent the pinning-limited coercivity contribution per the GAP criterion for missing mechanistic specificity."@en ;
                          rdfs:isDefinedBy <https://w3id.org/emmo/domain/pm-multiscale> ;
                          rdfs:label "domain wall depinning field" ;
                          <http://www.w3.org/2004/02/skos/core#prefLabel> "domain wall depinning field"@en .


###  https://w3id.org/emmo/domain/pm-multiscale#DomainWallEnergyDensity
:DomainWallEnergyDensity rdf:type owl:Class ;
                         rdfs:subClassOf <https://w3id.org/emmo/domain/magnetic-material#MagnetocrystallineAnisotropyEnergy> ;
                         rdfs:comment "Domain wall energy density (J/m²) is a distinct surface energy density quantity not expressible by magmo:MagnetocrystallineAnisotropyEnergy (a volumetric energy); it is a rigid Quantity in multi-scale permanent magnet modelling requiring a new GAP class."@en ;
                         rdfs:isDefinedBy <https://w3id.org/emmo/domain/pm-multiscale> ;
                         rdfs:label "domain wall energy density" ;
                         <http://www.w3.org/2004/02/skos/core#note> "What does domain wall energy density drive? — drives domain wall pinning"@en ;
                         <http://www.w3.org/2004/02/skos/core#prefLabel> "domain wall energy density"@en .


###  https://w3id.org/emmo/domain/pm-multiscale#DomainWallMotion
:DomainWallMotion rdf:type owl:Class ;
                  rdfs:subClassOf :MicromagneticsStep .


###  https://w3id.org/emmo/domain/pm-multiscale#DomainWallNucleationField
:DomainWallNucleationField rdf:type owl:Class ;
                           rdfs:subClassOf <https://w3id.org/emmo/domain/magnetic-material#CoercivityHc> ;
                           rdfs:comment "Domain wall nucleation field is a distinct coercivity-mechanism quantity (the field required to nucleate a domain wall at a specific defect) that is not captured by the general magmo:CoercivityHc class; it requires a new subclass to represent the nucleation-limited coercivity contribution per the GAP criterion for missing mechanistic specificity."@en ;
                           rdfs:isDefinedBy <https://w3id.org/emmo/domain/pm-multiscale> ;
                           rdfs:label "domain wall nucleation field" ;
                           <http://www.w3.org/2004/02/skos/core#prefLabel> "domain wall nucleation field"@en .


###  https://w3id.org/emmo/domain/pm-multiscale#DomainWallPropagation
:DomainWallPropagation rdf:type owl:Class ;
                       rdfs:subClassOf :MicromagneticsStep .


###  https://w3id.org/emmo/domain/pm-multiscale#Domainwalldepinningfield
:Domainwalldepinningfield rdf:type owl:Class ;
                          rdfs:subClassOf [ rdf:type owl:Restriction ;
                                            owl:onProperty :hasScaleLevel ;
                                            owl:hasValue :Mesoscopicscale
                                          ] .


###  https://w3id.org/emmo/domain/pm-multiscale#Domainwallnucleationfield
:Domainwallnucleationfield rdf:type owl:Class ;
                           rdfs:subClassOf [ rdf:type owl:Restriction ;
                                             owl:onProperty :hasScaleLevel ;
                                             owl:hasValue :Mesoscopicscale
                                           ] .


###  https://w3id.org/emmo/domain/pm-multiscale#Domainwallpinning
:Domainwallpinning rdf:type owl:Class ;
                   rdfs:subClassOf [ rdf:type owl:Restriction ;
                                     owl:onProperty :hasScaleLevel ;
                                     owl:hasValue :Mesoscopicscale
                                   ] .


###  https://w3id.org/emmo/domain/pm-multiscale#Domainwallpropagation
:Domainwallpropagation rdf:type owl:Class ;
                       rdfs:subClassOf [ rdf:type owl:Restriction ;
                                         owl:onProperty :hasScaleLevel ;
                                         owl:hasValue :Mesoscopicscale
                                       ] .


###  https://w3id.org/emmo/domain/pm-multiscale#Dorbitalresolvedmae
:Dorbitalresolvedmae rdf:type owl:Class ;
                     rdfs:subClassOf [ rdf:type owl:Restriction ;
                                       owl:onProperty :hasScaleLevel ;
                                       owl:hasValue :Electronicscale
                                     ] .


###  https://w3id.org/emmo/domain/pm-multiscale#DynamicalMeanFieldTheory
:DynamicalMeanFieldTheory rdf:type owl:Class ;
                          rdfs:subClassOf <https://w3id.org/emmo#ElectronicModel> .


###  https://w3id.org/emmo/domain/pm-multiscale#Dynamicalmeanfieldtheory
:Dynamicalmeanfieldtheory rdf:type owl:Class ;
                          rdfs:subClassOf [ rdf:type owl:Restriction ;
                                            owl:onProperty :hasScaleLevel ;
                                            owl:hasValue :Electronicscale
                                          ] .


###  https://w3id.org/emmo/domain/pm-multiscale#DzyaloshinskiiMoriyaInteraction
:DzyaloshinskiiMoriyaInteraction rdf:type owl:Class ;
                                 rdfs:subClassOf <https://w3id.org/emmo/domain/magnetic-material#ExchangeStiffnessConstant> ;
                                 rdfs:comment "DMI is an antisymmetric exchange interaction relevant to spin textures and domain-wall energetics in permanent-magnet interfaces; no existing magmo: class represents antisymmetric exchange, so a new sibling/subclass near magmo:ExchangeStiffnessConstant is needed."@en ;
                                 rdfs:isDefinedBy <https://w3id.org/emmo/domain/pm-multiscale> ;
                                 rdfs:label "dzyaloshinskii-moriya interaction" ;
                                 <http://www.w3.org/2004/02/skos/core#note> "What does the Dzyaloshinskii-Moriya interaction contribute to? — contributing a chiral term to the magnetic SANS cross section"@en ;
                                 <http://www.w3.org/2004/02/skos/core#prefLabel> "dzyaloshinskii-moriya interaction"@en .


###  https://w3id.org/emmo/domain/pm-multiscale#EasyConeAnisotropy
:EasyConeAnisotropy rdf:type owl:Class ;
                    rdfs:subClassOf <https://w3id.org/emmo/domain/magnetic-material#UniaxialMagneticAnisotropy> ;
                    rdfs:comment "Easy-cone anisotropy is a distinct anisotropy type (energy minimum on a cone, K1<0, K2>-K1/2) not covered by magmo:UniaxialMagneticAnisotropy (axial minimum) or magmo:CubicMagnetocrystallineAnisotropy; it requires a new subclass under magmo:UniaxialMagneticAnisotropy to maintain rigid subsumption."@en ;
                    rdfs:isDefinedBy <https://w3id.org/emmo/domain/pm-multiscale> ;
                    rdfs:label "easy-cone anisotropy" ;
                    <http://www.w3.org/2004/02/skos/core#prefLabel> "easy-cone anisotropy"@en .


###  https://w3id.org/emmo/domain/pm-multiscale#Effectiveanisotropy
:Effectiveanisotropy rdf:type owl:Class ;
                     rdfs:subClassOf [ rdf:type owl:Restriction ;
                                       owl:onProperty :hasScaleLevel ;
                                       owl:hasValue :Mesoscopicscale
                                     ] .


###  https://w3id.org/emmo/domain/pm-multiscale#EquiaxedGrains
:EquiaxedGrains rdf:type owl:Class ;
                rdfs:subClassOf <https://w3id.org/emmo/domain/magnetic-material#Grain> ;
                rdfs:comment "Equiaxed grains are a rigid, sortal morphological subtype of magmo:Grain (equal dimensions in all directions) not distinguished by any existing magmo: annotation; they require a new subclass under magmo:Grain to capture their microstructural role in SmCo-based PM alloys."@en ;
                rdfs:isDefinedBy <https://w3id.org/emmo/domain/pm-multiscale> ;
                rdfs:label "equiaxed grains" ;
                <http://www.w3.org/2004/02/skos/core#prefLabel> "equiaxed grains"@en .


###  https://w3id.org/emmo/domain/pm-multiscale#ExchangeCorrelationFunctional
:ExchangeCorrelationFunctional rdf:type owl:Class ;
                               rdfs:comment "The exchange-correlation functional approximation used in DFT. The choice (PBE vs LDA vs GGA+U) directly affects computed magnetic moments and anisotropy."@en ;
                               rdfs:label "ExchangeCorrelationFunctional" ;
                               <http://www.w3.org/2004/02/skos/core#prefLabel> "ExchangeCorrelationFunctional"@en .


###  https://w3id.org/emmo/domain/pm-multiscale#ExchangeEnergyDensity
:ExchangeEnergyDensity rdf:type owl:Class ;
                       rdfs:subClassOf <https://w3id.org/emmo/domain/magnetic-material#MagnetocrystallineAnisotropyEnergy> ;
                       rdfs:comment "Exchange energy density (∝A|∇m|²) is a distinct micromagnetic energy density term not covered by any existing magmo: class; magmo:MagnetocrystallineAnisotropyEnergy is the closest structural parent as a volumetric magnetic energy density, warranting a new sibling subclass in M3_Material."@en ;
                       rdfs:isDefinedBy <https://w3id.org/emmo/domain/pm-multiscale> ;
                       rdfs:label "exchange energy density" ;
                       <http://www.w3.org/2004/02/skos/core#prefLabel> "exchange energy density"@en .


###  https://w3id.org/emmo/domain/pm-multiscale#ExchangeSpringMagnet
:ExchangeSpringMagnet rdf:type owl:Class ;
                      rdfs:subClassOf <https://w3id.org/emmo/domain/magnetic-material#BulkMagnet> ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty :hasPart ;
                                        owl:someValuesFrom :HardMagnet
                                      ] ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty :hasPart ;
                                        owl:someValuesFrom :SoftMagnet
                                      ] ;
                      rdfs:comment "An exchange-spring magnet is a nanocomposite permanent magnet type combining hard and soft phases via exchange coupling; it is a distinct pm-multiscale-relevant material class not captured by pm:PermanentMagnetMaterial or any existing magmo: subclass, and should be a new subclass of magmo:BulkMagnet."@en ;
                      rdfs:isDefinedBy <https://w3id.org/emmo/domain/pm-multiscale> ;
                      rdfs:label "exchange-spring magnet" ;
                      <http://www.w3.org/2004/02/skos/core#prefLabel> "exchange-spring magnet"@en .


###  https://w3id.org/emmo/domain/pm-multiscale#Exchangecouplednanocompositepermanentmagnet
:Exchangecouplednanocompositepermanentmagnet rdf:type owl:Class ;
                                             rdfs:subClassOf [ rdf:type owl:Restriction ;
                                                               owl:onProperty :hasScaleLevel ;
                                                               owl:hasValue :Mesoscopicscale
                                                             ] .


###  https://w3id.org/emmo/domain/pm-multiscale#Exchangespringmagnet
:Exchangespringmagnet rdf:type owl:Class ;
                      rdfs:subClassOf [ rdf:type owl:Restriction ;
                                        owl:onProperty :hasScaleLevel ;
                                        owl:hasValue :Mesoscopicscale
                                      ] .


###  https://w3id.org/emmo/domain/pm-multiscale#Exchangespringpermanentmagnet
:Exchangespringpermanentmagnet rdf:type owl:Class ;
                               rdfs:subClassOf [ rdf:type owl:Restriction ;
                                                 owl:onProperty :hasScaleLevel ;
                                                 owl:hasValue :Mesoscopicscale
                                               ] .


###  https://w3id.org/emmo/domain/pm-multiscale#ExperimentalDetermination
:ExperimentalDetermination rdf:type owl:Class ;
                           rdfs:subClassOf :PropertyDetermination ;
                           rdfs:comment "A property value obtained through experimental measurement: VSM, SQUID magnetometry, PPMS, or neutron diffraction."@en ;
                           rdfs:label "ExperimentalDetermination" ;
                           <http://www.w3.org/2004/02/skos/core#prefLabel> "ExperimentalDetermination"@en .


###  https://w3id.org/emmo/domain/pm-multiscale#ExperimentalValidation
:ExperimentalValidation rdf:type owl:Class ;
                        rdfs:comment "A record that a computed property value has been compared against an experimental measurement, including the agreement/discrepancy."@en ;
                        rdfs:label "ExperimentalValidation" ;
                        <http://www.w3.org/2004/02/skos/core#altLabel> "lorentz tem"@en ,
                                                                       "vibrating-sample magnetometer"@en ;
                        <http://www.w3.org/2004/02/skos/core#prefLabel> "ExperimentalValidation"@en .


###  https://w3id.org/emmo/domain/pm-multiscale#Fermidiracsmearing
:Fermidiracsmearing rdf:type owl:Class ;
                    rdfs:subClassOf [ rdf:type owl:Restriction ;
                                      owl:onProperty :hasScaleLevel ;
                                      owl:hasValue :Electronicscale
                                    ] .


###  https://w3id.org/emmo/domain/pm-multiscale#Ferrimagnet
:Ferrimagnet rdf:type owl:Class ;
             rdfs:subClassOf <https://w3id.org/emmo/domain/magnetic-material#CrystallineMagneticMaterial> ;
             rdfs:comment "A ferrimagnet (net spontaneous magnetisation from unequal antiparallel sublattices, e.g. Gd2Fe14B) is a rigid, sortal material class; pm:Ferrite is too narrow (oxide ferrites only), so a new subclass under magmo:CrystallineMagneticMaterial is required for the general ferrimagnetic material type."@en ;
             rdfs:isDefinedBy <https://w3id.org/emmo/domain/pm-multiscale> ;
             rdfs:label "ferrimagnet" ;
             <http://www.w3.org/2004/02/skos/core#prefLabel> "ferrimagnet"@en .


###  https://w3id.org/emmo/domain/pm-multiscale#FigureSource
:FigureSource rdf:type owl:Class ;
              rdfs:subClassOf :PropertySource ;
              rdfs:comment "A property value extracted or digitized from a figure in a publication."@en ;
              rdfs:label "FigureSource" ;
              <http://www.w3.org/2004/02/skos/core#prefLabel> "FigureSource"@en .


###  https://w3id.org/emmo/domain/pm-multiscale#Fixedspinmomentcalculation
:Fixedspinmomentcalculation rdf:type owl:Class ;
                            rdfs:subClassOf [ rdf:type owl:Restriction ;
                                              owl:onProperty :hasScaleLevel ;
                                              owl:hasValue :Electronicscale
                                            ] .


