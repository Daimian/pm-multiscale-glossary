        <owl:imports rdf:resource="https://w3id.org/emmo/domain/magnetic-material/1.0.0"/>
        <terms:abstract xml:lang="en">An EMMO domain ontology for multi-scale computational simulation of permanent magnetic materials, covering DFT through spin dynamics to micromagnetics, with support for literature annotation and reproducibility assessment.</terms:abstract>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-05-22</terms:created>
        <terms:creator>Generated via NEON-GPT methodology, validated L1-L4</terms:creator>
        <terms:license>https://creativecommons.org/licenses/by/4.0/legalcode</terms:license>
        <terms:title xml:lang="en">Permanent Magnet Multi-Scale Simulation Ontology</terms:title>
        <rdfs:comment xml:lang="en">v2.0.0 — CQ-driven enrichment, self-checked, ABox cleaned, strict filtered. Removed SmCo/Ferrite/AlNiCo (no-pattern leaf classes). Updated 2026-05-30.</rdfs:comment>
        <owl:versionInfo>2.0.0</owl:versionInfo>
    </owl:Ontology>
    


