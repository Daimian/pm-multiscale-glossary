:Magneticphase rdf:type owl:Class ;
               rdfs:subClassOf [ rdf:type owl:Restriction ;
                                 owl:onProperty :hasProperty ;
                                 owl:someValuesFrom :TheoreticalEnergyProductLimit
                               ] .


###  https://w3id.org/emmo/domain/pm-multiscale#Magneticsurfaceanisotropy
:Magneticsurfaceanisotropy rdf:type owl:Class ;
                           rdfs:subClassOf [ rdf:type owl:Restriction ;
                                             owl:onProperty :hasScaleLevel ;
                                             owl:hasValue :Mesoscopicscale
                                           ] .


###  https://w3id.org/emmo/domain/pm-multiscale#MagnetizationReversal
:MagnetizationReversal rdf:type owl:Class ;
                       rdfs:subClassOf :MicromagneticsStep .


###  https://w3id.org/emmo/domain/pm-multiscale#Magnetizationreversal
:Magnetizationreversal rdf:type owl:Class ;
                       rdfs:subClassOf [ rdf:type owl:Restriction ;
                                         owl:onProperty :hasScaleLevel ;
                                         owl:hasValue :Mesoscopicscale
                                       ] .


###  https://w3id.org/emmo/domain/pm-multiscale#MagnetocrystallineAnisotropyConstantK3
:MagnetocrystallineAnisotropyConstantK3 rdf:type owl:Class ;
                                        rdfs:subClassOf <https://w3id.org/emmo/domain/magnetic-material#MagnetocrystallineAnisotropyConstantK2> ;
                                        rdfs:comment "K3 is the third-order uniaxial magnetocrystalline anisotropy constant of Nd2Fe14B, a direct higher-order sibling of the existing magmo:MagnetocrystallineAnisotropyConstantK2; no existing magmo: class covers K3, requiring a new class as a sibling under the same parent in the EMMO Quantity branch."@en ;
                                        rdfs:isDefinedBy <https://w3id.org/emmo/domain/pm-multiscale> ;
                                        rdfs:label "magnetocrystalline anisotropy constant k3" ;
                                        <http://www.w3.org/2004/02/skos/core#prefLabel> "magnetocrystalline anisotropy constant k3"@en .


###  https://w3id.org/emmo/domain/pm-multiscale#MagnetoelasticAnisotropy
:MagnetoelasticAnisotropy rdf:type owl:Class ;
                          rdfs:subClassOf <https://w3id.org/emmo/domain/magnetic-material#MagneticAnisotropy> ;
                          rdfs:comment "Magnetoelastic anisotropy is a distinct physical mechanism (stress-magnetostriction coupling) not captured by any existing magmo: anisotropy subclass; it requires a new subclass under magmo:MagneticAnisotropy to preserve ontological rigidity of the mechanism."@en ;
                          rdfs:isDefinedBy <https://w3id.org/emmo/domain/pm-multiscale> ;
                          rdfs:label "magnetoelastic anisotropy" ;
                          <http://www.w3.org/2004/02/skos/core#prefLabel> "magnetoelastic anisotropy"@en .


###  https://w3id.org/emmo/domain/pm-multiscale#Magnetostriction
:Magnetostriction rdf:type owl:Class ;
                  rdfs:subClassOf <https://w3id.org/emmo/domain/magnetic-material#InducedMagneticAnisotropy> ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty :hasProperty ;
                                    owl:someValuesFrom :MagnetostrictionConstant
                                  ] ;
                  rdfs:comment "Magnetostriction (magnetoelastic coupling coefficient λ) is a distinct intrinsic magnetic quantity not represented by any existing magmo: class; a new subclass under magmo:InducedMagneticAnisotropy (the closest magnetoelastic parent) is required per the gap criterion."@en ;
                  rdfs:isDefinedBy <https://w3id.org/emmo/domain/pm-multiscale> ;
                  rdfs:label "magnetostriction" ;
                  <http://www.w3.org/2004/02/skos/core#prefLabel> "magnetostriction"@en .


###  https://w3id.org/emmo/domain/pm-multiscale#MagnetostrictionConstant
:MagnetostrictionConstant rdf:type owl:Class ;
                          rdfs:subClassOf <https://w3id.org/emmo/domain/magnetic-material#MagnetocrystallineAnisotropyConstantK1> ;
                          rdfs:comment "λs is a dimensionless intrinsic material constant quantifying magneto-elastic coupling; no existing magmo: class covers magnetostriction constants, making it a genuine ontology gap requiring a new sibling class alongside magmo:MagnetocrystallineAnisotropyConstantK1 under the intrinsic-property branch."@en ;
                          rdfs:isDefinedBy <https://w3id.org/emmo/domain/pm-multiscale> ;
                          rdfs:label "magnetostriction constant" ;
                          <http://www.w3.org/2004/02/skos/core#prefLabel> "magnetostriction constant"@en .


###  https://w3id.org/emmo/domain/pm-multiscale#MeshSpecification
:MeshSpecification rdf:type owl:Class ;
                   rdfs:comment "The spatial discretization for finite element micromagnetics: cell size, element type, and refinement strategy. Cell size must be smaller than the exchange length."@en ;
                   rdfs:label "MeshSpecification" ;
                   <http://www.w3.org/2004/02/skos/core#prefLabel> "MeshSpecification"@en .


###  https://w3id.org/emmo/domain/pm-multiscale#MicromagneticsConfiguration
:MicromagneticsConfiguration rdf:type owl:Class ;
                             rdfs:subClassOf :SimulationConfiguration ,
                                             [ rdf:type owl:Restriction ;
                                               owl:onProperty :hasMesh ;
                                               owl:cardinality "1"^^xsd:nonNegativeInteger
                                             ] ;
                             rdfs:comment "Configuration for continuum micromagnetics: finite element mesh, cell size, boundary conditions, solver algorithm, and external field sweep parameters."@en ;
                             rdfs:label "MicromagneticsConfiguration" ;
                             <http://www.w3.org/2004/02/skos/core#altLabel> "micromagnetic theory"@en ;
                             <http://www.w3.org/2004/02/skos/core#prefLabel> "MicromagneticsConfiguration"@en .


###  https://w3id.org/emmo/domain/pm-multiscale#MicromagneticsStep
:MicromagneticsStep rdf:type owl:Class ;
                    rdfs:subClassOf :SimulationStep ,
                                    [ rdf:type owl:Restriction ;
                                      owl:onProperty :hasOutputParameter ;
                                      owl:someValuesFrom <https://w3id.org/emmo/domain/magnetic-material#CoercivityHc>
                                    ] ,
                                    [ rdf:type owl:Restriction ;
                                      owl:onProperty :hasOutputParameter ;
                                      owl:someValuesFrom <https://w3id.org/emmo/domain/magnetic-material#MaximumEnergyProduct>
                                    ] ,
                                    [ rdf:type owl:Restriction ;
                                      owl:onProperty :hasOutputParameter ;
                                      owl:someValuesFrom <https://w3id.org/emmo/domain/magnetic-material#Remanence>
                                    ] ,
                                    [ rdf:type owl:Restriction ;
                                      owl:onProperty :hasConfiguration ;
                                      owl:allValuesFrom :MicromagneticsConfiguration
                                    ] ,
                                    [ rdf:type owl:Restriction ;
                                      owl:onProperty :hasScaleLevel ;
                                      owl:hasValue :MesoscopicScale
                                    ] ;
                    rdfs:comment "A continuum micromagnetic simulation (e.g., esys-escript, mumax3) that computes extrinsic properties: coercivity Hc, remanence Mr, maximum energy product BHmax, and domain structure."@en ;
                    rdfs:label "MicromagneticsStep" ;
                    <http://www.w3.org/2004/02/skos/core#prefLabel> "MicromagneticsStep"@en .


###  https://w3id.org/emmo/domain/pm-multiscale#Micromagnetictheory
:Micromagnetictheory rdf:type owl:Class ;
                     rdfs:subClassOf [ rdf:type owl:Restriction ;
                                       owl:onProperty :hasScaleLevel ;
                                       owl:hasValue :Mesoscopicscale
                                     ] .


