  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "http://org.semanticweb.owlapi/error#Error2"
  }, {
    "@id" : "_:genid77"
  } ]
}, {
  "@id" : "https://w3id.org/emmo/domain/pm-multiscale#NdFeB",
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.w3.org/2002/07/owl#Class"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Neodymium-iron-boron (Nd2Fe14B) and its variants (with Dy, Tb substitution). Highest room-temperature BHmax (~400 kJ/m3) among all permanent magnets."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "NdFeB"
  } ],
