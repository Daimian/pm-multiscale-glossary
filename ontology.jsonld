    "@id" : "http://www.w3.org/2002/07/owl#Class"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "A magnetic material that retains magnetization after removal of an external field, characterized by high coercivity and remanence. Subclass of MagMO MagneticMaterial."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "PermanentMagnetMaterial"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/emmo/domain/magnetic-material#MagneticMaterial"
  }, {
